---
// short-series/src/layouts/Layout.astro
import MarketTicker from '../components/MarketTicker.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  articleDate?: string;
}

const { 
  title, 
  description = "Automated financial insights and quantitative market analysis.",
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.tradeopportunities.trade').href,
  image = "https://www.tradeopportunities.trade/favicon.svg",
  articleDate
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isScreener = currentPath.startsWith('/screener');
const isRvol = currentPath.startsWith('/rvol-screener');
const isCalendar = currentPath.startsWith('/calendar');
const isDilution = currentPath.startsWith('/dilution-risk');
const isTools = currentPath.startsWith('/tools');
const isTrackRecord = currentPath.startsWith('/track-record');
const isAbout = currentPath.startsWith('/about');
const isBriefs = currentPath.startsWith('/blog') || currentPath.startsWith('/category');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- High-Visibility Dynamic Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.svg?v=2" />
    
    <!-- Primary SEO Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Web Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Instant Theme Synchronization to Prevent Flash -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('to_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="bg-[#090D16] text-[#F8FAFC] antialiased selection:bg-sky-500/20 selection:text-sky-300">
    <div id="top" style="position: absolute; top: 0; left: 0; width: 0; height: 0; pointer-events: none;"></div>
    
    <!-- Tier 1: Global Telemetry Bar (h-9 = 36px) -->
    <MarketTicker />

    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

    <aside id="side-dashboard" class="side-dashboard" aria-label="Analytical Navigation Dashboard">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          <span class="logo-glyph"></span>
          <span>TRADE OPPORTUNITIES</span>
        </div>
        <button id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Close Dashboard">&times;</button>
      </div>

      <div class="sidebar-body">
        <div class="sidebar-search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="sidebar-search-input" class="search-input bg-[#090D16] border border-[#1E293B] rounded-md px-3 py-1.5 text-xs font-mono tabular-nums tracking-tight focus:border-[#38BDF8]" style="width: 100%;" placeholder="Jump to $TICKER (e.g. NVDA)..." />
        </div>

        <div class="sidebar-group-label">Main Pages</div>
        <nav class="sidebar-nav">
          <a href="/" class:list={['sidebar-nav-item', { active: isHome }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Scanner</span>
          </a>
          <a href="/screener/" class:list={['sidebar-nav-item', { active: isScreener }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Screener</span>
          </a>
          <a href="/#news-feed" class:list={['sidebar-nav-item', { active: isBriefs }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>AI Briefings</span>
          </a>
          <a href="/#opportunities" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            <span>Monitored Breakouts</span>
          </a>
        </nav>

        <div class="sidebar-group-label">Research &amp; Analytics</div>
        <nav class="sidebar-nav">
          <a href="/rvol-screener/" class:list={['sidebar-nav-item', { active: isRvol }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>RVOL Screener</span>
          </a>
          <a href="/calendar/" class:list={['sidebar-nav-item', { active: isCalendar }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Earnings &amp; Catalyst Calendar</span>
          </a>
          <a href="/dilution-risk/" class:list={['sidebar-nav-item', { active: isDilution }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <span>Stock Dilution &amp; Risk</span>
          </a>
          <a href="/tools/" class:list={['sidebar-nav-item', { active: isTools }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Trading Tools &amp; Swaps</span>
          </a>
          <a href="/track-record/" class:list={['sidebar-nav-item', { active: isTrackRecord }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            <span>Track Record</span>
          </a>
        </nav>

        <div class="sidebar-group-label">Platform</div>
        <nav class="sidebar-nav">
          <a href="/#alerts" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Pre-Market Dispatch</span>
          </a>
          <a href="/about/" class:list={['sidebar-nav-item', { active: isAbout }]}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>Methodology</span>
          </a>
        </nav>
      </div>
    </aside>

    <!-- Tier 2: Command Navbar (h-14 = 56px, combined header = 92px <= 100px max) -->
    <nav class="top-nav h-14 bg-[#111726]/90 backdrop-blur-md border-b border-[#1E293B] sticky top-0 z-40">
      <div class="app-wrapper nav-inner">
        <div class="brand-group">
          <button id="sidebar-toggle-btn" class="dashboard-toggle-btn" aria-label="Toggle Side Dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Terminal</span>
          </button>

          <a href="/" class="logo">
            <span class="logo-glyph"></span>
            TRADE OPPORTUNITIES
          </a>

          <ul class="nav-links">
            <li><a href="/" class:list={[{ active: isHome }]}>Scanner</a></li>
            <li><a href="/screener/" class:list={[{ active: isScreener }]}>Screener</a></li>
            <li><a href="/#news-feed" class:list={[{ active: isBriefs }]}>AI Briefings</a></li>
            <li><a href="/tools/" class:list={[{ active: isTools }]}>Tools</a></li>
          </ul>
        </div>

        <div class="nav-actions">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input
              type="text"
              id="filter-input"
              class="search-input bg-[#090D16] border border-[#1E293B] rounded-md px-3 py-1.5 text-xs font-mono tabular-nums tracking-tight focus:border-[#38BDF8]"
              placeholder="Search $TICKER..."
            />
          </div>

          <button id="theme-toggle-btn" class="icon-action-btn" aria-label="Toggle light / dark mode" title="Switch Theme">
            <svg id="theme-icon-sun" style="display: none;" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg id="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="pb-16 md:pb-0">
      <slot />
    </main>

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="cookie-banner hidden">
      <div class="cookie-content">
        <p>We use cookies to ensure proper analytics, security, and market feed synchronization. Review our <a href="/privacy/">Privacy Policy</a>.</p>
        <div class="cookie-actions">
          <button id="accept-cookies" class="cookie-btn accept">Accept All</button>
          <button id="decline-cookies" class="cookie-btn decline">Essential Only</button>
        </div>
      </div>
    </div>

    <footer class="site-footer pb-16 md:pb-0">
      <div class="footer-container">
        <div class="footer-disclosure">
          <p class="disclosure-title">Financial Risk &amp; Regulatory Disclaimer</p>
          <p class="disclosure-text">
            <strong>Not Financial Advice:</strong> All content, market data, and quantitative summaries published on this website are provided strictly for educational and informational purposes only. Trade Opportunities is not a broker-dealer or registered financial advisor and does not execute trades or hold client deposits.
          </p>
        </div>

        <div class="footer-meta">
          <p>&copy; {new Date().getFullYear()} Trade Opportunities. All rights reserved.</p>
          <div class="legal-links">
            <a href="/screener/">Live Screener</a>
            <span>&bull;</span>
            <a href="/rvol-screener/">RVOL Screener</a>
            <span>&bull;</span>
            <a href="/calendar/">Catalyst Calendar</a>
            <span>&bull;</span>
            <a href="/dilution-risk/">Dilution Risk</a>
            <span>&bull;</span>
            <a href="/track-record/">Track Record</a>
            <span>&bull;</span>
            <a href="/tools/">Trading Tools</a>
            <span>&bull;</span>
            <a href="/category/equities/">Equities Archive</a>
            <span>&bull;</span>
            <a href="/about/">Methodology</a>
            <span>&bull;</span>
            <a href="/privacy/">Privacy</a>
            <span>&bull;</span>
            <a href="/terms/">Terms</a>
            <span>&bull;</span>
            <a href="/rss.xml">RSS</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Bar (4 thumb tabs) -->
    <nav class="mobile-bottom-bar md:hidden fixed bottom-0 inset-x-0 z-50 h-14 bg-[#111726] border-t border-[#1E293B]" aria-label="Mobile Bottom Navigation">
      <a href="/" class:list={['mobile-tab-item', { active: isHome }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
          <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
        <span>Movers</span>
      </a>
      <a href="/screener/" class:list={['mobile-tab-item', { active: isScreener }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>Screener</span>
      </a>
      <a href="/blog/" class:list={['mobile-tab-item', { active: isBriefs }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>AI Briefs</span>
      </a>
      <a href="/tools/" class:list={['mobile-tab-item', { active: isTools }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <span>Tools</span>
      </a>
    </nav>

    <script is:inline>
      // 1. Theme Initializer & Toggle
      (function initLayoutTheme() {
        const themeBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');

        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'light') {
            if (sunIcon) sunIcon.style.display = 'none';
            if (moonIcon) moonIcon.style.display = 'block';
          } else {
            if (sunIcon) sunIcon.style.display = 'block';
            if (moonIcon) moonIcon.style.display = 'none';
          }
          localStorage.setItem('to_theme', theme);
        }

        const savedTheme = localStorage.getItem('to_theme') || 'dark';
        applyTheme(savedTheme);

        themeBtn?.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          applyTheme(next);
        });
      })();

      // 2. Sidebar Dashboard Drawer
      (function initLayoutDrawer() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        const closeBtn = document.getElementById('sidebar-close-btn');
        const sidebar = document.getElementById('side-dashboard');
        const backdrop = document.getElementById('sidebar-backdrop');

        function openSidebar() {
          sidebar?.classList.add('open');
          backdrop?.classList.add('active');
        }

        function closeSidebar() {
          sidebar?.classList.remove('open');
          backdrop?.classList.remove('active');
        }

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          openSidebar();
        });

        closeBtn?.addEventListener('click', closeSidebar);
        backdrop?.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
            closeSidebar();
          }
        });
      })();

      // 3. Search Field Redirect (supports direct $TICKER lookup)
      (function initSearchRedirect() {
        function handleSearchKeydown(e, inputEl) {
          if (e.key === 'Enter') {
            const raw = inputEl.value.trim();
            if (!raw) return;
            const cleanTicker = raw.replace(/^\$/, '').trim();
            if (/^[A-Za-z]{1,5}(\.[A-Za-z]{1,2})?$/.test(cleanTicker)) {
              window.location.href = `/ticker/${cleanTicker.toLowerCase()}/`;
            } else {
              window.location.href = `/?search=${encodeURIComponent(raw)}#news-feed`;
            }
          }
        }

        const searchInput = document.getElementById('filter-input');
        if (searchInput) {
          searchInput.addEventListener('keydown', (e) => handleSearchKeydown(e, searchInput));
        }

        const sidebarSearch = document.getElementById('sidebar-search-input');
        if (sidebarSearch) {
          sidebarSearch.addEventListener('keydown', (e) => handleSearchKeydown(e, sidebarSearch));
        }
      })();

      // 4. Cookie Banner
      (function initCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('accept-cookies');
        const declineBtn = document.getElementById('decline-cookies');

        if (!localStorage.getItem('cookie_consent')) {
          banner?.classList.remove('hidden');
        }

        acceptBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'accepted');
          banner?.classList.add('hidden');
        });

        declineBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'declined');
          banner?.classList.add('hidden');
        });
      })();

      // 5. Floating Back-to-Top Button
      (function initBackToTop() {
        const bttBtn = document.getElementById('back-to-top-btn');
        if (!bttBtn) return;

        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (window.scrollY > 350) {
                bttBtn.classList.add('visible');
              } else {
                bttBtn.classList.remove('visible');
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        bttBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
    <button id="back-to-top-btn" class="back-to-top-btn" aria-label="Back to top" title="Back to top">&uarr;</button>
  </body>
