---
// src/layouts/Layout.astro
import MarketTicker from '../components/MarketTicker.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Automated financial insights and quantitative market analysis." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <MarketTicker />
    
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="brand-logo">AI FARM<span>.MARKETS</span></a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/category/market-analysis">Analysis</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="cookie-banner hidden">
      <div class="cookie-content">
        <p>We use cookies to ensure proper analytics, security, and market feed synchronization. Review our <a href="/privacy">Privacy Policy</a>.</p>
        <div class="cookie-actions">
          <button id="accept-cookies" class="cookie-btn accept">Accept All</button>
          <button id="decline-cookies" class="cookie-btn decline">Essential Only</button>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-disclosure">
          <p class="disclosure-title">Financial Risk & Regulatory Disclaimer</p>
          <p class="disclosure-text">
            <strong>Not Financial Advice:</strong> All content, market data, and quantitative summaries published on this website are provided strictly for educational and informational purposes only. Nothing contained herein constitutes investment, legal, or tax advice, nor should it be relied upon as a recommendation or endorsement of any security, trading strategy, or financial transaction.
          </p>
        </div>

        <div class="footer-meta">
          <p>&copy; {new Date().getFullYear()} AI Farm. All rights reserved.</p>
          <div class="legal-links">
            <a href="/privacy">Privacy Policy</a>
            <span>&bull;</span>
            <a href="/terms">Terms of Service</a>
            <span>&bull;</span>
            <a href="/rss.xml">RSS Feed</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('accept-cookies');
        const declineBtn = document.getElementById('decline-cookies');

        if (!localStorage.getItem('cookie_consent')) {
          banner?.classList.remove('hidden');
        }

        acceptBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'accepted');
          banner?.classList.add('hidden');
        });

        declineBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'declined');
          banner?.classList.add('hidden');
        });
      })();
    </script>
  </body>
</html>

<style>
  :root {
    --bg-primary: #020617;
    --text-primary: #f8fafc;
    --text-muted: #94a3b8;
    --border-color: #1e293b;
    --accent: #38bdf8;
  }
  *, *::before, *::after {
    box-sizing: border-box;
  }
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-text-size-adjust: 100%;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }
  .site-header {
    border-bottom: 1px solid var(--border-color);
    background: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(8px);
    width: 100%;
  }
  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
  }
  .brand-logo {
    font-weight: 800;
    font-size: 1.1rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand-logo span {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: #fff;
  }
  .site-footer {
    border-top: 1px solid var(--border-color);
    background: #090d16;
    padding: 2.5rem 1.25rem;
    margin-top: 3rem;
    width: 100%;
  }
  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }
  .footer-disclosure {
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .disclosure-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #e2e8f0;
    margin: 0 0 0.4rem 0;
  }
  .disclosure-text {
    font-size: 0.8rem;
    line-height: 1.45;
    color: #94a3b8;
    margin: 0;
  }
  .footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #64748b;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .legal-links {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .legal-links a {
    color: #64748b;
    text-decoration: none;
  }
  .legal-links a:hover {
    color: var(--text-primary);
  }

  /* Cookie Consent Banner Styling */
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 500px;
    margin: 0 auto;
    background: #0b0e14;
    border: 1px solid #1e2638;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    z-index: 9999;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
  }
  .cookie-banner.hidden {
    display: none;
  }
  .cookie-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cookie-content p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }
  .cookie-content a {
    color: var(--accent);
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 0.5rem;
  }
  .cookie-btn {
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s;
  }
  .cookie-btn.accept {
    background: #2563eb;
    color: #fff;
  }
  .cookie-btn.decline {
    background: #1e2638;
    color: #94a3b8;
  }
  .cookie-btn:hover {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .nav-container {
      flex-direction: column;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .nav-links {
      gap: 1rem;
    }
  }
</style>
