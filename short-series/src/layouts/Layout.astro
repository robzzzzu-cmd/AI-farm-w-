---
// short-series/src/layouts/Layout.astro
import MarketTicker from '../components/MarketTicker.astro';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  articleDate?: string;
}

const { 
  title, 
  description = "Automated financial insights and quantitative market analysis.",
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://tradeopportunities.trade').href,
  image = "https://tradeopportunities.trade/favicon.svg",
  articleDate
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- High-Visibility Dynamic Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.svg?v=2" />
    
    <!-- Primary SEO Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Instant Theme Synchronization to Prevent Flash -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('to_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <div id="top" style="position: absolute; top: 0; left: 0; width: 0; height: 0; pointer-events: none;"></div>
    <MarketTicker />

    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

    <aside id="side-dashboard" class="side-dashboard" aria-label="Analytical Navigation Dashboard">
      <div class="sidebar-header">
        <div class="sidebar-brand">
          <span class="logo-glyph"></span>
          <span>TRADE OPPORTUNITIES</span>
        </div>
        <button id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Close Dashboard">&times;</button>
      </div>

      <div class="sidebar-body">
        <div class="sidebar-group-label">WORKSPACE HUBS</div>
        <nav class="sidebar-nav">
          <a href="/" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard</span>
          </a>
          <a href="/#news-feed" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>News Feed</span>
          </a>
          <a href="/screener" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Live Screener</span>
          </a>
          <a href="/#opportunities" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            <span>Opportunities</span>
          </a>
          <a href="/#tools" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Tools</span>
          </a>
          <a href="/#platforms" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Platforms</span>
          </a>
          <a href="/track-record" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            <span>Track Record</span>
          </a>
          <a href="/#alerts" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Weekly News</span>
          </a>
          <a href="/about" class="sidebar-nav-item">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>Methodology</span>
          </a>
        </nav>

        <div class="sidebar-promo-card">
          <div class="sidebar-promo-title">Weekly Market Intelligence</div>
          <p class="sidebar-promo-desc">Direct market dispatches, volume anomaly alerts, and weekly quantitative digests.</p>
          <a href="/#alerts" class="sidebar-promo-btn">Subscribe Free</a>
        </div>
      </div>
    </aside>

    <header class="top-nav">
      <div class="nav-inner">
        <div class="brand-group">
          <button id="sidebar-toggle-btn" class="dashboard-toggle-btn" aria-label="Toggle Side Dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Dashboard</span>
          </button>

          <a href="/" class="logo">
            <span class="logo-glyph"></span>
            TRADE OPPORTUNITIES
          </a>

          <ul class="nav-links">
            <li><a href="/#news-feed">News Feed</a></li>
            <li><a href="/screener">Live Screener</a></li>
            <li><a href="/#opportunities">Opportunities</a></li>
            <li><a href="/#tools">Tools</a></li>
            <li><a href="/#platforms">Platforms</a></li>
            <li><a href="/track-record">Track Record</a></li>
          </ul>
        </div>

        <div class="nav-actions">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="filter-input" class="search-input" placeholder="Search ticker..." />
          </div>

          <button id="theme-toggle-btn" class="icon-action-btn" aria-label="Toggle light / dark mode" title="Switch Theme">
            <svg id="theme-icon-sun" style="display: none;" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg id="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <a href="/#alerts" class="alerts-action-btn" title="Subscribe for Weekly News">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Weekly News</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="cookie-banner hidden">
      <div class="cookie-content">
        <p>We use cookies to ensure proper analytics, security, and market feed synchronization. Review our <a href="/privacy">Privacy Policy</a>.</p>
        <div class="cookie-actions">
          <button id="accept-cookies" class="cookie-btn accept">Accept All</button>
          <button id="decline-cookies" class="cookie-btn decline">Essential Only</button>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-disclosure">
          <p class="disclosure-title">Financial Risk &amp; Regulatory Disclaimer</p>
          <p class="disclosure-text">
            <strong>Not Financial Advice:</strong> All content, market data, and quantitative summaries published on this website are provided strictly for educational and informational purposes only. Trade Opportunities is not a broker-dealer or registered financial advisor and does not execute trades or hold client deposits.
          </p>
        </div>

        <div class="footer-meta">
          <p>&copy; {new Date().getFullYear()} Trade Opportunities. All rights reserved.</p>
          <div class="legal-links">
            <a href="/about">Methodology &amp; E-E-A-T</a>
            <span>&bull;</span>
            <a href="/privacy">Privacy Policy</a>
            <span>&bull;</span>
            <a href="/terms">Terms of Service</a>
            <span>&bull;</span>
            <a href="/rss.xml">RSS Feed</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      // 1. Theme Initializer & Toggle
      (function initLayoutTheme() {
        const themeBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');

        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'light') {
            if (sunIcon) sunIcon.style.display = 'none';
            if (moonIcon) moonIcon.style.display = 'block';
          } else {
            if (sunIcon) sunIcon.style.display = 'block';
            if (moonIcon) moonIcon.style.display = 'none';
          }
          localStorage.setItem('to_theme', theme);
        }

        const savedTheme = localStorage.getItem('to_theme') || 'dark';
        applyTheme(savedTheme);

        themeBtn?.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          applyTheme(next);
        });
      })();

      // 2. Sidebar Dashboard Drawer
      (function initLayoutDrawer() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        const closeBtn = document.getElementById('sidebar-close-btn');
        const sidebar = document.getElementById('side-dashboard');
        const backdrop = document.getElementById('sidebar-backdrop');

        function openSidebar() {
          sidebar?.classList.add('open');
          backdrop?.classList.add('active');
        }

        function closeSidebar() {
          sidebar?.classList.remove('open');
          backdrop?.classList.remove('active');
        }

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          openSidebar();
        });

        closeBtn?.addEventListener('click', closeSidebar);
        backdrop?.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
            closeSidebar();
          }
        });
      })();

      // 3. Search Field Redirect
      (function initSearchRedirect() {
        const searchInput = document.getElementById('filter-input');
        if (!searchInput) return;

        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const q = searchInput.value.trim();
            if (q) {
              window.location.href = `/?search=${encodeURIComponent(q)}#news-feed`;
            }
          }
        });
      })();

      // 4. Cookie Banner
      (function initCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('accept-cookies');
        const declineBtn = document.getElementById('decline-cookies');

        if (!localStorage.getItem('cookie_consent')) {
          banner?.classList.remove('hidden');
        }

        acceptBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'accepted');
          banner?.classList.add('hidden');
        });

        declineBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'declined');
          banner?.classList.add('hidden');
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --bg-page: #0b0c10;
    --bg-surface: #12141a;
    --bg-surface-elevated: #181b22;
    --border-subtle: #222632;
    --border-strong: #2f3545;
    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --text-muted: #6b7280;
    --brand-accent: #3b82f6;
    --gain-color: #22c55e;
    --gain-bg: rgba(34, 197, 94, 0.1);
    --loss-color: #ef4444;
    --loss-bg: rgba(239, 68, 68, 0.1);
    --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.35);
    --sidebar-width: 270px;
    --nav-height: 58px;
  }

  [data-theme="light"] {
    --bg-page: #f0f2f5;
    --bg-surface: #ffffff;
    --bg-surface-elevated: #e5e8ed;
    --border-subtle: #d0d5dd;
    --border-strong: #98a2b3;
    --text-primary: #111827;
    --text-secondary: #4b5563;
    --text-muted: #667085;
    --brand-accent: #2563eb;
    --gain-color: #16a34a;
    --gain-bg: rgba(22, 163, 74, 0.12);
    --loss-color: #dc2626;
    --loss-bg: rgba(220, 38, 38, 0.12);
    --card-shadow: 0 2px 8px -2px rgba(16, 24, 40, 0.08), 0 1px 4px -1px rgba(16, 24, 40, 0.04);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    position: relative;
    font-family: var(--font-sans);
    background-color: var(--bg-page);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }

  img, iframe, embed, object {
    max-width: 100%;
  }

  /* Side Dashboard Drawer */
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .sidebar-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  .side-dashboard {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    z-index: 10001;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 6px 0 28px rgba(0, 0, 0, 0.45);
    overflow-y: auto;
  }
  .side-dashboard.open {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .sidebar-close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    line-height: 1;
  }
  .sidebar-close-btn:hover {
    color: var(--text-primary);
    background: var(--bg-surface-elevated);
  }

  .sidebar-body {
    flex: 1;
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .sidebar-group-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0 0.5rem;
  }
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sidebar-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sidebar-nav-item:hover {
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
    transform: translateX(2px);
  }
  .sidebar-nav-item.active {
    background: var(--bg-surface-elevated);
    color: var(--brand-accent);
    font-weight: 600;
    border-left: 3px solid var(--brand-accent);
  }
  .sidebar-icon {
    width: 16px;
    height: 16px;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }
  .sidebar-nav-item:hover .sidebar-icon, .sidebar-nav-item.active .sidebar-icon {
    color: var(--brand-accent);
  }

  .sidebar-promo-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.85rem;
    margin-top: auto;
    margin-bottom: 0.5rem;
  }
  .sidebar-promo-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .sidebar-promo-desc {
    font-size: 0.7rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin-bottom: 0.65rem;
  }
  .sidebar-promo-btn {
    display: block;
    text-align: center;
    background: var(--brand-accent);
    color: #fff !important;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
  }

  /* Top Sticky Navigation */
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--bg-page);
    border-bottom: 1px solid var(--border-subtle);
    width: 100%;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--nav-height);
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
    flex-wrap: nowrap;
    gap: 1rem;
  }
  .brand-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }
  .dashboard-toggle-btn {
    display: flex;
