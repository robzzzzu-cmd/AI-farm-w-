---
// short-series/src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
  publishDate?: string | Date;
  schemaType?: 'FinancialAnalysis' | 'NewsArticle' | 'WebSite';
  image?: string;
}

const {
  title = 'Trade Opportunities | Daily Market Analysis',
  description = 'Actionable daily market analysis, algorithmic data, and financial trends.',
  publishDate,
  schemaType = 'WebSite',
  image = '/favicon.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://tradeopportunities.trade');
const absoluteImageURL = new URL(image, Astro.site || 'https://tradeopportunities.trade').toString();

// Build JSON-LD structured data payload
const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description: description,
  url: canonicalURL.toString(),
  image: absoluteImageURL,
  publisher: {
    '@type': 'Organization',
    name: 'Trade Opportunities',
    url: 'https://tradeopportunities.trade',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site || 'https://tradeopportunities.trade').toString(),
    },
  },
  ...(publishDate && {
    datePublished: new Date(publishDate).toISOString(),
    dateModified: new Date(publishDate).toISOString(),
  }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Search Console HTML Tag Verification -->
    <meta name="google-site-verification" content="b4gKaBVntaVzhwcTZk3jRMD3eVkdIzu2kd79Cv1RXV8" />
    
    <!-- Canonical & RSS Autodiscovery -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Trade Opportunities RSS Feed" href="/rss.xml" />
    
    <!-- Open Graph / Social Tags -->
    <meta property="og:type" content={schemaType === 'WebSite' ? 'website' : 'article'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageURL} />

    <!-- Twitter Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageURL} />

    <!-- Search Engine JSON-LD Schema Markup -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
