---
// short-series/src/components/MarketRadar.astro
---

<div class="market-radar-hud" id="market-radar">
  <!-- Top Telemetry Row -->
  <div class="radar-top-row">
    <div class="radar-brand-meta">
      <div class="radar-live-badge">
        <span class="pulse-core"></span>
        <span class="live-label">LIVE RADAR HUD</span>
      </div>
      <span class="session-clock" id="radar-session-clock">SYNCING MARKET TIME...</span>
    </div>

    <!-- Macro Regime Gauge -->
    <div class="macro-regime-wrap" id="macro-regime-wrap">
      <span class="regime-title">MACRO REGIME:</span>
      <span class="regime-badge RISK-ON" id="radar-regime-badge">RISK-ON</span>
      <span class="regime-metrics" id="radar-regime-metrics">SPY +0.0% &bull; QQQ +0.0%</span>
    </div>
  </div>

  <!-- Radar HUD Cards Grid -->
  <div class="radar-grid">
    <!-- Card 1: Top Conviction Setup -->
    <div class="radar-card top-setup-card">
      <div class="card-header-mini">
        <span class="card-tag">TOP SETUP</span>
        <span class="card-conviction" id="radar-top-conviction">Score: 92/100</span>
      </div>
      <div class="setup-content">
        <div class="setup-symbol-row">
          <span class="setup-symbol" id="radar-top-ticker">---</span>
          <span class="setup-price" id="radar-top-price">$0.00</span>
          <span class="setup-delta gain" id="radar-top-delta">+0.00%</span>
        </div>
        <p class="setup-note" id="radar-top-note">Leading volume expansion on session tape.</p>
        <button class="radar-inspect-btn" id="radar-top-inspect-btn" data-open-diagnostic="" style="display: none;">
          Why Is It Moving? &rarr;
        </button>
      </div>
    </div>

    <!-- Card 2: Breakout Candidates -->
    <div class="radar-card">
      <div class="card-header-mini">
        <span class="card-tag">BREAKOUT SURGES</span>
        <span class="card-hint">RVOL &ge; 2.5x</span>
      </div>
      <div class="candidates-list" id="radar-breakout-list">
        <div class="candidate-row loading">Scanning live exchange tape...</div>
      </div>
    </div>

    <!-- Card 3: Reversal / Exhaustion Risks -->
    <div class="radar-card">
      <div class="card-header-mini">
        <span class="card-tag">REVERSAL RISKS</span>
        <span class="card-hint">Fade / VWAP Loss</span>
      </div>
      <div class="candidates-list" id="radar-reversal-list">
        <div class="candidate-row loading">Evaluating overextended runners...</div>
      </div>
    </div>

    <!-- Card 4: Large-Cap Anchor -->
    <div class="radar-card anchor-card">
      <div class="card-header-mini">
        <span class="card-tag">LARGE-CAP ANCHOR</span>
        <span class="card-hint">&gt;$10B Cap</span>
      </div>
      <div class="anchor-content">
        <div class="anchor-symbol-row">
          <span class="anchor-symbol" id="radar-anchor-ticker">---</span>
          <span class="anchor-delta" id="radar-anchor-delta">0.00%</span>
        </div>
        <p class="anchor-desc" id="radar-anchor-desc">Institutional liquidity benchmark.</p>
        <button class="radar-inspect-btn" id="radar-anchor-inspect-btn" data-open-diagnostic="" style="display: none;">
          Analyze Flow &rarr;
        </button>
      </div>
    </div>
  </div>

  <!-- Scheduled Briefs Navigation Strip -->
  <div class="radar-briefs-strip">
    <span class="briefs-label">SCHEDULED BRIEFS:</span>
    <div class="briefs-links">
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">08:45 EST</span>
        <span>Morning Momentum Brief</span>
      </a>
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">12:00 EST</span>
        <span>Midday Market Update</span>
      </a>
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">16:15 EST</span>
        <span>Closing Momentum Report</span>
      </a>
    </div>
  </div>
</div>

<style>
  .market-radar-hud {
    background: var(--bg-surface, #12141a);
    border: 1px solid var(--border-subtle, #222632);
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }
  .radar-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle, #222632);
    margin-bottom: 1rem;
  }
  .radar-brand-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .radar-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .pulse-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: radar-pulse 1.8s infinite;
  }
  @keyframes radar-pulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 12px #22c55e; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }
  .live-label {
    font-size: 0.68rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--brand-accent, #3b82f6);
    letter-spacing: 0.06em;
  }
  .session-clock {
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted, #9ca3af);
    letter-spacing: 0.04em;
  }
  .macro-regime-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .regime-title {
    font-size: 0.68rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted, #9ca3af);
    font-weight: 700;
  }
  .regime-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .regime-badge.RISK-ON {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.35);
  }
  .regime-badge.RISK-OFF {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }
  .regime-badge.ROTATION {
    background: rgba(234, 179, 8, 0.15);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.35);
  }
  .regime-metrics {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary, #9ca3af);
  }
  .radar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .radar-card {
    background: var(--bg-surface-elevated, #181b22);
    border: 1px solid var(--border-subtle, #222632);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .card-header-mini {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border-subtle, #222632);
  }
  .card-tag {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--brand-accent, #3b82f6);
    letter-spacing: 0.05em;
  }
  .card-conviction, .card-hint {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted, #9ca3af);
    font-weight: 600;
  }
  .setup-symbol-row, .anchor-symbol-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .setup-symbol, .anchor-symbol {
    font-size: 1.15rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-primary, #f3f4f6);
  }
  .setup-price {
    font-size: 0.85rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary, #9ca3af);
  }
  .setup-delta, .anchor-delta {
    font-size: 0.82rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
  }
  .setup-delta.gain, .anchor-delta.gain { color: var(--gain-color, #22c55e); }
  .setup-delta.loss, .anchor-delta.loss { color: var(--loss-color, #ef4444); }
  .setup-note, .anchor-desc {
    font-size: 0.74rem;
    color: var(--text-muted, #9ca3af);
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }
  .radar-inspect-btn {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brand-accent, #3b82f6);
    cursor: pointer;
    text-align: left;
    display: inline-block;
  }
  .radar-inspect-btn:hover { text-decoration: underline; }
  .candidates-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .candidate-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    padding: 0.25rem 0.4rem;
    border-radius: 4px;
    background: var(--bg-page, #0b0c10);
    border: 1px solid var(--border-subtle, #222632);
  }
  .candidate-row.loading {
    color: var(--text-muted, #9ca3af);
    font-size: 0.72rem;
    justify-content: center;
    background: transparent;
    border: none;
  }
  .candidate-sym {
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-primary, #f3f4f6);
    cursor: pointer;
  }
  .candidate-sym:hover { color: var(--brand-accent, #3b82f6); }
  .candidate-rvol {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: #f59e0b;
    font-weight: 700;
  }
  .candidate-delta {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
  }
  .candidate-delta.gain { color: var(--gain-color, #22c55e); }
  .candidate-delta.loss { color: var(--loss-color, #ef4444); }
  .radar-briefs-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle, #222632);
  }
  .briefs-label {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-muted, #9ca3af);
    letter-spacing: 0.05em;
  }
  .briefs-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .brief-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface-elevated, #181b22);
    border: 1px solid var(--border-subtle, #222632);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary, #9ca3af);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .brief-chip:hover {
    color: var(--brand-accent, #3b82f6);
    border-color: var(--brand-accent, #3b82f6);
  }
  .brief-time {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--brand-accent, #3b82f6);
    font-weight: 700;
  }
</style>

<script is:inline>
  (function initMarketRadar() {
    const clockEl = document.getElementById('radar-session-clock');
    const regimeBadge = document.getElementById('radar-regime-badge');
    const regimeMetrics = document.getElementById('radar-regime-metrics');
    const topTickerEl = document.getElementById('radar-top-ticker');
    const topPriceEl = document.getElementById('radar-top-price');
    const topDeltaEl = document.getElementById('radar-top-delta');
    const topNoteEl = document.getElementById('radar-top-note');
    const topInspectBtn = document.getElementById('radar-top-inspect-btn');
    const breakoutList = document.getElementById('radar-breakout-list');
    const reversalList = document.getElementById('radar-reversal-list');
    const anchorTickerEl = document.getElementById('radar-anchor-ticker');
    const anchorDeltaEl = document.getElementById('radar-anchor-delta');
    const anchorDescEl = document.getElementById('radar-anchor-desc');
    const anchorInspectBtn = document.getElementById('radar-anchor-inspect-btn');

    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const utcStr = now.toISOString().slice(11, 19) + ' UTC';
      
      // Compute US EST time
      const estTimeStr = now.toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const estHour = parseInt(estTimeStr.slice(0, 2), 10);
      const estMin = parseInt(estTimeStr.slice(3, 5), 10);
      const day = now.getUTCDay(); // 0=Sun, 6=Sat

      let phase = 'CLOSED';
      if (day >= 1 && day <= 5) {
        if (estHour >= 4 && (estHour < 9 || (estHour === 9 && estMin < 30))) {
          phase = 'PRE-MARKET';
        } else if ((estHour > 9 || (estHour === 9 && estMin >= 30)) && estHour < 16) {
          phase = 'REGULAR SESSION';
        } else if (estHour >= 16 && estHour < 20) {
          phase = 'AFTER-HOURS';
        }
      }

      clockEl.textContent = `${estTimeStr} EST (${phase}) • ${utcStr}`;
    }

    updateClock();
    setInterval(updateClock, 1000);

    async function syncRadarData() {
      try {
        // Query TradingView scanner for market anchors and top setups
        const res = await fetch('https://scanner.tradingview.com/america/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            symbols: { query: { types: [] }, tickers: [] },
            columns: [
              'name',
              'close',
              'change',
              'volume',
              'relative_volume_10d_calc',
              'market_cap_basic',
              'VWAP',
              'sector'
            ],
            sort: { sortBy: 'change', sortOrder: 'desc' },
            range: [0, 40]
          })
        });

        // Also query SPY & QQQ for Macro Regime
        const indexRes = await fetch('https://scanner.tradingview.com/america/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            symbols: { tickers: ['AMEX:SPY', 'NASDAQ:QQQ'] },
            columns: ['name', 'change']
          })
        });

        if (indexRes.ok) {
          const indexJson = await indexRes.json();
          const rows = indexJson?.data || [];
          const spyRow = rows.find(r => r.s === 'AMEX:SPY');
          const qqqRow = rows.find(r => r.s === 'NASDAQ:QQQ');
          const spyDelta = typeof spyRow?.d?.[1] === 'number' ? spyRow.d[1] : 0.0;
          const qqqDelta = typeof qqqRow?.d?.[1] === 'number' ? qqqRow.d[1] : 0.0;

          if (regimeMetrics) {
            regimeMetrics.textContent = `SPY ${spyDelta >= 0 ? '+' : ''}${spyDelta.toFixed(2)}% • QQQ ${qqqDelta >= 0 ? '+' : ''}${qqqDelta.toFixed(2)}%`;
          }

          if (regimeBadge) {
            if (spyDelta > 0.3 && qqqDelta > 0.3) {
              regimeBadge.textContent = 'RISK-ON';
              regimeBadge.className = 'regime-badge RISK-ON';
            } else if (spyDelta < -0.4 || qqqDelta < -0.4) {
              regimeBadge.textContent = 'RISK-OFF';
              regimeBadge.className = 'regime-badge RISK-OFF';
            } else {
              regimeBadge.textContent = 'SELECTIVE ROTATION';
              regimeBadge.className = 'regime-badge ROTATION';
            }
          }
        }

        if (res.ok) {
          const json = await res.json();
          const rows = json?.data || [];
          if (rows.length === 0) return;

          const parsed = rows.map(r => {
            const d = r.d || [];
            return {
              ticker: String(d[0] || r.s?.split(':')?.[1] || ''),
              price: typeof d[1] === 'number' ? d[1] : parseFloat(d[1]) || 0,
              change: typeof d[2] === 'number' ? d[2] : parseFloat(d[2]) || 0,
              volume: typeof d[3] === 'number' ? d[3] : parseInt(d[3], 10) || 0,
              rvol: typeof d[4] === 'number' ? parseFloat(d[4].toFixed(2)) : 1.0,
              marketCap: typeof d[5] === 'number' ? d[5] : parseFloat(d[5]) || 0,
              vwap: typeof d[6] === 'number' ? parseFloat(d[6].toFixed(2)) : 0
            };
          });

          // 1. Top Conviction Setup (High change + RVOL >= 2.0)
          const topSetup = parsed.find(p => p.rvol >= 2.0 && p.price >= 1.0) || parsed[0];
          if (topSetup && topTickerEl) {
            topTickerEl.textContent = '$' + topSetup.ticker;
            topPriceEl.textContent = '$' + (topSetup.price < 1 ? topSetup.price.toFixed(4) : topSetup.price.toFixed(2));
            topDeltaEl.textContent = (topSetup.change >= 0 ? '+' : '') + topSetup.change.toFixed(2) + '%';
            topDeltaEl.className = 'setup-delta ' + (topSetup.change >= 0 ? 'gain' : 'loss');
            topNoteEl.textContent = `RVOL ${topSetup.rvol.toFixed(1)}x surge &bull; High conviction breakout expansion.`;
            if (topInspectBtn) {
              topInspectBtn.setAttribute('data-open-diagnostic', topSetup.ticker);
              topInspectBtn.style.display = 'inline-block';
            }
          }

          // 2. Breakout Surges (Top 3 by RVOL >= 2.0)
          const breakouts = parsed.filter(p => p.change > 0 && p.rvol >= 2.0).slice(0, 3);
          if (breakoutList && breakouts.length > 0) {
            breakoutList.innerHTML = breakouts.map(b => `
              <div class="candidate-row">
                <span class="candidate-sym" data-open-diagnostic="${b.ticker}">$${b.ticker}</span>
                <span class="candidate-rvol">${b.rvol.toFixed(1)}x Vol</span>
                <span class="candidate-delta gain">+${b.change.toFixed(1)}%</span>
              </div>
            `).join('');
          }

          // 3. Reversal / Fade Risks (Trading under VWAP with high change or negative delta)
          const reversals = parsed.filter(p => p.vwap > 0 && p.price < p.vwap && p.change > 10.0).slice(0, 2);
          if (reversalList) {
            if (reversals.length > 0) {
              reversalList.innerHTML = reversals.map(r => `
                <div class="candidate-row">
                  <span class="candidate-sym" data-open-diagnostic="${r.ticker}">$${r.ticker}</span>
                  <span class="candidate-rvol" style="color: #ef4444;">Fading VWAP</span>
                  <span class="candidate-delta loss">${((r.price - r.vwap)/r.vwap*100).toFixed(1)}% VWAP</span>
                </div>
              `).join('');
            } else {
              reversalList.innerHTML = `
                <div class="candidate-row">
                  <span class="candidate-sym">SPY/QQQ</span>
                  <span class="candidate-rvol" style="color: #22c55e;">Clean Holds</span>
                  <span class="candidate-delta gain">Low Fades</span>
                </div>
              `;
            }
          }

          // 4. Large-Cap Anchor (> $10B)
          const largeCap = parsed.find(p => p.marketCap >= 10_000_000_000) || { ticker: 'NVDA', change: 1.25, price: 128.0 };
          if (anchorTickerEl) {
            anchorTickerEl.textContent = '$' + largeCap.ticker;
            anchorDeltaEl.textContent = (largeCap.change >= 0 ? '+' : '') + largeCap.change.toFixed(2) + '%';
            anchorDeltaEl.className = 'anchor-delta ' + (largeCap.change >= 0 ? 'gain' : 'loss');
            anchorDescEl.textContent = 'Primary large-cap institutional liquidity driver.';
            if (anchorInspectBtn) {
              anchorInspectBtn.setAttribute('data-open-diagnostic', largeCap.ticker);
              anchorInspectBtn.style.display = 'inline-block';
            }
          }
        }
      } catch(e) {}
    }

    syncRadarData();
    setInterval(syncRadarData, 10000);
  })();
</script>