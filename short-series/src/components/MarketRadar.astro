---
// short-series/src/components/MarketRadar.astro
---

<div class="market-radar-hud" id="market-radar">
  <!-- Top Telemetry Header -->
  <div class="radar-top-row">
    <div class="radar-brand-meta">
      <div class="radar-live-badge">
        <span class="pulse-core"></span>
        <span class="live-label">LIVE RADAR HUD</span>
      </div>
      <span class="session-clock" id="radar-session-clock">SYNCING MARKET CLOCK...</span>
    </div>

    <!-- Macro Regime Gauge -->
    <div class="macro-regime-wrap" id="macro-regime-wrap">
      <span class="regime-title">MACRO REGIME:</span>
      <span class="regime-badge RISK-ON" id="radar-regime-badge">RISK-ON</span>
      <span class="regime-metrics" id="radar-regime-metrics">SPY +0.0% &bull; QQQ +0.0%</span>
    </div>
  </div>

  <!-- Radar HUD Cards Grid -->
  <div class="radar-grid">
    <!-- Card 1: Top Conviction Setup -->
    <div class="radar-card top-setup-card">
      <div class="card-header-mini">
        <span class="card-tag">TOP CONVICTION SETUP</span>
        <span class="card-conviction" id="radar-top-conviction">Score: 92/100</span>
      </div>
      <div class="setup-content">
        <div class="setup-symbol-row">
          <span class="setup-symbol" id="radar-top-ticker">---</span>
          <span class="setup-price" id="radar-top-price">$0.00</span>
          <span class="setup-delta gain" id="radar-top-delta">+0.00%</span>
        </div>
        <p class="setup-note" id="radar-top-note">Leading volume expansion on session tape.</p>
        <button type="button" class="radar-action-btn" id="radar-top-inspect-btn" data-open-diagnostic="" style="display: none;">
          <span>Why Is It Moving?</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Card 2: Breakout Surges -->
    <div class="radar-card">
      <div class="card-header-mini">
        <span class="card-tag">BREAKOUT SURGES</span>
        <span class="card-hint">RVOL &ge; 2.5x</span>
      </div>
      <div class="candidates-list" id="radar-breakout-list">
        <div class="candidate-row loading">Synchronizing live breakout tape...</div>
      </div>
    </div>

    <!-- Card 3: Reversal / Exhaustion Risks -->
    <div class="radar-card">
      <div class="card-header-mini">
        <span class="card-tag">REVERSAL RISKS</span>
        <span class="card-hint">Fade / VWAP Loss</span>
      </div>
      <div class="candidates-list" id="radar-reversal-list">
        <div class="candidate-row loading">Evaluating overextended runners...</div>
      </div>
    </div>

    <!-- Card 4: Large-Cap Anchor -->
    <div class="radar-card anchor-card">
      <div class="card-header-mini">
        <span class="card-tag">LARGE-CAP ANCHOR</span>
        <span class="card-hint">Megacap Tape</span>
      </div>
      <div class="anchor-content">
        <div class="anchor-symbol-row">
          <span class="anchor-symbol" id="radar-anchor-ticker">---</span>
          <span class="anchor-price" id="radar-anchor-price">$0.00</span>
          <span class="anchor-delta gain" id="radar-anchor-delta">0.00%</span>
        </div>
        <p class="anchor-desc" id="radar-anchor-desc">Primary market liquidity leader.</p>
        <button type="button" class="radar-action-btn" id="radar-anchor-inspect-btn" data-open-diagnostic="" style="display: none;">
          <span>Analyze Flow</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Scheduled Briefs Navigation Strip -->
  <div class="radar-briefs-strip">
    <span class="briefs-label">SCHEDULED BRIEFS:</span>
    <div class="briefs-links">
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">08:45 EST</span>
        <span>Morning Momentum Brief</span>
      </a>
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">12:00 EST</span>
        <span>Midday Market Update</span>
      </a>
      <a href="#news-feed" class="brief-chip">
        <span class="brief-time">16:15 EST</span>
        <span>Closing Momentum Report</span>
      </a>
    </div>
  </div>
</div>

<style>
  .market-radar-hud {
    background: #0f131c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.15rem 1.35rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  /* Top Bar */
  .radar-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 1rem;
  }
  .radar-brand-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .radar-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .pulse-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: radar-pulse 1.8s infinite;
  }
  @keyframes radar-pulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 10px #22c55e; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }
  .live-label {
    font-size: 0.68rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    color: #60a5fa;
    letter-spacing: 0.06em;
  }
  .session-clock {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #94a3b8;
    letter-spacing: 0.02em;
  }

  /* Macro Regime */
  .macro-regime-wrap {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .regime-title {
    font-size: 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #64748b;
    font-weight: 700;
  }
  .regime-badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .regime-badge.RISK-ON {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.35);
  }
  .regime-badge.RISK-OFF {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }
  .regime-badge.ROTATION {
    background: rgba(234, 179, 8, 0.15);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.35);
  }
  .regime-metrics {
    font-size: 0.72rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #cbd5e1;
  }

  /* Grid & Cards */
  .radar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .radar-card {
    background: #141824;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease;
  }
  .radar-card:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }
  .card-header-mini {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .card-tag {
    font-size: 0.68rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    color: #60a5fa;
    letter-spacing: 0.05em;
  }
  .card-conviction, .card-hint {
    font-size: 0.68rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #94a3b8;
    font-weight: 600;
  }
  .setup-symbol-row, .anchor-symbol-row {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }
  .setup-symbol, .anchor-symbol {
    font-size: 1.2rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    color: #f8fafc;
  }
  .setup-price, .anchor-price {
    font-size: 0.88rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #94a3b8;
    font-weight: 600;
  }
  .setup-delta, .anchor-delta {
    font-size: 0.85rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }
  .setup-delta.gain, .anchor-delta.gain {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }
  .setup-delta.loss, .anchor-delta.loss {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }
  .setup-note, .anchor-desc {
    font-size: 0.76rem;
    color: #94a3b8;
    line-height: 1.4;
    margin: 0 0 0.6rem 0;
  }
  .radar-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.74rem;
    font-weight: 700;
    color: #3b82f6;
    cursor: pointer;
    text-align: left;
    transition: color 0.12s ease;
  }
  .radar-action-btn:hover { color: #60a5fa; text-decoration: underline; }

  /* Briefs Strip */
  .radar-briefs-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .briefs-label {
    font-size: 0.68rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.05em;
  }
  .briefs-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .brief-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #141824;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.74rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .brief-chip:hover {
    color: #60a5fa;
    border-color: #3b82f6;
  }
  .brief-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    color: #60a5fa;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .market-radar-hud {
      padding: 0.85rem 0.85rem;
    }
    .radar-top-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
    }
    .radar-brand-meta {
      justify-content: space-between;
      width: 100%;
    }
    .macro-regime-wrap {
      width: 100%;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    .radar-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.65rem;
    }
    .radar-briefs-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .briefs-links {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      flex-wrap: nowrap;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .briefs-links::-webkit-scrollbar {
      display: none;
    }
    .brief-chip {
      flex-shrink: 0;
    }
  }

  @media (max-width: 500px) {
    .radar-grid {
      grid-template-columns: 1fr;
    }
    .setup-symbol-row, .anchor-symbol-row {
      align-items: center;
      gap: 0.45rem;
    }
    .setup-symbol, .anchor-symbol {
      font-size: 1.1rem;
    }
  }
</style>

<style is:global>
  /* Dynamic candidate rows in MarketRadar */
  .candidates-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .candidate-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    padding: 0.35rem 0.55rem;
    border-radius: 5px;
    background: var(--bg-surface, #111622) !important;
    border: 1px solid var(--border-subtle, #1e2638) !important;
    transition: border-color 0.12s ease;
  }
  .candidate-row:hover {
    border-color: rgba(56, 189, 248, 0.4) !important;
  }
  .candidate-row.loading {
    color: var(--text-muted, #64748b);
    font-size: 0.75rem;
    justify-content: center;
    background: transparent !important;
    border: none !important;
  }
  .candidate-sym {
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-primary, #f1f5f9);
    cursor: pointer;
    transition: color 0.12s ease;
  }
  .candidate-sym:hover { color: var(--brand-accent, #38bdf8); }
  .candidate-rvol {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: #f59e0b;
    font-weight: 700;
  }
  .candidate-delta {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    font-size: 0.76rem;
  }
  .candidate-delta.gain { color: #22c55e !important; }
  .candidate-delta.loss { color: #ef4444 !important; }
</style>

<script is:inline>
  (function initMarketRadar() {
    const clockEl = document.getElementById('radar-session-clock');
    const regimeBadge = document.getElementById('radar-regime-badge');
    const regimeMetrics = document.getElementById('radar-regime-metrics');
    const topTickerEl = document.getElementById('radar-top-ticker');
    const topPriceEl = document.getElementById('radar-top-price');
    const topDeltaEl = document.getElementById('radar-top-delta');
    const topNoteEl = document.getElementById('radar-top-note');
    const topConvictionEl = document.getElementById('radar-top-conviction');
    const topInspectBtn = document.getElementById('radar-top-inspect-btn');
    const breakoutList = document.getElementById('radar-breakout-list');
    const reversalList = document.getElementById('radar-reversal-list');
    const anchorTickerEl = document.getElementById('radar-anchor-ticker');
    const anchorPriceEl = document.getElementById('radar-anchor-price');
    const anchorDeltaEl = document.getElementById('radar-anchor-delta');
    const anchorDescEl = document.getElementById('radar-anchor-desc');
    const anchorInspectBtn = document.getElementById('radar-anchor-inspect-btn');

    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const utcStr = now.toISOString().slice(11, 19) + ' UTC';
      
      const estTimeStr = now.toLocaleTimeString('en-US', { 
        timeZone: 'America/New_York', 
        hour12: false, 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit' 
      });
      const estHour = parseInt(estTimeStr.slice(0, 2), 10);
      const estMin = parseInt(estTimeStr.slice(3, 5), 10);
      const day = now.getUTCDay(); // 0=Sun, 6=Sat

      let phase = 'CLOSED';
      if (day >= 1 && day <= 5) {
        if (estHour >= 4 && (estHour < 9 || (estHour === 9 && estMin < 30))) {
          phase = 'PRE-MARKET';
        } else if ((estHour > 9 || (estHour === 9 && estMin >= 30)) && estHour < 16) {
          phase = 'REGULAR SESSION';
        } else if (estHour >= 16 && estHour < 20) {
          phase = 'AFTER-HOURS';
        }
      } else {
        phase = 'WEEKEND';
      }

      clockEl.textContent = `${estTimeStr} EST (${phase}) • ${utcStr}`;
    }

    updateClock();
    setInterval(updateClock, 1000);

    // Sync live radar data from server SSR API (avoids CORS)
    async function syncRadarData() {
      try {
        const res = await fetch('/api/radar');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.success) return;

        // 1. Macro Regime
        if (data.macroRegime) {
          const mr = data.macroRegime;
          if (regimeBadge) {
            regimeBadge.textContent = mr.label || mr.regime;
            regimeBadge.className = `regime-badge ${mr.regime}`;
          }
          if (regimeMetrics && mr.spy && mr.qqq) {
            const spyStr = `SPY ${mr.spy.change >= 0 ? '+' : ''}${mr.spy.change.toFixed(2)}%`;
            const qqqStr = `QQQ ${mr.qqq.change >= 0 ? '+' : ''}${mr.qqq.change.toFixed(2)}%`;
            regimeMetrics.textContent = `${spyStr} • ${qqqStr}`;
          }
        }

        // 2. Top Conviction Setup
        if (data.topSetup && topTickerEl) {
          const ts = data.topSetup;
          topTickerEl.textContent = '$' + ts.ticker;
          topPriceEl.textContent = '$' + (ts.price < 1 ? ts.price.toFixed(4) : ts.price.toFixed(2));
          topDeltaEl.textContent = (ts.change >= 0 ? '+' : '') + ts.change.toFixed(2) + '%';
          topDeltaEl.className = 'setup-delta ' + (ts.change >= 0 ? 'gain' : 'loss');
          topNoteEl.textContent = `RVOL ${ts.rvol.toFixed(1)}x surge • Leading high conviction expansion tape.`;
          if (topConvictionEl && ts.convictionScore) {
            topConvictionEl.textContent = `Score: ${ts.convictionScore}/100`;
          }
          if (topInspectBtn) {
            topInspectBtn.setAttribute('data-open-diagnostic', ts.ticker);
            topInspectBtn.style.display = 'inline-flex';
          }
        }

        // 3. Breakout Surges
        if (breakoutList && Array.isArray(data.breakoutSurges) && data.breakoutSurges.length > 0) {
          breakoutList.innerHTML = data.breakoutSurges.map(b => `
            <div class="candidate-row">
              <span class="candidate-sym" data-open-diagnostic="${b.ticker}">$${b.ticker}</span>
              <span class="candidate-rvol">${b.rvol.toFixed(1)}x Vol</span>
              <span class="candidate-delta gain">+${b.change.toFixed(1)}%</span>
            </div>
          `).join('');
        }

        // 4. Reversal Risks
        if (reversalList && Array.isArray(data.reversalRisks)) {
          if (data.reversalRisks[0]?.status) {
            reversalList.innerHTML = `
              <div class="candidate-row">
                <span class="candidate-sym">SPY / QQQ</span>
                <span class="candidate-rvol" style="color: #22c55e;">Clean Holds</span>
                <span class="candidate-delta gain">Low Fades</span>
              </div>
            `;
          } else {
            reversalList.innerHTML = data.reversalRisks.map(r => `
              <div class="candidate-row">
                <span class="candidate-sym" data-open-diagnostic="${r.ticker}">$${r.ticker}</span>
                <span class="candidate-rvol" style="color: #ef4444;">Fading VWAP</span>
                <span class="candidate-delta loss">${r.vwapDiff}%</span>
              </div>
            `).join('');
          }
        }

        // 5. Large-Cap Anchor
        if (data.largeCapAnchor && anchorTickerEl) {
          const lca = data.largeCapAnchor;
          anchorTickerEl.textContent = '$' + lca.ticker;
          if (anchorPriceEl) {
            anchorPriceEl.textContent = '$' + (lca.price < 1 ? lca.price.toFixed(4) : lca.price.toFixed(2));
          }
          anchorDeltaEl.textContent = (lca.change >= 0 ? '+' : '') + lca.change.toFixed(2) + '%';
          anchorDeltaEl.className = 'anchor-delta ' + (lca.change >= 0 ? 'gain' : 'loss');
          anchorDescEl.textContent = `Institutional tape benchmark (${lca.name || lca.ticker}).`;
          if (anchorInspectBtn) {
            anchorInspectBtn.setAttribute('data-open-diagnostic', lca.ticker);
            anchorInspectBtn.style.display = 'inline-flex';
          }
        }
      } catch (err) {}
    }

    syncRadarData();
    setInterval(syncRadarData, 10000);
  })();
</script>