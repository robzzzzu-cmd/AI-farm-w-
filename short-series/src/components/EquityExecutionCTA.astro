---
// short-series/src/components/EquityExecutionCTA.astro
interface Props {
  symbol: string;
  dilutionRisk?: string;
}

const { symbol = 'SPY', dilutionRisk = 'LOW DILUTION' } = Astro.props;
const cleanSymbol = (symbol || 'SPY').trim().toUpperCase().replace(/^\$/, '');
const tvChartUrl = `https://www.tradingview.com/symbols/${cleanSymbol}/?aff_id=170147`;
const tvProUrl = `https://www.tradingview.com/?aff_id=170147`;
const isHighDilution = Boolean(
  dilutionRisk &&
  (dilutionRisk.toUpperCase().includes('HIGH') || dilutionRisk.toUpperCase().includes('ATM') || dilutionRisk.toUpperCase().includes('RISK'))
);
---

<div class="equity-execution-cta bg-[#111726] border border-[#1E293B] rounded-lg p-3.5" data-equity-cta-symbol={cleanSymbol}>
  <div class="cta-top-meta">
    <div class="cta-kicker-group">
      <span class="cta-terminal-dot"></span>
      <span class="cta-kicker font-mono tabular-nums tracking-tight">INSTITUTIONAL CHARTING &amp; EXECUTION ROUTING // ${cleanSymbol}</span>
    </div>
    {dilutionRisk && (
      <span
        class={`cta-dilution-pill font-mono tabular-nums tracking-tight ${
          isHighDilution
            ? 'text-[#F43F5E] bg-[#F43F5E]/10 border border-[#F43F5E]/20'
            : 'text-[#10B981] bg-[#10B981]/10 border border-[#10B981]/20'
        }`}
      >
        {dilutionRisk}
      </span>
    )}
  </div>

  <div class="cta-actions-row">
    <a
      href={tvChartUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="cta-btn-primary bg-[#38BDF8] hover:bg-sky-400 text-[#090D16] font-semibold text-xs px-3.5 py-2 rounded-md transition font-mono tabular-nums tracking-tight"
    >
      Launch ${cleanSymbol} Multi-Timeframe Chart on TradingView ↗
    </a>

    <a
      href={tvProUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="cta-btn-secondary border border-[#1E293B] hover:bg-[#1A2234] text-slate-200 text-xs px-3 py-2 rounded-md transition font-mono tabular-nums tracking-tight"
    >
      Compare Short Locate &amp; Low-Commission Execution ↗
    </a>
  </div>
</div>

<style>
  .font-mono { font-family: 'JetBrains Mono', var(--font-mono, monospace); }
  .tabular-nums { font-variant-numeric: tabular-nums; }
  .tracking-tight { letter-spacing: -0.025em; }

  .equity-execution-cta {
    background: #111726;
    border: 1px solid #1E293B;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .cta-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cta-kicker-group {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cta-terminal-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #38BDF8;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.7);
  }

  .cta-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.05em;
  }

  .cta-dilution-pill {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
  }

  .text-\[\#10B981\] {
    color: #10B981;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .text-\[\#F43F5E\] {
    color: #F43F5E;
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.2);
  }

  .cta-actions-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #38BDF8;
    color: #090D16 !important;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.375rem;
    text-decoration: none !important;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .cta-btn-primary:hover {
    background-color: #38bdf8;
    filter: brightness(1.08);
    text-decoration: none !important;
  }

  .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #090D16;
    border: 1px solid #1E293B;
    color: #E2E8F0 !important;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none !important;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .cta-btn-secondary:hover {
    background-color: #1A2234;
    border-color: #38BDF8;
    text-decoration: none !important;
  }
</style>
