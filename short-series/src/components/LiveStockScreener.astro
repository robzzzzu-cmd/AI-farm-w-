---
// short-series/src/components/LiveStockScreener.astro
import { SCREENER_CONFIG } from '../config/screenerConfig';

const { categories, platformNotice, dataFeedNotice } = SCREENER_CONFIG;
const categoriesList = Object.values(categories);
---

<div class="screener-wrapper" id="screener">
  <!-- Header & Practical Classification Explanation -->
  <div class="screener-header-card">
    <div class="screener-title-row">
      <div>
        <div class="screener-pill-badge">QUANTITATIVE MARKET RADAR</div>
        <h2 class="screener-title">Live Stock Screener &bull; Real-Time Opportunities</h2>
      </div>
      
      <div class="screener-sync-box">
        <div class="pulse-indicator">
          <span class="live-dot" id="screener-pulse-dot"></span>
          <span class="sync-status" id="screener-status-text">FEED ACTIVE</span>
        </div>
        <span class="sync-timer" id="screener-last-updated">Last updated: Just now</span>
        <button id="screener-manual-refresh-btn" class="manual-refresh-btn" title="Sync Live Market Feed" aria-label="Refresh Data">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span>Sync</span>
        </button>
      </div>
    </div>

    <!-- UI Explanation: Platform Categories rather than universal industry definitions -->
    <div class="classification-callout">
      <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <p>{platformNotice}</p>
    </div>

    <!-- Category Tabs Navigation -->
    <div class="screener-tabs" role="tablist">
      {categoriesList.map((cat, idx) => (
        <button 
          class={`screener-tab-btn ${idx === 0 ? 'active' : ''}`}
          role="tab"
          data-category={cat.id}
          id={`tab-${cat.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          <span class="tab-title">{cat.name}</span>
          <span class="tab-sub">{cat.subtitle}</span>
        </button>
      ))}
    </div>

    <div class="category-meta-row">
      <span class="category-description-text" id="category-desc">
        {categoriesList[0].description}
      </span>
      <span class="category-count-badge" id="screener-count-badge">Tracking Top Movers</span>
    </div>
  </div>

  <!-- Search & Fast Multi-Filtering Toolbar -->
  <div class="screener-toolbar">
    <div class="toolbar-primary">
      <div class="search-field">
        <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="screener-search-input" 
          class="screener-input" 
          placeholder="Filter by Ticker or Company name..." 
          autocomplete="off"
        />
        <button id="screener-search-clear" class="clear-input-btn" style="display: none;">&times;</button>
      </div>

      <div class="toolbar-controls">
        <div class="control-group">
          <label for="screener-sector-select">Sector:</label>
          <select id="screener-sector-select" class="screener-select">
            <option value="ALL">All Sectors</option>
            <option value="Electronic Technology">Electronic Technology</option>
            <option value="Technology Services">Technology Services</option>
            <option value="Health Technology">Health Technology</option>
            <option value="Finance">Finance</option>
            <option value="Consumer Services">Consumer Services</option>
            <option value="Consumer Non-Durables">Consumer Goods</option>
            <option value="Energy Minerals">Energy</option>
            <option value="Producer Manufacturing">Industrials</option>
          </select>
        </div>

        <div class="control-group">
          <label for="screener-sort-select">Sort By:</label>
          <select id="screener-sort-select" class="screener-select">
            <option value="momentum">Strongest Momentum (Default)</option>
            <option value="change_desc">Best Performers (% Gain)</option>
            <option value="change_asc">Worst Performers (% Loss)</option>
            <option value="volume_desc">Highest Volume</option>
            <option value="rvol_desc">Highest Relative Volume (RVOL)</option>
            <option value="conviction_desc">Highest Conviction</option>
            <option value="market_cap_desc">Market Cap (High to Low)</option>
            <option value="price_desc">Price (High to Low)</option>
          </select>
        </div>

        <button id="screener-filter-toggle-btn" class="toggle-filters-btn">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
          <span>More Filters</span>
          <span class="active-filter-dot" id="active-filter-indicator" style="display: none;"></span>
        </button>
      </div>
    </div>

    <!-- Expandable Advanced Filters Panel -->
    <div class="advanced-filter-panel" id="advanced-filter-panel" style="display: none;">
      <div class="filter-grid">
        <div class="filter-cell">
          <span class="cell-label">Min % Gain</span>
          <select id="filter-min-gain" class="screener-select">
            <option value="0">Any Gain</option>
            <option value="3">&gt; +3%</option>
            <option value="5">&gt; +5%</option>
            <option value="10">&gt; +10%</option>
            <option value="20">&gt; +20%</option>
          </select>
        </div>

        <div class="filter-cell">
          <span class="cell-label">Decliners / % Loss</span>
          <select id="filter-max-loss" class="screener-select">
            <option value="0">All Stocks</option>
            <option value="-1">Decliners (&lt; 0%)</option>
            <option value="-5">Loss &gt; 5%</option>
            <option value="-10">Loss &gt; 10%</option>
          </select>
        </div>

        <div class="filter-cell">
          <span class="cell-label">Min Session Volume</span>
          <select id="filter-min-volume" class="screener-select">
            <option value="0">Any Volume</option>
            <option value="100000">&gt; 100K Shares</option>
            <option value="500000">&gt; 500K Shares</option>
            <option value="1000000">&gt; 1M Shares</option>
            <option value="5000000">&gt; 5M Shares</option>
          </select>
        </div>

        <div class="filter-cell">
          <span class="cell-label">Relative Volume (RVOL)</span>
          <select id="filter-min-rvol" class="screener-select">
            <option value="0">Any RVOL</option>
            <option value="1.2">&gt; 1.2x (Above Avg)</option>
            <option value="1.5">&gt; 1.5x (Elevated)</option>
            <option value="2.0">&gt; 2.0x (Surge)</option>
          </select>
        </div>

        <div class="filter-cell">
          <span class="cell-label">Momentum Score</span>
          <select id="filter-min-momentum" class="screener-select">
            <option value="0">Any Score</option>
            <option value="60">&gt; 60 (Positive)</option>
            <option value="75">&gt; 75 (High Momentum)</option>
            <option value="85">&gt; 85 (Velocity Spike)</option>
          </select>
        </div>

        <div class="filter-cell">
          <span class="cell-label">Conviction Rating</span>
          <select id="filter-conviction" class="screener-select">
            <option value="ALL">All Scores</option>
            <option value="65">Bullish Setup+ (&ge;65)</option>
            <option value="80">High Conviction (&ge;80)</option>
          </select>
        </div>
      </div>

      <div class="filter-actions-row">
        <span class="filter-helper-note">Client-side filtering executes instantly without external API overhead.</span>
        <button id="screener-reset-filters-btn" class="reset-filters-btn">Reset All Filters</button>
      </div>
    </div>
  </div>

  <!-- Stale / Delay Data Banner (Activates if upstream feed pauses) -->
  <div id="screener-stale-banner" class="stale-alert-banner" style="display: none;">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <span id="stale-banner-text">Data delayed: Connection to data feed is synchronizing. Retaining last observed session snapshot.</span>
  </div>

  <!-- Modern Interactive Stock Screener Table Container -->
  <div class="screener-table-card">
    <div class="table-responsive-viewport">
      <table class="screener-table" id="screener-live-table">
        <thead>
          <tr>
            <th data-sort="name">Ticker / Company</th>
            <th data-sort="price" class="text-right">Price</th>
            <th data-sort="change_abs" class="text-right">Change ($)</th>
            <th data-sort="change_desc" class="text-right">Change (%)</th>
            <th data-sort="volume_desc" class="text-right">Volume</th>
            <th data-sort="rvol_desc" class="text-right">Rel Vol</th>
            <th data-sort="market_cap_desc" class="text-right">Market Cap</th>
            <th class="text-center">Day Range (L - H)</th>
            <th data-sort="momentum" class="text-center">Momentum</th>
            <th data-sort="conviction_desc" class="text-center">Conviction</th>
            <th class="text-right">Last Monitored</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>
        <tbody id="screener-table-body">
          <!-- Populated dynamically by client-side JavaScript -->
          <tr class="loading-skeleton-row">
            <td colspan="12" class="screener-loading-cell">
              <div class="loading-pulse-box">
                <span class="loading-spinner"></span>
                <span>Connecting to live consolidated market feed...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Table Footer / Regulatory Transparency -->
    <div class="screener-table-footer">
      <div class="feed-transparency-note">
        <span class="status-indicator-mini"></span>
        <span>{dataFeedNotice}</span>
      </div>
      <div class="footer-aux-actions">
        <span id="screener-row-counter">Displaying 0 assets</span>
        <a href="https://www.tradingview.com/?aff_id=170147" target="_blank" rel="noopener noreferrer" class="tv-source-link">
          TradingView Feeds ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ configJson: JSON.stringify(SCREENER_CONFIG) }}>
  (function initLiveStockScreener() {
    const config = JSON.parse(configJson);
    let currentCategory = config.defaultCategory || 'penny';
    let currentSort = config.defaultSort || 'momentum';
    let rawStocksData = [];
    let lastSuccessTime = Date.now();
    let pollIntervalId = null;
    let clockIntervalId = null;
    let isFetching = false;

    // Filter states
    let activeFilters = {
      searchQuery: '',
      sector: 'ALL',
      minGain: 0,
      maxLoss: 0,
      minVolume: 0,
      minRvol: 0,
      minMomentum: 0,
      minConviction: 'ALL'
    };

    // DOM References
    const tableBody = document.getElementById('screener-table-body');
    const tabs = document.querySelectorAll('.screener-tab-btn');
    const searchInput = document.getElementById('screener-search-input');
    const searchClearBtn = document.getElementById('screener-search-clear');
    const sectorSelect = document.getElementById('screener-sector-select');
    const sortSelect = document.getElementById('screener-sort-select');
    const lastUpdatedEl = document.getElementById('screener-last-updated');
    const statusTextEl = document.getElementById('screener-status-text');
    const pulseDot = document.getElementById('screener-pulse-dot');
    const manualRefreshBtn = document.getElementById('screener-manual-refresh-btn');
    const countBadge = document.getElementById('screener-count-badge');
    const rowCounter = document.getElementById('screener-row-counter');
    const staleBanner = document.getElementById('screener-stale-banner');
    const staleText = document.getElementById('stale-banner-text');
    const categoryDesc = document.getElementById('category-desc');
    const filterToggleBtn = document.getElementById('screener-filter-toggle-btn');
    const advancedPanel = document.getElementById('advanced-filter-panel');
    const filterIndicator = document.getElementById('active-filter-indicator');
    const resetFiltersBtn = document.getElementById('screener-reset-filters-btn');

    // Advanced filter selectors
    const minGainSelect = document.getElementById('filter-min-gain');
    const maxLossSelect = document.getElementById('filter-max-loss');
    const minVolSelect = document.getElementById('filter-min-volume');
    const minRvolSelect = document.getElementById('filter-min-rvol');
    const minMomSelect = document.getElementById('filter-min-momentum');
    const convictionSelect = document.getElementById('filter-conviction');

    function formatNumber(num) {
      if (num === undefined || num === null || isNaN(num)) return '0';
      if (Math.abs(num) >= 1e12) return (num / 1e12).toFixed(2) + 'T';
      if (Math.abs(num) >= 1e9) return (num / 1e9).toFixed(2) + 'B';
      if (Math.abs(num) >= 1e6) return (num / 1e6).toFixed(2) + 'M';
      if (Math.abs(num) >= 1e3) return (num / 1e3).toFixed(1) + 'K';
      return num.toLocaleString();
    }

    function formatPrice(val) {
      const num = parseFloat(val);
      if (isNaN(num)) return '$0.00';
      if (num < 0.01) return '$' + num.toFixed(4);
      if (num < 1.0) return '$' + num.toFixed(3);
      return '$' + num.toFixed(2);
    }

    // Mathematical momentum scoring logic
    function calculateMomentum(changePercent, rvol, rsi, price, high, low) {
      let priceScore = 50 + (changePercent * 1.4);
      priceScore = Math.max(5, Math.min(99, priceScore));

      const rvolVal = rvol || 1.0;
      let rvolScore = 50 + ((rvolVal - 1.0) * 20);
      rvolScore = Math.max(10, Math.min(99, rvolScore));

      let techScore = 50;
      if (typeof rsi === 'number' && !isNaN(rsi)) {
        techScore = rsi;
      } else if (price && high && low && high > low) {
        techScore = ((price - low) / (high - low)) * 100;
      }
      techScore = Math.max(10, Math.min(95, techScore));

      return Math.max(1, Math.min(99, Math.round((priceScore * 0.45) + (rvolScore * 0.35) + (techScore * 0.20))));
    }

    function calculateConviction(recommendAll, momentumScore) {
      let score = 50;
      if (typeof recommendAll === 'number' && !isNaN(recommendAll)) {
        score = Math.round(((recommendAll + 1) / 2) * 100);
      } else if (momentumScore) {
        score = Math.round(momentumScore * 0.9);
      }
      score = Math.max(1, Math.min(99, score));

      let label = 'Neutral';
      if (score >= 80) label = 'High Conviction';
      else if (score >= 65) label = 'Bullish Setup';
      else if (score >= 45) label = 'Balanced Flow';
      else if (score >= 30) label = 'Bearish Pressure';
      else label = 'High Distribution';

      return { score, label };
    }

    // Fetch implementation with TradingView direct scan + Astro API proxy fallback
    async function fetchScreenerData(isManual = false) {
      if (isFetching) return;
      isFetching = true;

      if (isManual && manualRefreshBtn) {
        manualRefreshBtn.classList.add('spinning');
      }

      const categoryConf = config.categories[currentCategory] || config.categories.penny;

      // 1. Primary Route: Direct TradingView Scanner
      try {
        const filters = [
          { left: 'market_cap_basic', operation: 'nempty' },
          { left: 'type', operation: 'in_range', right: ['stock', 'dr'] },
          { left: 'subtype', operation: 'in_range', right: ['common'] }
        ];

        if (categoryConf.priceMax !== undefined) {
          filters.push({ left: 'close', operation: 'less', right: categoryConf.priceMax });
        }
        if (categoryConf.priceMin !== undefined) {
          filters.push({ left: 'close', operation: 'greater', right: categoryConf.priceMin });
        }
        if (categoryConf.marketCapMin !== undefined) {
          filters.push({ left: 'market_cap_basic', operation: 'greater', right: categoryConf.marketCapMin });
        }
        if (categoryConf.marketCapMax !== undefined) {
          filters.push({ left: 'market_cap_basic', operation: 'less', right: categoryConf.marketCapMax });
        }
        if (categoryConf.volumeFloor !== undefined) {
          filters.push({ left: 'volume', operation: 'greater', right: categoryConf.volumeFloor });
        }

        const tvRes = await fetch('https://scanner.tradingview.com/america/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            filter: filters,
            options: { lang: 'en' },
            symbols: { query: { types: [] }, tickers: [] },
            columns: [
              'name',
              'description',
              'close',
              'change_abs',
              'change',
              'volume',
              'relative_volume_10d_calc',
              'market_cap_basic',
              'high',
              'low',
              'sector',
              'Recommend.All',
              'RSI'
            ],
            sort: { sortBy: 'change', sortOrder: 'desc' },
            range: [0, 60]
          })
        });

        if (tvRes.ok) {
          const json = await tvRes.json();
          const rows = json?.data || [];
          if (rows.length > 0) {
            handleSuccessfulData(parseTradingViewRows(rows));
            return;
          }
        }
      } catch (e) {
        // Direct browser network error / Ad-block fallback
      }

      // 2. Secondary Fallback Route: Internal Astro API Proxy
      try {
        const apiRes = await fetch(`/api/screener?category=${currentCategory}`);
        if (apiRes.ok) {
          const apiJson = await apiRes.json();
          if (apiJson.success && Array.isArray(apiJson.data)) {
            handleSuccessfulData(apiJson.data);
            return;
          }
        }
      } catch (err) {
        // Network offline
      }

      // 3. Error / Stale Handler
      handleFetchFailure();
    }

    function parseTradingViewRows(rows) {
      const timeStr = new Date().toTimeString().split(' ')[0] + ' UTC';
      return rows.map((row) => {
        const d = row.d || [];
        const ticker = String(d[0] || row.s?.split(':')?.[1] || '');
        const name = String(d[1] || ticker);
        const price = typeof d[2] === 'number' ? d[2] : parseFloat(d[2]) || 0;
        const changeAbs = typeof d[3] === 'number' ? d[3] : parseFloat(d[3]) || 0;
        const changePercent = typeof d[4] === 'number' ? d[4] : parseFloat(d[4]) || 0;
        const volume = typeof d[5] === 'number' ? d[5] : parseInt(d[5], 10) || 0;
        const rvol = typeof d[6] === 'number' ? parseFloat(d[6].toFixed(2)) : 1.0;
        const marketCap = typeof d[7] === 'number' ? d[7] : parseFloat(d[7]) || 0;
        const high = typeof d[8] === 'number' ? d[8] : price;
        const low = typeof d[9] === 'number' ? d[9] : price;
        const sector = String(d[10] || 'Unclassified');
        const recommendAll = typeof d[11] === 'number' ? d[11] : 0;
        const rsi = typeof d[12] === 'number' ? d[12] : 50;

        const momentumScore = calculateMomentum(changePercent, rvol, rsi, price, high, low);
        const { score: convictionScore, label: convictionLabel } = calculateConviction(recommendAll, momentumScore);

        return {
          ticker,
          name,
          price,
          changeAbs,
          changePercent,
          volume,
          relativeVolume: rvol,
          marketCap,
          high,
          low,
          sector,
          momentumScore,
          convictionScore,
          convictionLabel,
          lastUpdatedTime: timeStr
        };
      });
    }

    function handleSuccessfulData(stocks) {
      rawStocksData = stocks;
      lastSuccessTime = Date.now();
      isFetching = false;
      if (manualRefreshBtn) manualRefreshBtn.classList.remove('spinning');

      if (staleBanner) staleBanner.style.display = 'none';
      if (pulseDot) {
        pulseDot.className = 'live-dot';
      }
      if (statusTextEl) statusTextEl.textContent = 'FEED ACTIVE';

      renderFilteredTable();
    }

    function handleFetchFailure() {
      isFetching = false;
      if (manualRefreshBtn) manualRefreshBtn.classList.remove('spinning');
      const elapsedSec = Math.floor((Date.now() - lastSuccessTime) / 1000);

      if (elapsedSec > config.staleAfterSeconds) {
        if (staleBanner) {
          staleBanner.style.display = 'flex';
          const minutes = Math.floor(elapsedSec / 60);
          if (staleText) {
            staleText.textContent = `Data delayed: Last synced ${minutes > 0 ? minutes + 'm ' : ''}${elapsedSec % 60}s ago. Market feed is reconnecting.`;
          }
        }
        if (pulseDot) pulseDot.className = 'live-dot stale';
        if (statusTextEl) statusTextEl.textContent = 'FEED DELAYED';
      }
    }

    // In-Memory Search, Multi-Filter, and Sorting Engine
    function renderFilteredTable() {
      if (!tableBody) return;

      let result = [...rawStocksData];

      // 1. Text Search Filter (Ticker or Company Name)
      const query = activeFilters.searchQuery.toLowerCase().trim();
      if (query) {
        result = result.filter(
          (s) => s.ticker.toLowerCase().includes(query) || s.name.toLowerCase().includes(query)
        );
      }

      // 2. Sector Filter
      if (activeFilters.sector !== 'ALL') {
        result = result.filter((s) => s.sector.toLowerCase().includes(activeFilters.sector.toLowerCase()));
      }

      // 3. Min Gain Filter
      if (activeFilters.minGain > 0) {
        result = result.filter((s) => s.changePercent >= activeFilters.minGain);
      }

      // 4. Decliners / Max Loss Filter
      if (activeFilters.maxLoss < 0) {
        result = result.filter((s) => s.changePercent <= activeFilters.maxLoss);
      }

      // 5. Min Volume Filter
      if (activeFilters.minVolume > 0) {
        result = result.filter((s) => s.volume >= activeFilters.minVolume);
      }

      // 6. Min RVOL Filter
      if (activeFilters.minRvol > 0) {
        result = result.filter((s) => s.relativeVolume >= activeFilters.minRvol);
      }

      // 7. Momentum Filter
      if (activeFilters.minMomentum > 0) {
        result = result.filter((s) => s.momentumScore >= activeFilters.minMomentum);
      }

      // 8. Conviction Filter
      if (activeFilters.minConviction !== 'ALL') {
        const threshold = parseInt(activeFilters.minConviction, 10);
        result = result.filter((s) => s.convictionScore >= threshold);
      }

      // 9. Sorting (Default: Best-performing / strongest momentum first)
      result.sort((a, b) => {
        switch (currentSort) {
          case 'momentum':
            return b.momentumScore - a.momentumScore || b.changePercent - a.changePercent;
          case 'change_desc':
            return b.changePercent - a.changePercent;
          case 'change_asc':
            return a.changePercent - b.changePercent;
          case 'volume_desc':
            return b.volume - a.volume;
          case 'rvol_desc':
            return b.relativeVolume - a.relativeVolume;
          case 'conviction_desc':
            return b.convictionScore - a.convictionScore;
          case 'market_cap_desc':
            return b.marketCap - a.marketCap;
          case 'price_desc':
            return b.price - a.price;
          default:
            return b.momentumScore - a.momentumScore;
        }
      });

      // Update counters
      if (countBadge) countBadge.textContent = `${result.length} of ${rawStocksData.length} stocks`;
      if (rowCounter) rowCounter.textContent = `Displaying ${result.length} active opportunities`;

      // Render Rows
      if (result.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="12" class="screener-empty-cell">
              <div class="empty-state-box">
                <p class="empty-primary">No assets matched your active filter criteria.</p>
                <p class="empty-secondary">Try widening your price range, sector, or volume floor.</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = result.map((stock) => {
        const isPos = stock.changePercent >= 0;
        const deltaClass = isPos ? 'text-gain' : 'text-loss';
        const badgeClass = isPos ? 'delta-pill-gain' : 'delta-pill-loss';
        const sign = isPos ? '+' : '';
        const tvUrl = `https://www.tradingview.com/symbols/${stock.ticker}/?aff_id=170147`;
        
        // Range bar calculation
        const rangeSpread = stock.high - stock.low;
        const rangePos = rangeSpread > 0 ? Math.min(100, Math.max(0, ((stock.price - stock.low) / rangeSpread) * 100)) : 50;

        // Momentum pill style
        let momTierClass = 'mom-high';
        if (stock.momentumScore < 50) momTierClass = 'mom-low';
        else if (stock.momentumScore < 75) momTierClass = 'mom-mid';

        // Conviction pill style
        let convTierClass = 'conv-neutral';
        if (stock.convictionScore >= 80) convTierClass = 'conv-high';
        else if (stock.convictionScore >= 65) convTierClass = 'conv-bull';

        return `
          <tr class="stock-data-row">
            <td class="cell-symbol">
              <div class="symbol-flex">
                <a href="${tvUrl}" target="_blank" rel="noopener noreferrer" class="ticker-link" title="Analyze ${stock.ticker} on TradingView">
                  $${stock.ticker}
                </a>
                <span class="company-subname" title="${stock.name}">${stock.name}</span>
              </div>
            </td>

            <td class="cell-price text-right">${formatPrice(stock.price)}</td>

            <td class="cell-change-abs text-right ${deltaClass}">
              ${sign}${formatPrice(stock.changeAbs)}
            </td>

            <td class="cell-change-pct text-right">
              <span class="delta-pill ${badgeClass}">${sign}${stock.changePercent.toFixed(2)}%</span>
            </td>

            <td class="cell-volume text-right font-mono">${formatNumber(stock.volume)}</td>

            <td class="cell-rvol text-right font-mono">
              <span class="${stock.relativeVolume >= 1.5 ? 'rvol-surge' : ''}">${stock.relativeVolume.toFixed(2)}x</span>
            </td>

            <td class="cell-market-cap text-right font-mono">${formatNumber(stock.marketCap)}</td>

            <td class="cell-range">
              <div class="range-wrapper">
                <span class="range-val">${formatPrice(stock.low)}</span>
                <div class="range-track">
                  <div class="range-marker" style="left: ${rangePos.toFixed(1)}%;"></div>
                </div>
                <span class="range-val">${formatPrice(stock.high)}</span>
              </div>
            </td>

            <td class="cell-momentum text-center">
              <div class="momentum-pill ${momTierClass}" title="Algorithmic Momentum Score: ${stock.momentumScore}/100">
                <span class="mom-score">${stock.momentumScore}</span>
                <div class="mom-bar-mini" style="width: ${stock.momentumScore}%;"></div>
              </div>
            </td>

            <td class="cell-conviction text-center">
              <span class="conviction-badge ${convTierClass}" title="${stock.convictionLabel}">
                ${stock.convictionScore} &bull; ${stock.convictionLabel}
              </span>
            </td>

            <td class="cell-time text-right font-mono text-muted">${stock.lastUpdatedTime}</td>

            <td class="cell-action text-center">
              <a href="${tvUrl}" target="_blank" rel="noopener noreferrer" class="row-chart-btn" title="Open Chart Workspace">
                Chart ↗
              </a>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Active ticking relative time updater
    function updateClockDisplay() {
      if (!lastUpdatedEl) return;
      const elapsedSec = Math.floor((Date.now() - lastSuccessTime) / 1000);

      if (elapsedSec < 5) {
        lastUpdatedEl.textContent = 'Last updated: Just now';
      } else if (elapsedSec < 60) {
        lastUpdatedEl.textContent = `Last updated: ${elapsedSec} seconds ago`;
      } else {
        const mins = Math.floor(elapsedSec / 60);
        const remSec = elapsedSec % 60;
        lastUpdatedEl.textContent = `Last updated: ${mins}m ${remSec}s ago`;
      }

      if (elapsedSec > config.staleAfterSeconds) {
        handleFetchFailure();
      }
    }

    function checkActiveFilters() {
      const hasActive = 
        activeFilters.minGain > 0 ||
        activeFilters.maxLoss < 0 ||
        activeFilters.minVolume > 0 ||
        activeFilters.minRvol > 0 ||
        activeFilters.minMomentum > 0 ||
        activeFilters.minConviction !== 'ALL';

      if (filterIndicator) {
        filterIndicator.style.display = hasActive ? 'inline-block' : 'none';
      }
    }

    // Event Bindings
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selectedCat = tab.getAttribute('data-category');
        if (!selectedCat || selectedCat === currentCategory) return;

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        currentCategory = selectedCat;
        const categoryConf = config.categories[currentCategory];
        if (categoryDesc && categoryConf) {
          categoryDesc.textContent = categoryConf.description;
        }

        // Display skeleton and fetch category
        if (tableBody) {
          tableBody.innerHTML = `
            <tr class="loading-skeleton-row">
              <td colspan="12" class="screener-loading-cell">
                <div class="loading-pulse-box">
                  <span class="loading-spinner"></span>
                  <span>Scanning ${categoryConf.name} liquidity pool...</span>
                </div>
              </td>
            </tr>
          `;
        }
        fetchScreenerData();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      activeFilters.searchQuery = e.target.value;
      if (searchClearBtn) {
        searchClearBtn.style.display = activeFilters.searchQuery ? 'block' : 'none';
      }
      renderFilteredTable();
    });

    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeFilters.searchQuery = '';
      searchClearBtn.style.display = 'none';
      renderFilteredTable();
    });

    sectorSelect?.addEventListener('change', (e) => {
      activeFilters.sector = e.target.value;
      renderFilteredTable();
    });

    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      renderFilteredTable();
    });

    // Column header sort clicking
    document.querySelectorAll('.screener-table th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const sortVal = th.getAttribute('data-sort');
        if (sortVal) {
          currentSort = sortVal;
          if (sortSelect) sortSelect.value = sortVal;
          renderFilteredTable();
        }
      });
    });

    filterToggleBtn?.addEventListener('click', () => {
      if (!advancedPanel) return;
      const isClosed = advancedPanel.style.display === 'none';
      advancedPanel.style.display = isClosed ? 'block' : 'none';
      filterToggleBtn.classList.toggle('active', isClosed);
    });

    minGainSelect?.addEventListener('change', (e) => {
      activeFilters.minGain = parseFloat(e.target.value) || 0;
      checkActiveFilters();
      renderFilteredTable();
    });

    maxLossSelect?.addEventListener('change', (e) => {
      activeFilters.maxLoss = parseFloat(e.target.value) || 0;
      checkActiveFilters();
      renderFilteredTable();
    });

    minVolSelect?.addEventListener('change', (e) => {
      activeFilters.minVolume = parseInt(e.target.value, 10) || 0;
      checkActiveFilters();
      renderFilteredTable();
    });

    minRvolSelect?.addEventListener('change', (e) => {
      activeFilters.minRvol = parseFloat(e.target.value) || 0;
      checkActiveFilters();
      renderFilteredTable();
    });

    minMomSelect?.addEventListener('change', (e) => {
      activeFilters.minMomentum = parseInt(e.target.value, 10) || 0;
      checkActiveFilters();
      renderFilteredTable();
    });

    convictionSelect?.addEventListener('change', (e) => {
      activeFilters.minConviction = e.target.value;
      checkActiveFilters();
      renderFilteredTable();
    });

    resetFiltersBtn?.addEventListener('click', () => {
      activeFilters = {
        searchQuery: '',
        sector: 'ALL',
        minGain: 0,
        maxLoss: 0,
        minVolume: 0,
        minRvol: 0,
        minMomentum: 0,
        minConviction: 'ALL'
      };
      if (searchInput) searchInput.value = '';
      if (searchClearBtn) searchClearBtn.style.display = 'none';
      if (sectorSelect) sectorSelect.value = 'ALL';
      if (minGainSelect) minGainSelect.value = '0';
      if (maxLossSelect) maxLossSelect.value = '0';
      if (minVolSelect) minVolSelect.value = '0';
      if (minRvolSelect) minRvolSelect.value = '0';
      if (minMomSelect) minMomSelect.value = '0';
      if (convictionSelect) convictionSelect.value = 'ALL';
      checkActiveFilters();
      renderFilteredTable();
    });

    manualRefreshBtn?.addEventListener('click', () => {
      fetchScreenerData(true);
    });

    // Smart Visibility Architecture: pauses polling during background tabs
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        fetchScreenerData();
      }
    });

    // Start auto-refresh loops
    fetchScreenerData();
    pollIntervalId = setInterval(() => {
      if (!document.hidden) {
        fetchScreenerData();
      }
    }, config.refreshCadenceMs);

    clockIntervalId = setInterval(updateClockDisplay, 1000);
  })();
</script>

