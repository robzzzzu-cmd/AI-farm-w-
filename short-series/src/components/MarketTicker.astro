---
// src/components/MarketTicker.astro
---

<div class="ticker-ribbon-container h-9 bg-[#090D16] border-b border-[#1E293B] text-xs font-mono tabular-nums tracking-tight" aria-label="Live Market Pulse Telemetry">
  <div class="telemetry-inner app-wrapper">
    <div class="telemetry-left">
      <div class="session-badge">
        <span class="pulse-dot"></span>
        <span class="session-text" id="market-session">US SESSION</span>
      </div>

      <span class="telemetry-divider" aria-hidden="true">|</span>

      <div class="telemetry-clock font-mono tabular-nums tracking-tight" id="utc-est-clock">
        <span id="live-clock">SYNCING CLOCK...</span>
      </div>

      <span class="telemetry-divider hide-mobile" aria-hidden="true">|</span>

      <div class="macro-regime-pill text-[#38BDF8] bg-[#38BDF8]/10 border border-[#38BDF8]/20 font-mono tabular-nums tracking-tight" id="macro-regime-badge">
        REGIME: RVOL EXPANSION
      </div>
    </div>

    <div class="tradingview-widget-container" id="tv-ticker-tape-container" aria-hidden="true">
      <div class="tradingview-widget-container__widget"></div>
    </div>

    <div class="telemetry-right">
      <a href="/#alerts" class="dispatch-trigger-link font-mono tabular-nums tracking-tight">
        ⚡ Daily 8:30 AM Pre-Market Dispatch (Free) &rarr;
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // 1. Update Market Session Status & Live UTC/EST Clock
  function updateSession() {
    const now = new Date();
    const utcHour = now.getUTCHours();
    const sessionEl = document.getElementById('market-session');
    const regimeEl = document.getElementById('macro-regime-badge');

    if (sessionEl) {
      if (utcHour >= 13 && utcHour < 21) {
        sessionEl.textContent = "US SESSION";
      } else if (utcHour >= 7 && utcHour < 13) {
        sessionEl.textContent = "EU / PRE-MKT";
      } else if (utcHour >= 0 && utcHour < 7) {
        sessionEl.textContent = "ASIA SESSION";
      } else {
        sessionEl.textContent = "AFTER-HOURS SCAN";
      }
    }

    if (regimeEl && !regimeEl.dataset.locked) {
      if (utcHour >= 13 && utcHour < 21) {
        regimeEl.textContent = "REGIME: ACTIVE RVOL SURGE";
      } else {
        regimeEl.textContent = "REGIME: HIGH DISPERSION SCAN";
      }
    }
  }

  function updateTelemetryClock() {
    const now = new Date();
    const utcStr = now.toISOString().slice(11, 19) + ' UTC';
    let estStr = '';
    try {
      const estTime = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      }).format(now);
      estStr = estTime + ' ET';
    } catch {
      estStr = '';
    }
    const label = estStr ? `${estStr} · ${utcStr}` : utcStr;
    const clockEl = document.getElementById('live-clock');
    const outerClockEl = document.getElementById('utc-est-clock');
    if (clockEl) {
      clockEl.textContent = label;
    } else if (outerClockEl) {
      outerClockEl.textContent = label;
    }
  }

  updateSession();
  updateTelemetryClock();
  setInterval(updateTelemetryClock, 1000);
  setInterval(updateSession, 60000);

  // 2. Safely Inject TradingView Ticker Tape Widget
  (function initTradingViewTicker() {
    const container = document.getElementById('tv-ticker-tape-container');
    if (!container) return;

    const activeTheme = document.documentElement.getAttribute('data-theme') || localStorage.getItem('to_theme') || 'dark';
    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    script.async = true;
    script.innerHTML = JSON.stringify({
      "symbols": [
        { "proName": "FOREXCOM:SPXUSD", "title": "S&P 500" },
        { "proName": "FOREXCOM:NSXUSD", "title": "US 100 (NASDAQ)" },
        { "proName": "FOREXCOM:DJI", "title": "Dow 30" },
        { "proName": "BINANCE:BTCUSDT", "title": "BTC/USDT" },
        { "proName": "BINANCE:ETHUSDT", "title": "ETH/USDT" }
      ],
      "showSymbolLogo": false,
      "isTransparent": true,
      "displayMode": "compact",
      "colorTheme": activeTheme === 'light' ? 'light' : 'dark',
      "locale": "en"
    });

    container.appendChild(script);
  })();
</script>

<style>
  .ticker-ribbon-container {
    display: flex;
    align-items: center;
    background: #090D16;
    border-bottom: 1px solid #1E293B;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    position: relative;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.015em;
  }

  .telemetry-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 100%;
    gap: 0.75rem;
  }

  .telemetry-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex-shrink: 0;
  }

  .session-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: #F8FAFC;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.75);
    animation: pulse 2s infinite ease-in-out;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .telemetry-divider {
    color: #1E293B;
    user-select: none;
  }

  .telemetry-clock {
    color: #94A3B8;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .macro-regime-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 600;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: nowrap;
  }

  /* Keep TradingView container in DOM for script compatibility without bloating Tier 1 height */
  .tradingview-widget-container {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .telemetry-right {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
  }

  .dispatch-trigger-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: #94A3B8;
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .dispatch-trigger-link:hover {
    color: #38BDF8;
  }

  @media (max-width: 900px) {
    .macro-regime-pill,
    .hide-mobile {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .telemetry-inner {
      padding: 0 0.75rem;
    }
    .dispatch-trigger-link {
      font-size: 0.68rem;
    }
    .telemetry-clock {
      font-size: 0.68rem;
    }
  }

  @media (max-width: 540px) {
    .dispatch-trigger-link {
      display: none;
    }
  }
</style>
