---
// src/components/MarketTicker.astro
---

<div class="ticker-ribbon-container" aria-label="Live Market Overview">
  <div class="session-badge">
    <span class="pulse-dot"></span>
    <span class="session-text" id="market-session">SYNCING...</span>
  </div>

  <div class="tradingview-widget-container" id="tv-ticker-tape-container">
    <div class="tradingview-widget-container__widget"></div>
  </div>
</div>

<script is:inline>
  // 1. Update Market Session Status
  function updateSession() {
    const now = new Date();
    const utcHour = now.getUTCHours();
    const sessionEl = document.getElementById('market-session');
    if (!sessionEl) return;

    if (utcHour >= 13 && utcHour < 21) {
      sessionEl.textContent = "US SESSION";
    } else if (utcHour >= 7 && utcHour < 15) {
      sessionEl.textContent = "EU SESSION";
    } else if (utcHour >= 0 && utcHour < 8) {
      sessionEl.textContent = "ASIA SESSION";
    } else {
      sessionEl.textContent = "OFF-HOURS SCAN";
    }
  }
  updateSession();

  // 2. Safely Inject TradingView Ticker Tape Widget
  (function initTradingViewTicker() {
    const container = document.getElementById('tv-ticker-tape-container');
    if (!container) return;

    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    script.async = true;
    script.innerHTML = JSON.stringify({
      "symbols": [
        { "proName": "FOREXCOM:SPXUSD", "title": "S&P 500" },
        { "proName": "FOREXCOM:NSXUSD", "title": "US 100 (NASDAQ)" },
        { "proName": "FOREXCOM:DJI", "title": "Dow 30" },
        { "proName": "INDEX:FTSE", "title": "FTSE 100" },
        { "proName": "INDEX:DAX", "title": "DAX 40" },
        { "proName": "INDEX:NKY", "title": "Nikkei 225" },
        { "proName": "BINANCE:BTCUSDT", "title": "BTC/USDT" },
        { "proName": "BINANCE:ETHUSDT", "title": "ETH/USDT" }
      ],
      "showSymbolLogo": true,
      "isTransparent": true,
      "displayMode": "adaptive",
      "colorTheme": "dark",
      "locale": "en"
    });

    container.appendChild(script);
  })();
</script>

<style>
  .ticker-ribbon-container {
    display: flex;
    align-items: center;
    background: #070a0f;
    border-bottom: 1px solid #1e2638;
    height: 46px;
    overflow: hidden;
  }
  .session-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #94a3b8;
    white-space: nowrap;
    padding: 0 1rem;
    height: 100%;
    border-right: 1px solid #1e2638;
    background: #0b0e14;
    z-index: 2;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.7);
    animation: pulse 2s infinite ease-in-out;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .tradingview-widget-container {
    flex: 1;
    min-width: 0;
    height: 46px;
  }
</style>
