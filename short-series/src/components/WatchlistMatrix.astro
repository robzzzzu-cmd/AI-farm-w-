---
// short-series/src/components/WatchlistMatrix.astro
---

<div class="watchlist-matrix-card" id="watchlist-matrix">
  <!-- Card Header -->
  <div class="watchlist-card-header">
    <div class="watchlist-title-col">
      <div class="watchlist-pill-badge">PORTFOLIO TELEMETRY &bull; REAL-TIME ALERTS</div>
      <h3 class="watchlist-title">Dynamic Watchlist &amp; Alert Engine</h3>
      <p class="watchlist-subtitle">
        Monitor real-time relative volume spikes (RVOL), key consolidation breaches, and live catalyst filings across your pinned symbols.
      </p>
    </div>

    <div class="watchlist-aux-controls">
      <!-- Audio Alert Toggle -->
      <button type="button" id="watchlist-sound-btn" class="aux-toggle-btn active" title="Toggle audio chimes on breakout alerts">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="sound-status-label">Chimes: ON</span>
      </button>

      <!-- Desktop Push Notifications Toggle -->
      <button type="button" id="watchlist-notify-btn" class="aux-toggle-btn" title="Enable browser notifications for breakout alerts">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span id="notify-status-label">Desktop Alerts</span>
      </button>
    </div>
  </div>

  <!-- Search & Fast-Add Toolbar -->
  <div class="watchlist-toolbar">
    <div class="watchlist-search-wrap">
      <form id="watchlist-add-form" class="watchlist-form" onsubmit="return false;">
        <div class="search-input-box">
          <svg class="search-svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="watchlist-ticker-input" 
            class="watchlist-search-field" 
            placeholder="Search &amp; add any US ticker (e.g. NVDA, TSLA, AAPL, GME)..." 
            maxlength="15" 
            autocomplete="off" 
            spellcheck="false"
          />
          <button type="button" id="search-clear-btn" class="clear-btn" style="display: none;">&times;</button>
        </div>
        <button type="submit" id="watchlist-add-btn" class="track-btn">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Track</span>
        </button>
      </form>

      <!-- Autocomplete Floating Dropdown -->
      <div id="watchlist-autocomplete" class="watchlist-autocomplete-box" style="display: none;"></div>
    </div>

    <!-- Quick Presets -->
    <div class="quick-presets-row">
      <span class="preset-title">Quick Add:</span>
      <div class="preset-buttons">
        <button type="button" class="preset-btn" data-quick-ticker="NVDA">+ NVDA</button>
        <button type="button" class="preset-btn" data-quick-ticker="AAPL">+ AAPL</button>
        <button type="button" class="preset-btn" data-quick-ticker="TSLA">+ TSLA</button>
        <button type="button" class="preset-btn" data-quick-ticker="META">+ META</button>
        <button type="button" class="preset-btn" data-quick-ticker="AMD">+ AMD</button>
        <button type="button" class="preset-btn" data-quick-ticker="MSFT">+ MSFT</button>
        <button type="button" class="preset-btn" data-quick-ticker="PLTR">+ PLTR</button>
        <button type="button" class="preset-btn" data-quick-ticker="AMZN">+ AMZN</button>
        <button type="button" class="preset-btn" data-quick-ticker="COIN">+ COIN</button>
      </div>
    </div>
  </div>

  <!-- Alert Banner Toast -->
  <div id="watchlist-alert-banner" class="watchlist-toast" style="display: none;">
    <div class="toast-left">
      <span class="toast-icon">🔔</span>
      <strong id="alert-banner-ticker">$NVDA</strong>
      <span id="alert-banner-text">Alert triggered</span>
    </div>
    <button type="button" id="alert-banner-dismiss" class="toast-close">&times;</button>
  </div>

  <!-- Watchlist Table Viewport -->
  <div class="watchlist-table-wrap">
    <table class="watchlist-table" id="watchlist-table">
      <thead>
        <tr>
          <th class="th-symbol">Symbol<span class="wl-desktop-sub"> / Company</span></th>
          <th class="th-price text-right">Price</th>
          <th class="th-delta text-center">Intraday Delta</th>
          <th class="th-rvol text-right">Rel Vol</th>
          <th class="th-signal text-center">Signal</th>
          <th class="th-triggers text-center">Alert Triggers (Click to Toggle)</th>
          <th class="th-action text-center">Action</th>
        </tr>
      </thead>
      <tbody id="watchlist-table-body">
        <tr>
          <td colspan="7" class="loading-cell">
            <div class="mini-spinner"></div>
            <span>Synchronizing live quotes...</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Card Footer -->
  <div class="watchlist-footer">
    <div class="footer-status">
      <span class="pulse-mini"></span>
      <span id="matrix-status-time">Telemetry active &bull; Live updates via exchange feed</span>
    </div>
    <span class="footer-count" id="matrix-item-count">Tracking leaders</span>
  </div>
</div>

<style>
  .watchlist-matrix-card {
    background: var(--bg-surface, #111622);
    border: 1px solid var(--border-subtle, #1e2638);
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .watchlist-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle, #1e2638);
    margin-bottom: 1rem;
  }

  .watchlist-pill-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--brand-accent, #38bdf8);
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, monospace);
  }

  .watchlist-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary, #f1f5f9);
    margin: 0;
  }

  .watchlist-subtitle {
    font-size: 0.76rem;
    color: var(--text-muted, #64748b);
    margin: 0.25rem 0 0 0;
    max-width: 600px;
    line-height: 1.4;
  }

  .watchlist-aux-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .aux-toggle-btn {
    background: var(--bg-surface-elevated, #161d2d);
    border: 1px solid var(--border-subtle, #1e2638);
    color: var(--text-secondary, #94a3b8);
    padding: 0.35rem 0.65rem;
    border-radius: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.15s ease;
  }

  .aux-toggle-btn:hover {
    color: var(--brand-accent, #38bdf8);
    border-color: var(--brand-accent, #38bdf8);
  }

  .aux-toggle-btn.active {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.4);
    color: var(--brand-accent, #38bdf8);
  }

  /* Toolbar */
  .watchlist-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .watchlist-search-wrap {
    position: relative;
    width: 100%;
  }

  .watchlist-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .search-input-box {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .search-svg {
    position: absolute;
    left: 0.75rem;
    color: var(--text-muted, #64748b);
    pointer-events: none;
  }

  .watchlist-search-field {
    width: 100%;
    background: var(--bg-surface-elevated, #161d2d);
    border: 1px solid var(--border-subtle, #1e2638);
    border-radius: 5px;
    padding: 0.45rem 1.85rem 0.45rem 2.15rem;
    color: var(--text-primary, #f1f5f9);
    font-size: 0.8rem;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .watchlist-search-field:focus {
    border-color: var(--brand-accent, #38bdf8);
  }

  .clear-btn {
    position: absolute;
    right: 0.55rem;
    background: transparent;
    border: none;
    color: var(--text-muted, #64748b);
    font-size: 1rem;
    cursor: pointer;
    padding: 0;
  }

  .clear-btn:hover { color: var(--text-primary, #f1f5f9); }

  .track-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--brand-accent, #38bdf8);
    border: 1px solid var(--brand-accent, #38bdf8);
    color: #0b0e14;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.45rem 0.95rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .track-btn:hover {
    filter: brightness(1.1);
  }

  /* Autocomplete */
  .watchlist-autocomplete-box {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--bg-surface-elevated, #161d2d);
    border: 1px solid var(--border-subtle, #1e2638);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    z-index: 100;
    max-height: 260px;
    overflow-y: auto;
  }

  /* Quick Presets Strip */
  .quick-presets-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .preset-title {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .preset-buttons {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .preset-btn {
    background: var(--bg-surface-elevated, #161d2d);
    border: 1px solid var(--border-subtle, #1e2638);
    color: var(--text-secondary, #94a3b8);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .preset-btn:hover {
    color: var(--brand-accent, #38bdf8);
    border-color: var(--brand-accent, #38bdf8);
  }

  /* Toast Banner */
  .watchlist-toast {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(234, 179, 8, 0.1);
    border-left: 3px solid #eab308;
    padding: 0.55rem 0.95rem;
    border-radius: 4px;
    margin-bottom: 0.85rem;
    font-size: 0.78rem;
    color: #fef08a;
  }

  .toast-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toast-close {
    background: transparent;
    border: none;
    color: #eab308;
    font-size: 1.1rem;
    cursor: pointer;
  }

  /* Table Viewport */
  .watchlist-table-wrap {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    border: 1px solid var(--border-subtle, #1e2638);
    border-radius: 6px;
    background: var(--bg-surface, #111622);
  }

  .watchlist-table {
    width: 100%;
    min-width: 720px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.78125rem;
    text-align: left;
  }

  .watchlist-table th {
    background: var(--bg-surface-elevated, #161d2d);
    color: var(--text-muted, #64748b);
    font-size: 0.675rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.65rem 0.65rem;
    border-bottom: 1px solid var(--border-subtle, #1e2638);
    white-space: nowrap;
    user-select: none;
  }

  .text-right { text-align: right; }
  .text-center { text-align: center; }

  /* Footer */
  .watchlist-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.725rem;
    color: var(--text-muted, #64748b);
  }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pulse-mini {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
  }

  .footer-count {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .watchlist-matrix-card {
      padding: 0.65rem 0.75rem;
    }
    /* Single-line header: Title on left, Aux toggles on right (NEXT TO EACH OTHER) */
    .watchlist-card-header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.45rem;
      margin-bottom: 0.5rem;
    }
    .watchlist-pill-badge {
      font-size: 0.58rem;
      letter-spacing: 0.04em;
    }
    .watchlist-title {
      font-size: 1.05rem;
    }
    .watchlist-subtitle {
      display: none; /* Hide bulky text on mobile */
    }
    .watchlist-aux-controls {
      width: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.35rem;
    }
    .aux-toggle-btn {
      padding: 0.25rem 0.45rem;
      font-size: 0.68rem;
    }
    .quick-presets-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .quick-presets-row::-webkit-scrollbar {
      display: none;
    }
    .preset-title {
      flex-shrink: 0;
      font-size: 0.65rem;
    }
    .preset-buttons {
      display: flex;
      flex-direction: row;
      gap: 0.25rem;
      flex-wrap: nowrap;
    }
    .preset-btn {
      flex-shrink: 0;
      padding: 0.15rem 0.4rem;
      font-size: 0.68rem;
    }
    .watchlist-search-field {
      font-size: 16px;
      padding: 0.35rem 1.6rem 0.35rem 2rem;
      height: 34px;
    }
    .track-btn {
      padding: 0.35rem 0.75rem;
      height: 34px;
      font-size: 0.75rem;
    }
    .watchlist-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.68rem;
    }
  }

  @media (max-width: 480px) {
    .watchlist-matrix-card {
      padding: 0.55rem 0.6rem;
    }
    .watchlist-title {
      font-size: 0.98rem;
    }
    .aux-toggle-btn {
      padding: 0.2rem 0.35rem;
      font-size: 0.65rem;
    }
  }
</style>

<!-- Global CSS for dynamically inserted table rows & autocomplete elements -->
<style is:global>
  /* Dynamic table cells matching LiveStockScreener design */
  .watchlist-table td {
    padding: 0.6rem 0.65rem;
    border-bottom: 1px solid var(--border-subtle, #1e2638);
    color: var(--text-secondary, #94a3b8);
    white-space: nowrap;
    vertical-align: middle;
  }

  .watchlist-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Symbol column */
  .wl-symbol-box {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 140px;
  }

  .wl-ticker-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--text-primary, #f1f5f9);
  }

  .wl-company-sub {
    font-size: 0.65rem;
    color: var(--text-muted, #64748b);
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Price */
  .wl-cell-price {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--text-primary, #f1f5f9);
  }

  /* Distinct Green / Red Delta Pills */
  .wl-delta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    min-width: 65px;
  }

  .wl-delta-gain {
    background: #0d281e !important;
    color: #22c55e !important;
    border: 1px solid rgba(34, 197, 94, 0.3) !important;
  }

  .wl-delta-loss {
    background: #2a1215 !important;
    color: #ef4444 !important;
    border: 1px solid rgba(239, 68, 68, 0.3) !important;
  }

  /* Relative volume */
  .wl-rvol-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--text-secondary, #94a3b8);
  }

  .wl-rvol-surge {
    color: #f59e0b !important;
    font-weight: 700 !important;
  }

  /* Signal badge */
  .wl-signal-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .wl-sig-breakout {
    background: rgba(168, 85, 247, 0.15) !important;
    color: #c084fc !important;
    border: 1px solid rgba(168, 85, 247, 0.35) !important;
  }

  .wl-sig-momentum {
    background: rgba(34, 197, 94, 0.15) !important;
    color: #22c55e !important;
    border: 1px solid rgba(34, 197, 94, 0.3) !important;
  }

  .wl-sig-pullback {
    background: rgba(239, 68, 68, 0.15) !important;
    color: #ef4444 !important;
    border: 1px solid rgba(239, 68, 68, 0.3) !important;
  }

  .wl-sig-neutral {
    background: var(--bg-surface-elevated, #161d2d) !important;
    color: var(--text-muted, #64748b) !important;
    border: 1px solid var(--border-subtle, #1e2638) !important;
  }

  /* Alert Trigger Pill Chips: Distinct Active / Inactive States */
  .wl-triggers-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .wl-trig-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.22rem 0.5rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.12s ease;
    user-select: none;
    line-height: 1;
    border: 1px solid var(--border-subtle, #1e2638);
    background: var(--bg-surface-elevated, #161d2d);
    color: var(--text-muted, #64748b);
    opacity: 0.65;
  }

  .wl-trig-btn:hover {
    opacity: 0.9;
    color: var(--text-primary, #f1f5f9);
    border-color: var(--border-strong, #2a3449);
  }

  /* ACTIVE STATE: Highly visible bright blue accent matching platform */
  .wl-trig-btn.active {
    background: rgba(56, 189, 248, 0.15) !important;
    color: #38bdf8 !important;
    border: 1px solid #38bdf8 !important;
    opacity: 1 !important;
    font-weight: 700 !important;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.3);
  }

  .wl-trig-icon {
    font-size: 0.68rem;
    font-weight: 800;
  }

  /* Row Actions */
  .wl-actions-group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-content: center;
  }

  .wl-why-btn {
    background: rgba(56, 189, 248, 0.12) !important;
    border: 1px solid rgba(56, 189, 248, 0.35) !important;
    color: var(--brand-accent, #38bdf8) !important;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .wl-why-btn:hover {
    background: var(--brand-accent, #38bdf8) !important;
    color: #0b0e14 !important;
  }

  .wl-remove-btn {
    background: var(--bg-surface-elevated, #161d2d) !important;
    border: 1px solid var(--border-subtle, #1e2638) !important;
    color: var(--text-muted, #64748b) !important;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .wl-remove-btn:hover {
    color: #ef4444 !important;
    border-color: rgba(239, 68, 68, 0.4) !important;
    background: rgba(239, 68, 68, 0.1) !important;
  }

  /* Autocomplete Items */
  .wl-auto-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--border-subtle, #1e2638);
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .wl-auto-row:hover {
    background: rgba(56, 189, 248, 0.1);
  }

  .wl-auto-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wl-auto-ticker {
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    font-size: 0.82rem;
    color: var(--brand-accent, #38bdf8);
  }

  .wl-auto-name {
    font-size: 0.75rem;
    color: var(--text-secondary, #94a3b8);
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wl-auto-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
  }

  .wl-auto-price {
    font-weight: 700;
    color: var(--text-primary, #f1f5f9);
  }

  /* Loading State */
  .loading-cell {
    text-align: center;
    padding: 2.25rem 1rem;
    color: var(--text-muted, #64748b);
  }

  .mini-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--border-subtle, #1e2638);
    border-top-color: var(--brand-accent, #38bdf8);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 0.5rem auto;
  }

  .wl-flash-anim {
    animation: wlFlash 1.4s ease-out;
  }
  @keyframes wlFlash {
    0% { background: rgba(56, 189, 248, 0.3) !important; }
    100% { background: transparent !important; }
  }

  @media (max-width: 768px) {
    .wl-desktop-sub {
      display: none;
    }
    .watchlist-table th.th-symbol,
    .watchlist-table td.th-symbol {
      position: sticky;
      left: 0;
      z-index: 2;
      min-width: 62px !important;
      max-width: 76px !important;
      width: 68px !important;
      padding: 0.45rem 0.3rem !important;
      background: var(--bg-surface-elevated, #161d2d);
      box-shadow: 2px 0 6px rgba(0, 0, 0, 0.4);
    }
    .watchlist-table th.th-symbol {
      z-index: 3;
    }
    .wl-symbol-box {
      min-width: 0 !important;
      width: 100%;
    }
    .wl-company-sub {
      display: none !important;
    }
    .wl-ticker-text {
      font-size: 0.78rem !important;
    }
    .watchlist-table {
      min-width: 540px !important;
    }
    .watchlist-table th,
    .watchlist-table td {
      padding: 0.45rem 0.3rem !important;
      font-size: 0.72rem;
    }
    .wl-cell-price {
      font-size: 0.75rem !important;
    }
    .th-delta,
    .watchlist-table td:nth-child(3) {
      white-space: nowrap !important;
      min-width: 72px !important;
      text-align: center !important;
    }
    .wl-delta-pill {
      min-width: 62px !important;
      width: auto !important;
      padding: 0.22rem 0.45rem !important;
      font-size: 0.74rem !important;
      line-height: 1.15 !important;
      white-space: nowrap !important;
      word-break: keep-all !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
    }
    .wl-triggers-group {
      gap: 0.2rem;
      flex-wrap: nowrap;
    }
    .wl-trig-btn {
      padding: 0.18rem 0.32rem !important;
      font-size: 0.65rem !important;
    }
    .wl-why-btn, .wl-remove-btn {
      padding: 0.18rem 0.35rem !important;
      font-size: 0.65rem !important;
    }
  }
</style>

<script is:inline>
  (function initWatchlistMatrix() {
    const STORAGE_KEY = 'to_watchlist_v3';
    const DEFAULT_LEADERS = ['NVDA', 'AAPL', 'MSFT', 'TSLA', 'META', 'AMD', 'PLTR', 'AMZN'];

    // State
    let items = [];
    let quotesData = {};
    let soundEnabled = true;
    let notificationsEnabled = false;
    const debounceMap = {};

    // DOM Elements
    const tableBody = document.getElementById('watchlist-table-body');
    const tickerInput = document.getElementById('watchlist-ticker-input');
    const searchForm = document.getElementById('watchlist-add-form');
    const clearBtn = document.getElementById('search-clear-btn');
    const autocompleteBox = document.getElementById('watchlist-autocomplete');
    const soundBtn = document.getElementById('watchlist-sound-btn');
    const soundLabel = document.getElementById('sound-status-label');
    const notifyBtn = document.getElementById('watchlist-notify-btn');
    const notifyLabel = document.getElementById('notify-status-label');
    const itemCountEl = document.getElementById('matrix-item-count');
    const alertBanner = document.getElementById('watchlist-alert-banner');
    const alertTicker = document.getElementById('alert-banner-ticker');
    const alertText = document.getElementById('alert-banner-text');
    const alertDismiss = document.getElementById('alert-banner-dismiss');

    // Web Audio Chime Generator
    function playChime() {
      if (!soundEnabled) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        
        const now = ctx.currentTime;
        const osc1 = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();

        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(587.33, now); // D5
        osc1.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5

        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(440, now);
        osc2.frequency.exponentialRampToValueAtTime(659.25, now + 0.2);

        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

        osc1.connect(gain);
        osc2.connect(gain);
        gain.connect(ctx.destination);

        osc1.start(now);
        osc2.start(now);
        osc1.stop(now + 0.45);
        osc2.stop(now + 0.45);
      } catch (e) {}
    }

    // Load Items from localStorage
    function loadSavedItems() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            items = parsed;
            return;
          }
        }
      } catch (e) {}

      // Default to premier US mega-caps
      items = DEFAULT_LEADERS.map(ticker => ({
        ticker,
        triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
      }));
      saveItems();
    }

    function saveItems() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (e) {}
      if (itemCountEl) {
        itemCountEl.textContent = `Tracking ${items.length} symbol${items.length === 1 ? '' : 's'}`;
      }
    }

    // Fetch Live Quotes from server endpoint
    async function syncQuotes() {
      if (items.length === 0) {
        renderTable();
        return;
      }

      const tickersParam = items.map(i => i.ticker).join(',');
      try {
        const res = await fetch(`/api/quotes?tickers=${encodeURIComponent(tickersParam)}`);
        if (res.ok) {
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            for (const item of json.data) {
              quotesData[item.ticker] = item;
              evaluateTriggers(item.ticker, item);
            }
            renderTable();
          }
        }
      } catch (e) {}
    }

    // Evaluate Alert Triggers
    function evaluateTriggers(ticker, data) {
      const item = items.find(i => i.ticker === ticker);
      if (!item || !item.triggers) return;

      const now = Date.now();
      const lastFired = debounceMap[ticker] || 0;
      if (now - lastFired < 15 * 60 * 1000) return; // 15m debounce

      const reasons = [];
      const trigs = item.triggers;

      if (trigs.pctMove && typeof data.changePercent === 'number' && Math.abs(data.changePercent) >= 5.0) {
        reasons.push(`${data.changePercent > 0 ? '+' : ''}${data.changePercent.toFixed(2)}% move passed ±5% threshold`);
      }
      if (trigs.rvol && typeof data.rvol === 'number' && data.rvol >= 3.0) {
        reasons.push(`RVOL crossed ${data.rvol.toFixed(2)}x (≥3.0x threshold)`);
      }
      if (trigs.breakout && data.changePercent >= 3.5 && (data.rvol || 1) >= 2.0) {
        reasons.push(`Momentum breakout breach detected`);
      }

      if (reasons.length > 0) {
        debounceMap[ticker] = now;
        playChime();

        // Flash row
        const row = document.getElementById(`wl-row-${ticker}`);
        if (row) {
          row.classList.remove('wl-flash-anim');
          void row.offsetWidth;
          row.classList.add('wl-flash-anim');
        }

        // Show toast
        if (alertBanner && alertTicker && alertText) {
          alertTicker.textContent = `$${ticker}`;
          alertText.textContent = reasons.join(' • ');
          alertBanner.style.display = 'flex';
        }

        // Desktop push notification
        if (notificationsEnabled && typeof Notification !== 'undefined' && Notification.permission === 'granted') {
          new Notification(`Breakout Alert: $${ticker}`, {
            body: reasons[0],
            icon: '/favicon.svg'
          });
        }
      }
    }

    // Render Table Rows
    function renderTable() {
      if (!tableBody) return;

      if (items.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted, #64748b);">
              Watchlist is empty. Search any ticker above (e.g. NVDA, TSLA, AAPL) or click a Quick Add chip to track.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = items.map(item => {
        const t = item.ticker;
        const q = quotesData[t] || {};
        const price = typeof q.price === 'number' 
          ? (q.price < 1 ? '$' + q.price.toFixed(4) : '$' + q.price.toFixed(2)) 
          : 'Syncing...';
        const changePercent = typeof q.changePercent === 'number' ? q.changePercent : null;
        const isPos = changePercent !== null && changePercent >= 0;
        const deltaStr = changePercent !== null ? (isPos ? '+' : '') + changePercent.toFixed(2) + '%' : '--';
        const deltaClass = changePercent !== null ? (isPos ? 'wl-delta-gain' : 'wl-delta-loss') : '';
        const rvol = typeof q.rvol === 'number' ? q.rvol.toFixed(2) + 'x' : '1.0x';
        const rvolSurge = typeof q.rvol === 'number' && q.rvol >= 2.0;
        
        let signalClass = 'wl-sig-neutral';
        let signalLabel = q.signal || 'NEUTRAL';
        if (signalLabel === 'BREAKOUT') signalClass = 'wl-sig-breakout';
        else if (signalLabel === 'MOMENTUM') signalClass = 'wl-sig-momentum';
        else if (signalLabel === 'PULLBACK' || signalLabel === 'DISTRIBUTION') signalClass = 'wl-sig-pullback';

        const name = q.name || t;
        const trigs = item.triggers || { pctMove: true, rvol: true, breakout: true, catalyst: true };

        return `
          <tr id="wl-row-${t}">
            <td class="th-symbol">
              <div class="wl-symbol-box">
                <span class="wl-ticker-text">$${t}</span>
                <span class="wl-company-sub" title="${name}">${name}</span>
              </div>
            </td>
            <td class="th-price text-right">
              <span class="wl-cell-price">${price}</span>
            </td>
            <td class="th-delta text-center">
              <span class="wl-delta-pill ${deltaClass}">${deltaStr}</span>
            </td>
            <td class="th-rvol text-right">
              <span class="wl-rvol-text ${rvolSurge ? 'wl-rvol-surge' : ''}">${rvol}</span>
            </td>
            <td class="th-signal text-center">
              <span class="wl-signal-badge ${signalClass}">${signalLabel}</span>
            </td>
            <td class="th-triggers text-center">
              <div class="wl-triggers-group">
                <button type="button" class="wl-trig-btn ${trigs.pctMove ? 'active' : ''}" data-ticker="${t}" data-trigger="pctMove" title="Toggle ±5% move alert">
                  <span class="wl-trig-icon">${trigs.pctMove ? '✓' : '○'}</span>
                  <span>&plusmn;5%</span>
                </button>
                <button type="button" class="wl-trig-btn ${trigs.rvol ? 'active' : ''}" data-ticker="${t}" data-trigger="rvol" title="Toggle 3x volume surge alert">
                  <span class="wl-trig-icon">${trigs.rvol ? '✓' : '○'}</span>
                  <span>3x Vol</span>
                </button>
                <button type="button" class="wl-trig-btn ${trigs.breakout ? 'active' : ''}" data-ticker="${t}" data-trigger="breakout" title="Toggle technical breakout alert">
                  <span class="wl-trig-icon">${trigs.breakout ? '✓' : '○'}</span>
                  <span>Breakout</span>
                </button>
                <button type="button" class="wl-trig-btn ${trigs.catalyst ? 'active' : ''}" data-ticker="${t}" data-trigger="catalyst" title="Toggle news/SEC catalyst alert">
                  <span class="wl-trig-icon">${trigs.catalyst ? '✓' : '○'}</span>
                  <span>Catalyst</span>
                </button>
              </div>
            </td>
            <td class="th-action text-center">
              <div class="wl-actions-group">
                <button type="button" class="wl-why-btn" data-open-diagnostic="${t}" title="5-Layer Why Is It Moving diagnostic">Why?</button>
                <button type="button" class="wl-remove-btn" data-remove-ticker="${t}" title="Remove $${t} from watchlist">&times;</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Add Ticker Method
    function addTicker(ticker) {
      if (!ticker) return;
      const clean = ticker.trim().toUpperCase().replace(/[^A-Z0-9.]/g, '');
      if (!clean) return;

      if (items.some(i => i.ticker === clean)) {
        // Flash existing row
        const row = document.getElementById(`wl-row-${clean}`);
        if (row) {
          row.classList.remove('wl-flash-anim');
          void row.offsetWidth;
          row.classList.add('wl-flash-anim');
          row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        return;
      }

      items.unshift({
        ticker: clean,
        triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
      });
      saveItems();
      renderTable();
      syncQuotes();
    }

    // Expose Global Helper for Screener rows
    window.__addToWatchlist = addTicker;

    // Autocomplete Search Handler
    let searchDebounce = null;
    if (tickerInput && autocompleteBox) {
      tickerInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        if (clearBtn) clearBtn.style.display = query.length > 0 ? 'inline-block' : 'none';

        clearTimeout(searchDebounce);
        if (query.length === 0) {
          autocompleteBox.style.display = 'none';
          return;
        }

        searchDebounce = setTimeout(async () => {
          try {
            const res = await fetch(`/api/quotes?search=${encodeURIComponent(query)}`);
            if (!res.ok) return;
            const json = await res.json();
            const results = json.data || [];

            if (results.length === 0) {
              autocompleteBox.innerHTML = `
                <div class="wl-auto-row" data-add-ticker="${query.toUpperCase()}">
                  <div class="wl-auto-left">
                    <span class="wl-auto-ticker">+$${query.toUpperCase()}</span>
                    <span class="wl-auto-name">Add custom symbol to watchlist</span>
                  </div>
                </div>
              `;
              autocompleteBox.style.display = 'block';
              return;
            }

            autocompleteBox.innerHTML = results.map(r => `
              <div class="wl-auto-row" data-add-ticker="${r.ticker}">
                <div class="wl-auto-left">
                  <span class="wl-auto-ticker">$${r.ticker}</span>
                  <span class="wl-auto-name">${r.name}</span>
                </div>
                <div class="wl-auto-right">
                  <span class="wl-auto-price">$${r.price < 1 ? r.price.toFixed(4) : r.price.toFixed(2)}</span>
                  <span class="wl-delta-pill ${r.changePercent >= 0 ? 'wl-delta-gain' : 'wl-delta-loss'}">${r.changePercent >= 0 ? '+' : ''}${r.changePercent.toFixed(2)}%</span>
                </div>
              </div>
            `).join('');
            autocompleteBox.style.display = 'block';
          } catch (err) {
            autocompleteBox.style.display = 'none';
          }
        }, 220);
      });

      // Close autocomplete on click outside
      document.addEventListener('click', (e) => {
        if (!autocompleteBox.contains(e.target) && e.target !== tickerInput) {
          autocompleteBox.style.display = 'none';
        }
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          tickerInput.value = '';
          clearBtn.style.display = 'none';
          autocompleteBox.style.display = 'none';
          tickerInput.focus();
        });
      }

      // Autocomplete selection
      autocompleteBox.addEventListener('click', (e) => {
        const item = e.target.closest('[data-add-ticker]');
        if (item) {
          const sym = item.getAttribute('data-add-ticker');
          if (sym) addTicker(sym);
          tickerInput.value = '';
          autocompleteBox.style.display = 'none';
          if (clearBtn) clearBtn.style.display = 'none';
        }
      });
    }

    // Form Submit
    if (searchForm && tickerInput) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const sym = tickerInput.value.trim();
        if (sym) addTicker(sym);
        tickerInput.value = '';
        if (clearBtn) clearBtn.style.display = 'none';
        if (autocompleteBox) autocompleteBox.style.display = 'none';
      });
    }

    // Quick Presets Click
    document.querySelectorAll('[data-quick-ticker]').forEach(chip => {
      chip.addEventListener('click', () => {
        const sym = chip.getAttribute('data-quick-ticker');
        if (sym) addTicker(sym);
      });
    });

    // Table Delegated Clicks: Trigger toggles & remove
    if (tableBody) {
      tableBody.addEventListener('click', (e) => {
        // Toggle trigger chip
        const trigBtn = e.target.closest('.wl-trig-btn');
        if (trigBtn) {
          const ticker = trigBtn.getAttribute('data-ticker');
          const trigger = trigBtn.getAttribute('data-trigger');
          const item = items.find(i => i.ticker === ticker);
          if (item && item.triggers && trigger) {
            item.triggers[trigger] = !item.triggers[trigger];
            const isActive = item.triggers[trigger];
            
            // Immediate visual update of class and icon
            trigBtn.classList.toggle('active', isActive);
            const iconSpan = trigBtn.querySelector('.wl-trig-icon');
            if (iconSpan) {
              iconSpan.textContent = isActive ? '✓' : '○';
            }
            saveItems();
          }
          return;
        }

        // Remove row
        const removeBtn = e.target.closest('[data-remove-ticker]');
        if (removeBtn) {
          const ticker = removeBtn.getAttribute('data-remove-ticker');
          if (ticker) {
            items = items.filter(i => i.ticker !== ticker);
            saveItems();
            renderTable();
          }
          return;
        }
      });
    }

    // Sound Toggle
    if (soundBtn && soundLabel) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        soundBtn.classList.toggle('active', soundEnabled);
        soundLabel.textContent = soundEnabled ? 'Chimes: ON' : 'Chimes: OFF';
        if (soundEnabled) playChime();
      });
    }

    // Desktop Notification Toggle
    if (notifyBtn && notifyLabel) {
      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
        notificationsEnabled = true;
        notifyBtn.classList.add('active');
        notifyLabel.textContent = 'Alerts: ACTIVE';
      }

      notifyBtn.addEventListener('click', async () => {
        if (typeof Notification === 'undefined') return;
        if (Notification.permission === 'granted') {
          notificationsEnabled = true;
          notifyBtn.classList.add('active');
          notifyLabel.textContent = 'Alerts: ACTIVE';
          return;
        }
        const permission = await Notification.requestPermission();
        if (permission === 'granted') {
          notificationsEnabled = true;
          notifyBtn.classList.add('active');
          notifyLabel.textContent = 'Alerts: ACTIVE';
          new Notification('Trade Opportunities Alerts Active', {
            body: 'Breakout triggers will notify you instantly.',
            icon: '/favicon.svg'
          });
        }
      });
    }

    // Dismiss Alert
    if (alertDismiss && alertBanner) {
      alertDismiss.addEventListener('click', () => {
        alertBanner.style.display = 'none';
      });
    }

    // Start
    loadSavedItems();
    renderTable();
    syncQuotes();
    setInterval(syncQuotes, 10000);
  })();
</script>