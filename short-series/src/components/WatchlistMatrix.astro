---
// short-series/src/components/WatchlistMatrix.astro
---

<div class="watchlist-matrix-container" id="watchlist-matrix">
  <!-- Matrix Header & Actions -->
  <div class="watchlist-header">
    <div class="watchlist-header-left">
      <div class="watchlist-title-row">
        <span class="watchlist-kicker">RETENTION ENGINE &bull; TELEMETRY MATRIX</span>
        <h3 class="watchlist-title">Dynamic Watchlist &amp; Alert Engine</h3>
      </div>
      <p class="watchlist-subtitle">
        Pin tickers to monitor real-time relative volume spikes (RVOL), consolidation breaches, and catalyst filings.
      </p>
    </div>

    <div class="watchlist-controls">
      <!-- Quick Add Form -->
      <form id="watchlist-add-form" class="watchlist-add-form" onsubmit="return false;">
        <div class="input-wrap">
          <span class="dollar-prefix">$</span>
          <input 
            type="text" 
            id="watchlist-ticker-input" 
            class="ticker-input" 
            placeholder="Add symbol (e.g. NVDA)" 
            maxlength="8" 
            autocomplete="off" 
            spellcheck="false"
          />
        </div>
        <button type="submit" id="watchlist-add-btn" class="watchlist-btn add-btn">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Track</span>
        </button>
      </form>

      <!-- Audio Alert Toggle -->
      <button id="watchlist-sound-btn" class="icon-toggle-btn active" title="Toggle Audio Chimes on Trigger" aria-label="Toggle Audio Alerts">
        <svg id="sound-icon-on" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <svg id="sound-icon-off" style="display: none;" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <span id="sound-status-label">Chimes: ON</span>
      </button>

      <!-- Browser Push Notification Permission Button -->
      <button id="watchlist-notify-btn" class="icon-toggle-btn" title="Enable Desktop Breakout Notifications" aria-label="Enable Desktop Notifications">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span id="notify-status-label">Desktop Alerts</span>
      </button>
    </div>
  </div>

  <!-- Alert Banner / Toast Container -->
  <div id="watchlist-alert-banner" class="watchlist-alert-banner" style="display: none;">
    <div class="banner-left">
      <span class="bell-pulse">🔔</span>
      <strong id="alert-banner-ticker">$NVDA</strong>
      <span id="alert-banner-text">Alert triggered: Relative Volume 3.4x exceeded 3.0x threshold</span>
    </div>
    <button id="alert-banner-dismiss" class="banner-dismiss">&times;</button>
  </div>

  <!-- Watchlist Table Matrix -->
  <div class="watchlist-table-card">
    <div class="table-responsive">
      <table class="matrix-table">
        <thead>
          <tr>
            <th class="col-symbol">Symbol</th>
            <th class="col-price text-right">Price</th>
            <th class="col-delta text-right">Intraday Delta</th>
            <th class="col-rvol text-right">RVOL</th>
            <th class="col-state text-center">Signal State</th>
            <th class="col-triggers text-center">Active Alert Triggers</th>
            <th class="col-actions text-center">Attribution</th>
          </tr>
        </thead>
        <tbody id="watchlist-table-body">
          <tr class="empty-placeholder-row">
            <td colspan="7" class="matrix-empty-cell">
              <span>Loading dynamic watchlist telemetry...</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="matrix-footer">
    <span class="matrix-status-text">
      <span class="sync-dot"></span>
      <span id="matrix-status-time">Telemetry Active &bull; Evaluating triggers in real time</span>
    </span>
    <span class="matrix-count" id="matrix-item-count">Tracking 4 symbols</span>
  </div>
</div>

<style>
  .watchlist-matrix-container {
    background: var(--bg-surface, #12141a);
    border: 1px solid var(--border-subtle, #222632);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .watchlist-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle, #222632);
  }
  .watchlist-kicker {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--brand-accent, #3b82f6);
    letter-spacing: 0.08em;
  }
  .watchlist-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary, #f3f4f6);
    letter-spacing: -0.01em;
    margin-top: 0.15rem;
  }
  .watchlist-subtitle {
    font-size: 0.78rem;
    color: var(--text-muted, #9ca3af);
    margin-top: 0.25rem;
    max-width: 580px;
    line-height: 1.4;
  }
  .watchlist-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .watchlist-add-form {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .dollar-prefix {
    position: absolute;
    left: 0.6rem;
    color: var(--text-muted, #9ca3af);
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .ticker-input {
    background: var(--bg-page, #0b0c10);
    border: 1px solid var(--border-subtle, #222632);
    border-radius: 6px;
    color: var(--text-primary, #f3f4f6);
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.45rem 0.65rem 0.45rem 1.4rem;
    width: 175px;
    text-transform: uppercase;
    transition: border-color 0.15s ease;
  }
  .ticker-input:focus {
    outline: none;
    border-color: var(--brand-accent, #3b82f6);
  }
  .watchlist-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.15s ease;
  }
  .add-btn {
    background: var(--brand-accent, #3b82f6);
    color: #ffffff;
  }
  .add-btn:hover { filter: brightness(1.1); }
  .icon-toggle-btn {
    background: var(--bg-surface-elevated, #181b22);
    border: 1px solid var(--border-subtle, #222632);
    color: var(--text-secondary, #9ca3af);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .icon-toggle-btn:hover {
    color: var(--text-primary, #f3f4f6);
    border-color: var(--border-strong, #2f3545);
  }
  .icon-toggle-btn.active {
    border-color: rgba(59, 130, 246, 0.4);
    color: var(--brand-accent, #3b82f6);
    background: rgba(59, 130, 246, 0.08);
  }
  .watchlist-alert-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid var(--brand-accent, #3b82f6);
    border-radius: 6px;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
    animation: alert-fade-in 0.3s ease;
  }
  @keyframes alert-fade-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  .banner-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--text-primary, #f3f4f6);
  }
  .bell-pulse {
    animation: bell-ring 1s infinite alternate;
  }
  @keyframes bell-ring { from { transform: rotate(-15deg); } to { transform: rotate(15deg); } }
  .banner-dismiss {
    background: transparent;
    border: none;
    color: var(--text-muted, #9ca3af);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
  }
  .watchlist-table-card {
    background: var(--bg-page, #0b0c10);
    border: 1px solid var(--border-subtle, #222632);
    border-radius: 6px;
    overflow-x: auto;
  }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    min-width: 780px;
  }
  .matrix-table th {
    background: var(--bg-surface-elevated, #181b22);
    color: var(--text-muted, #9ca3af);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border-subtle, #222632);
  }
  .matrix-table td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border-subtle, #222632);
    color: var(--text-secondary, #9ca3af);
    vertical-align: middle;
  }
  .matrix-table tbody tr {
    transition: background-color 0.15s ease;
  }
  .matrix-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .matrix-table tbody tr.row-alert-flash {
    animation: row-flash 2.5s ease-out;
  }
  @keyframes row-flash {
    0% { background: rgba(59, 130, 246, 0.35); }
    100% { background: transparent; }
  }
  .ticker-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ticker-name {
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-primary, #f3f4f6);
    font-size: 0.88rem;
  }
  .price-val {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--text-primary, #f3f4f6);
  }
  .delta-val {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
  }
  .delta-val.gain { color: var(--gain-color, #22c55e); }
  .delta-val.loss { color: var(--loss-color, #ef4444); }
  .rvol-val {
    font-family: var(--font-mono, monospace);
    font-weight: 700;
  }
  .rvol-val.surge { color: #f59e0b; font-weight: 800; }
  .signal-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .signal-badge.BREAKOUT {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .signal-badge.MOMENTUM {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
  .signal-badge.WEAKNESS {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .signal-badge.NEUTRAL {
    background: rgba(156, 163, 175, 0.12);
    color: #9ca3af;
    border: 1px solid rgba(156, 163, 175, 0.25);
  }
  .triggers-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .trigger-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    cursor: pointer;
    color: var(--text-secondary, #9ca3af);
    user-select: none;
  }
  .trigger-checkbox-label input[type="checkbox"] {
    cursor: pointer;
    accent-color: var(--brand-accent, #3b82f6);
  }
  .row-action-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }
  .why-btn {
    background: var(--bg-surface-elevated, #181b22);
    border: 1px solid var(--border-subtle, #222632);
    color: var(--brand-accent, #3b82f6);
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .why-btn:hover {
    background: var(--brand-accent, #3b82f6);
    color: #ffffff;
  }
  .remove-ticker-btn {
    background: transparent;
    border: none;
    color: var(--text-muted, #9ca3af);
    font-size: 1.15rem;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    line-height: 1;
  }
  .remove-ticker-btn:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }
  .matrix-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.72rem;
    color: var(--text-muted, #9ca3af);
  }
  .matrix-status-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
  }
</style>

<script is:inline>
  (function initWatchlistMatrix() {
    const STORAGE_KEY = 'to_watchlist_v1';
    const DEFAULT_TICKERS = ['NVDA', 'TSLA', 'AMD', 'PLTR'];
    let soundEnabled = true;
    let notificationsEnabled = false;
    let watchlistData = {};
    let debounceTimestamps = {}; // ticker -> timestamp

    // Web Audio Chime Generator
    function playChime() {
      if (!soundEnabled) return;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        const ctx = new AudioContextClass();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15); // A5
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.4);
      } catch(e) {}
    }

    // Read stored watchlist
    function loadStoredWatchlist() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch(e) {}
      return DEFAULT_TICKERS.map(t => ({
        ticker: t,
        triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
      }));
    }

    let items = loadStoredWatchlist();

    function saveWatchlist() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch(e) {}
      updateItemCount();
    }

    const tableBody = document.getElementById('watchlist-table-body');
    const itemCountEl = document.getElementById('matrix-item-count');
    const tickerInput = document.getElementById('watchlist-ticker-input');
    const soundBtn = document.getElementById('watchlist-sound-btn');
    const soundLabel = document.getElementById('sound-status-label');
    const soundIconOn = document.getElementById('sound-icon-on');
    const soundIconOff = document.getElementById('sound-icon-off');
    const notifyBtn = document.getElementById('watchlist-notify-btn');
    const notifyLabel = document.getElementById('notify-status-label');
    const alertBanner = document.getElementById('watchlist-alert-banner');
    const alertBannerTicker = document.getElementById('alert-banner-ticker');
    const alertBannerText = document.getElementById('alert-banner-text');
    const alertBannerDismiss = document.getElementById('alert-banner-dismiss');

    if (alertBannerDismiss) {
      alertBannerDismiss.addEventListener('click', () => {
        alertBanner.style.display = 'none';
      });
    }

    // Toggle Sound
    if (soundBtn) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        soundBtn.classList.toggle('active', soundEnabled);
        soundIconOn.style.display = soundEnabled ? 'inline' : 'none';
        soundIconOff.style.display = soundEnabled ? 'none' : 'inline';
        soundLabel.textContent = `Chimes: ${soundEnabled ? 'ON' : 'MUTED'}`;
        if (soundEnabled) playChime();
      });
    }

    // Notification Permission
    if (notifyBtn) {
      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
        notificationsEnabled = true;
        notifyBtn.classList.add('active');
        notifyLabel.textContent = 'Alerts: ACTIVE';
      }

      notifyBtn.addEventListener('click', async () => {
        if (typeof Notification === 'undefined') return;
        if (Notification.permission === 'granted') {
          notificationsEnabled = true;
          notifyBtn.classList.add('active');
          notifyLabel.textContent = 'Alerts: ACTIVE';
          return;
        }
        const permission = await Notification.requestPermission();
        if (permission === 'granted') {
          notificationsEnabled = true;
          notifyBtn.classList.add('active');
          notifyLabel.textContent = 'Alerts: ACTIVE';
          new Notification('Trade Opportunities Alerts Active', {
            body: 'Breakout triggers will notify you instantly.',
            icon: '/favicon.svg'
          });
        }
      });
    }

    function updateItemCount() {
      if (itemCountEl) {
        itemCountEl.textContent = `Tracking ${items.length} symbol${items.length === 1 ? '' : 's'}`;
      }
    }

    function renderRows() {
      if (!tableBody) return;
      if (items.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" class="matrix-empty-cell" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              Watchlist is empty. Add a ticker above (e.g. $NVDA, $TSLA) to monitor real-time breakout triggers.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = items.map(item => {
        const t = item.ticker;
        const d = watchlistData[t] || {};
        const price = typeof d.price === 'number' ? (d.price < 1 ? '$' + d.price.toFixed(4) : '$' + d.price.toFixed(2)) : '$--';
        const changePct = typeof d.changePercent === 'number' ? d.changePercent : null;
        const isPos = changePct !== null && changePct >= 0;
        const deltaStr = changePct !== null ? (isPos ? '+' : '') + changePct.toFixed(2) + '%' : '--';
        const deltaClass = changePct !== null ? (isPos ? 'gain' : 'loss') : '';
        const rvol = typeof d.rvol === 'number' ? d.rvol.toFixed(2) + 'x' : '1.0x';
        const rvolClass = typeof d.rvol === 'number' && d.rvol >= 2.5 ? 'surge' : '';

        // Compute Signal State
        let signal = 'NEUTRAL';
        if (changePct !== null) {
          if (changePct >= 4.0 && (d.rvol || 1) >= 2.0) signal = 'BREAKOUT';
          else if (changePct >= 2.0) signal = 'MOMENTUM';
          else if (changePct <= -2.5) signal = 'WEAKNESS';
        }

        const trigs = item.triggers || { pctMove: true, rvol: true, breakout: true, catalyst: true };

        return `
          <tr id="watchlist-row-${t}">
            <td class="col-symbol">
              <div class="ticker-cell">
                <span class="ticker-name">$${t}</span>
              </div>
            </td>
            <td class="col-price text-right">
              <span class="price-val">${price}</span>
            </td>
            <td class="col-delta text-right">
              <span class="delta-val ${deltaClass}">${deltaStr}</span>
            </td>
            <td class="col-rvol text-right">
              <span class="rvol-val ${rvolClass}">${rvol}</span>
            </td>
            <td class="col-state text-center">
              <span class="signal-badge ${signal}">${signal}</span>
            </td>
            <td class="col-triggers text-center">
              <div class="triggers-cell">
                <label class="trigger-checkbox-label" title="Alert on ±5% intraday move">
                  <input type="checkbox" data-ticker="${t}" data-trigger="pctMove" ${trigs.pctMove ? 'checked' : ''} />
                  <span>&plusmn;5%</span>
                </label>
                <label class="trigger-checkbox-label" title="Alert on RVOL ≥ 3.0x">
                  <input type="checkbox" data-ticker="${t}" data-trigger="rvol" ${trigs.rvol ? 'checked' : ''} />
                  <span>3x Vol</span>
                </label>
                <label class="trigger-checkbox-label" title="Alert on range breakout">
                  <input type="checkbox" data-ticker="${t}" data-trigger="breakout" ${trigs.breakout ? 'checked' : ''} />
                  <span>Breakout</span>
                </label>
                <label class="trigger-checkbox-label" title="Alert on SEC/News catalyst indexed">
                  <input type="checkbox" data-ticker="${t}" data-trigger="catalyst" ${trigs.catalyst ? 'checked' : ''} />
                  <span>Catalyst</span>
                </label>
              </div>
            </td>
            <td class="col-actions text-center">
              <div class="row-action-group">
                <button class="why-btn" data-open-diagnostic="${t}" title="Inspect 5-layer diagnostic for ${t}">Why?</button>
                <button class="remove-ticker-btn" data-remove-ticker="${t}" title="Remove from watchlist">&times;</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Trigger Evaluation Engine
    function evaluateTriggers(ticker, data) {
      const item = items.find(i => i.ticker === ticker);
      if (!item || !item.triggers) return;

      const now = Date.now();
      const lastTriggered = debounceTimestamps[ticker] || 0;
      if (now - lastTriggered < 15 * 60 * 1000) return; // 15m cooldown

      const reasons = [];
      const trigs = item.triggers;

      if (trigs.pctMove && typeof data.changePercent === 'number' && Math.abs(data.changePercent) >= 5.0) {
        reasons.push(`Move of ${data.changePercent > 0 ? '+' : ''}${data.changePercent.toFixed(2)}% passed ±5.0% threshold`);
      }
      if (trigs.rvol && typeof data.rvol === 'number' && data.rvol >= 3.0) {
        reasons.push(`RVOL crossed ${data.rvol.toFixed(2)}x (≥3.0x baseline)`);
      }
      if (trigs.breakout && data.changePercent >= 4.0 && (data.rvol || 1) >= 2.0) {
        reasons.push(`Momentum breakout breach detected`);
      }

      if (reasons.length > 0) {
        debounceTimestamps[ticker] = now;
        playChime();

        // Flash row
        const row = document.getElementById(`watchlist-row-${ticker}`);
        if (row) {
          row.classList.remove('row-alert-flash');
          void row.offsetWidth; // trigger reflow
          row.classList.add('row-alert-flash');
        }

        // Show banner
        if (alertBanner && alertBannerTicker && alertBannerText) {
          alertBannerTicker.textContent = `$${ticker}`;
          alertBannerText.textContent = reasons.join(' &bull; ');
          alertBanner.style.display = 'flex';
        }

        // Desktop Push
        if (notificationsEnabled && typeof Notification !== 'undefined' && Notification.permission === 'granted') {
          new Notification(`Breakout Alert: $${ticker}`, {
            body: reasons[0],
            icon: '/favicon.svg'
          });
        }
      }
    }

    // Poll live quotes for watchlisted tickers
    async function syncWatchlistQuotes() {
      if (items.length === 0) return;
      const symbols = items.map(i => i.ticker);

      try {
        const candidateTickers = symbols.flatMap(s => [s, `NASDAQ:${s}`, `NYSE:${s}`, `AMEX:${s}`]);
        const res = await fetch('https://scanner.tradingview.com/america/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            symbols: { tickers: candidateTickers },
            columns: ['name', 'close', 'change', 'relative_volume_10d_calc']
          })
        });

        if (res.ok) {
          const json = await res.json();
          const rows = json?.data || [];
          for (const s of symbols) {
            const row = rows.find(r => r.s.toUpperCase().includes(s) || r.d?.[0]?.toUpperCase() === s);
            if (row && row.d) {
              const d = row.d;
              const price = typeof d[1] === 'number' ? d[1] : parseFloat(d[1]) || 0;
              const changePercent = typeof d[2] === 'number' ? d[2] : parseFloat(d[2]) || 0;
              const rvol = typeof d[3] === 'number' ? parseFloat(d[3].toFixed(2)) : 1.0;
              
              watchlistData[s] = { price, changePercent, rvol };
              evaluateTriggers(s, watchlistData[s]);
            }
          }
          renderRows();
        }
      } catch(e) {}
    }

    // Add ticker method
    function addTicker(ticker) {
      if (!ticker) return;
      const clean = ticker.trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
      if (!clean) return;

      if (items.some(i => i.ticker === clean)) {
        // Flash existing row
        const row = document.getElementById(`watchlist-row-${clean}`);
        if (row) {
          row.classList.remove('row-alert-flash');
          void row.offsetWidth;
          row.classList.add('row-alert-flash');
        }
        return;
      }

      items.unshift({
        ticker: clean,
        triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
      });
      saveWatchlist();
      renderRows();
      syncWatchlistQuotes();
    }

    // Expose global adder
    window.__addToWatchlist = addTicker;

    // Handle form submit
    const form = document.getElementById('watchlist-add-form');
    if (form && tickerInput) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        addTicker(tickerInput.value);
        tickerInput.value = '';
      });
    }

    // Table delegate events
    if (tableBody) {
      tableBody.addEventListener('change', (e) => {
        const target = e.target;
        if (target && target.matches('input[type="checkbox"]')) {
          const ticker = target.getAttribute('data-ticker');
          const trigger = target.getAttribute('data-trigger');
          const item = items.find(i => i.ticker === ticker);
          if (item && item.triggers && trigger) {
            item.triggers[trigger] = target.checked;
            saveWatchlist();
          }
        }
      });

      tableBody.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('[data-remove-ticker]');
        if (removeBtn) {
          const ticker = removeBtn.getAttribute('data-remove-ticker');
          items = items.filter(i => i.ticker !== ticker);
          saveWatchlist();
          renderRows();
        }
      });
    }

    // Initial render and recurring sync
    renderRows();
    updateItemCount();
    syncWatchlistQuotes();
    setInterval(syncWatchlistQuotes, 8000);
  })();
</script>