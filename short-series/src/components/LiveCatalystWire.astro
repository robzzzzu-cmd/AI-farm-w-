    font-family: var(--font-sans, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    color: #F8FAFC;
    text-decoration: none;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wire-headline-link:hover {
    color: #38BDF8;
  }

  .wire-summary-text {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.7rem;
    color: #94A3B8;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
