</style>

<script is:inline>
  (function initLiveCatalystWire() {
    const COMPACT_LIMIT = 4;
    let isFetching = false;
    let activeTab = 'all';
    let activeDate = 'all';
    let isExpanded = false;

    const refreshBtn = document.getElementById('wire-refresh-btn');
    const refreshLabel = document.getElementById('wire-refresh-label');
    const lastUpdatedLabel = document.getElementById('wire-last-updated');
    const tabBtns = document.querySelectorAll('.wire-tab-btn');
    const datePillsContainer = document.getElementById('wire-date-pills');
    const expandBar = document.getElementById('wire-expand-bar');
    const expandBtn = document.getElementById('wire-expand-btn');
    const expandLabel = document.getElementById('wire-expand-label');
    const rssDetails = document.getElementById('demoted-rss-details');

    const countAll = document.getElementById('count-all');
    const countNews = document.getElementById('count-news');
    const countEarnings = document.getElementById('count-earnings');
    const countMacro = document.getElementById('count-macro');

    const allContainer = document.getElementById('wire-all-container');
    const newsContainer = document.getElementById('wire-news-container');
    const earningsContainer = document.getElementById('wire-earnings-container');
    const macroContainer = document.getElementById('wire-macro-container');

    function normalizeDateKey(rawDate) {
      if (!rawDate) return '';
      const str = String(rawDate).trim();
      const isoMatch = str.match(/^(\d{4}-\d{2}-\d{2})/);
      if (isoMatch) return isoMatch[1];
      const parsed = new Date(str);
      if (!isNaN(parsed.getTime())) {
        return parsed.toISOString().slice(0, 10);
      }
      return str;
    }

    function formatShortDateLabel(dateKey) {
      if (/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) {
        const dt = new Date(dateKey + 'T12:00:00Z');
        if (!isNaN(dt.getTime())) {
          return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
        }
      }
      return dateKey;
    }

    function getContainerForTab(tabName) {
      if (tabName === 'earnings') return earningsContainer;
      if (tabName === 'macro') return macroContainer;
      if (tabName === 'news') return newsContainer;
      return allContainer;
    }

    function applyWireFiltersAndCollapse() {
      const panels = [
        { tab: 'all', container: allContainer },
        { tab: 'earnings', container: earningsContainer },
        { tab: 'macro', container: macroContainer },
        { tab: 'news', container: newsContainer }
      ];

      panels.forEach(({ container }) => {
        if (!container) return;
        const oldEmpty = container.querySelector('.wire-date-empty');
        if (oldEmpty) oldEmpty.remove();

        const cards = Array.from(
          container.querySelectorAll(':scope > .wire-card-item, :scope > .earnings-card-item, :scope > .macro-card-item')
        );
        if (cards.length === 0) return;

        let matchIndex = 0;
        cards.forEach(card => {
          const cardDate = card.getAttribute('data-event-date') || '';
          const dateMatches = (activeDate === 'all') || (cardDate === activeDate);
          if (!dateMatches) {
            card.classList.add('wire-card-date-hidden');
            card.classList.remove('wire-card-collapsed');
          } else {
            card.classList.remove('wire-card-date-hidden');
            if (!isExpanded && matchIndex >= COMPACT_LIMIT) {
              card.classList.add('wire-card-collapsed');
            } else {
              card.classList.remove('wire-card-collapsed');
            }
            matchIndex++;
          }
        });

        if (matchIndex === 0 && activeDate !== 'all') {
          const emptyEl = document.createElement('div');
          emptyEl.className = 'wire-empty-state wire-date-empty';
          emptyEl.innerHTML = `No catalysts on <strong>${sanitize(formatShortDateLabel(activeDate))}</strong>. <button type="button" class="wire-reset-date-btn">Reset</button>`;
          const resetBtn = emptyEl.querySelector('.wire-reset-date-btn');
          if (resetBtn) {
            resetBtn.addEventListener('click', () => {
              activeDate = 'all';
              syncDatePillActiveState();
              applyWireFiltersAndCollapse();
            });
          }
          container.appendChild(emptyEl);
        }
      });

      const currentContainer = getContainerForTab(activeTab);
      if (currentContainer && expandBar && expandBtn && expandLabel) {
        const matchingCards = currentContainer.querySelectorAll(
          ':scope > .wire-card-item:not(.wire-card-date-hidden), :scope > .earnings-card-item:not(.wire-card-date-hidden), :scope > .macro-card-item:not(.wire-card-date-hidden)'
        );
        const totalMatching = matchingCards.length;
        if (totalMatching > COMPACT_LIMIT) {
          expandBar.style.display = 'flex';
          expandBtn.style.display = 'inline-flex';
          expandBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
          expandLabel.innerHTML = isExpanded
            ? `Collapse (${COMPACT_LIMIT}) &uarr;`
            : `Show All ${totalMatching} &darr;`;
        } else if (totalMatching > 0) {
          expandBar.style.display = 'flex';
          expandBtn.style.display = 'none';
        } else {
          expandBar.style.display = 'none';
        }
      }
    }

    function syncDatePillActiveState() {
      if (!datePillsContainer) return;
      const pills = datePillsContainer.querySelectorAll('.wire-date-pill');
      pills.forEach(p => {
        const d = p.getAttribute('data-wire-date');
        p.classList.toggle('active', d === activeDate);
      });
    }

    function renderDateStrip(earningsList, macroList, newsList) {
      if (!datePillsContainer) return;
      const dateCounts = new Map();

      (earningsList || []).forEach(item => {
        const key = normalizeDateKey(item.date);
        if (key) dateCounts.set(key, (dateCounts.get(key) || 0) + 1);
      });
      (macroList || []).forEach(item => {
        const key = normalizeDateKey(item.date);
        if (key) dateCounts.set(key, (dateCounts.get(key) || 0) + 1);
      });
      (newsList || []).forEach(item => {
        const key = normalizeDateKey(item.pubDate);
        if (key && dateCounts.has(key)) {
          dateCounts.set(key, (dateCounts.get(key) || 0) + 1);
        }
      });

      const sortedDates = Array.from(dateCounts.keys()).sort().slice(0, 6);
      if (activeDate !== 'all' && !sortedDates.includes(activeDate)) {
        activeDate = 'all';
      }

      const pillsHtml = [
        `<button type="button" class="wire-date-pill font-mono tabular-nums ${activeDate === 'all' ? 'active' : ''}" data-wire-date="all">All</button>`,
        ...sortedDates.map(dateKey => {
          const count = dateCounts.get(dateKey) || 0;
          const isAct = activeDate === dateKey ? 'active' : '';
          return `<button type="button" class="wire-date-pill font-mono tabular-nums ${isAct}" data-wire-date="${sanitize(dateKey)}">
            <span>${sanitize(formatShortDateLabel(dateKey))}</span>
            <span class="wire-date-pill-count">(${count})</span>
          </button>`;
        })
      ].join('');

      datePillsContainer.innerHTML = pillsHtml;

      datePillsContainer.querySelectorAll('.wire-date-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          activeDate = pill.getAttribute('data-wire-date') || 'all';
          syncDatePillActiveState();
          applyWireFiltersAndCollapse();
        });
      });
    }

    // Tab Navigation
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-wire-tab') || 'all';
        activeTab = targetTab;
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        if (targetTab === 'news' && rssDetails) {
          rssDetails.open = true;
        }

        ['all', 'earnings', 'macro'].forEach(t => {
          const panel = document.getElementById('wire-panel-' + t);
          if (panel) {
            panel.style.display = (t === targetTab) ? 'block' : 'none';
          }
        });

        applyWireFiltersAndCollapse();
      });
    });

    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        applyWireFiltersAndCollapse();
      });
    }

    function formatTimeDelta(isoString) {
      if (!isoString) return 'Now';
      try {
        const diffMs = Date.now() - new Date(isoString).getTime();
        const diffMins = Math.max(1, Math.floor(diffMs / 60000));
        if (diffMins < 60) return `${diffMins}m ago`;
        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) return `${diffHours}h ago`;
        return `${Math.floor(diffHours / 24)}d ago`;
      } catch (_) {
        return 'Recent';
      }
    }

    function decodeHtml(html) {
      if (!html) return '';
      const txt = document.createElement('textarea');
      txt.innerHTML = String(html);
      return txt.value;
    }

    function sanitize(str) {
      if (!str) return '';
      const decoded = decodeHtml(str);
      const div = document.createElement('div');
      div.textContent = decoded;
      return div.innerHTML;
    }

    const COMPANY_TICKER_MAP = [
      [/\bnvidia\b/i, 'NVDA'],
      [/\btesla\b/i, 'TSLA'],
      [/\bapple\b/i, 'AAPL'],
      [/\bmicrosoft\b/i, 'MSFT'],
      [/\bamazon\b/i, 'AMZN'],
      [/\bmeta\b|\bfacebook\b/i, 'META'],
      [/\balphabet\b|\bgoogle\b/i, 'GOOGL'],
      [/\bbroadcom\b/i, 'AVGO'],
      [/\bpalantir\b/i, 'PLTR'],
      [/\bamd\b|\badvanced micro\b/i, 'AMD'],
      [/\bintel\b/i, 'INTC'],
      [/\bmicron\b/i, 'MU'],
      [/\bsuper micro\b|\bsmci\b/i, 'SMCI'],
      [/\bnetflix\b/i, 'NFLX'],
      [/\btaiwan semi|\btsmc\b/i, 'TSM'],
      [/\bcoinbase\b/i, 'COIN'],
      [/\bmicrostrategy\b/i, 'MSTR']
    ];

    function extractTicker(title) {
      if (!title) return null;
      const cashMatch = title.match(/\$([A-Z]{1,5})\b/);
      if (cashMatch) return cashMatch[1];
      const parenMatch = title.match(/\(([A-Z]{1,5})\)/);
      if (parenMatch && !['US', 'ETF', 'CEO', 'IPO', 'SEC', 'FED', 'AI', 'IMF', 'GDP', 'CPI'].includes(parenMatch[1])) {
        return parenMatch[1];
      }
      for (const [regex, sym] of COMPANY_TICKER_MAP) {
        if (regex.test(title)) return sym;
      }
      return null;
    }

    function renderNews(news) {
      if (!newsContainer) return;
      if (!news || news.length === 0) {
        newsContainer.innerHTML = '<div class="wire-empty-state">RSS wire idle.</div>';
        if (countNews) countNews.textContent = '0';
        return;
      }
      if (countNews) countNews.textContent = String(news.length);

      const html = news.map(item => {
        const detectedTicker = (item.ticker && /^[A-Z]{1,5}$/.test(item.ticker)) ? item.ticker : extractTicker(item.title);
        const sourceLink = item.link || (detectedTicker ? `https://www.tradingview.com/symbols/${detectedTicker}/?aff_id=170147` : '/calendar/');
        const normDate = normalizeDateKey(item.pubDate);

        const tickerTagHtml = detectedTicker
          ? `<a href="/ticker/${encodeURIComponent(detectedTicker.toLowerCase())}/" class="wire-time-tag font-mono tabular-nums" style="color: #38BDF8; font-weight: 700; text-decoration: none;">$${sanitize(detectedTicker)}</a>`
          : `<span class="wire-time-tag">Wire</span>`;

        const whyBtnHtml = detectedTicker
          ? `<button type="button" class="wire-why-btn font-mono tabular-nums" data-open-diagnostic="${sanitize(detectedTicker)}">
              Why $${sanitize(detectedTicker)}?
            </button>`
          : '';

        return `
          <div class="wire-card-item" data-event-date="${sanitize(normDate)}">
            <div class="wire-meta-row">
              <span class="wire-source-tag">${sanitize(item.source || 'RSS')}</span>
              <span class="wire-time-tag font-mono tabular-nums">${formatTimeDelta(item.pubDate)}</span>
            </div>
            <a href="${sanitize(sourceLink)}" target="_blank" rel="noopener noreferrer" class="wire-headline-link">
              ${sanitize(item.title)}
            </a>
            <div class="wire-action-row">
              ${tickerTagHtml}
              <div class="wire-action-btns">
                <a href="${sanitize(sourceLink)}" target="_blank" rel="noopener noreferrer" class="wire-source-btn">Source &nearr;</a>
                ${whyBtnHtml}
              </div>
            </div>
          </div>
        `;
      }).join('');

      newsContainer.innerHTML = html;
    }

    function renderEarnings(earnings) {
      if (!earningsContainer) return;
      if (!earnings || earnings.length === 0) {
        earningsContainer.innerHTML = '<div class="wire-empty-state">No earnings scheduled in immediate window.</div>';
        if (countEarnings) countEarnings.textContent = '0';
        return;
      }
      if (countEarnings) countEarnings.textContent = String(earnings.length);

      const html = earnings.map(item => {
        const hour = item.hour ? item.hour.toLowerCase() : 'bmo';
        const timingClass = hour === 'bmo' ? 'bmo' : (hour === 'amc' ? 'amc' : 'general');
        const timingLabel = hour === 'bmo' ? 'BMO' : (hour === 'amc' ? 'AMC' : 'MKT');
        const epsEst = (item.epsEstimate !== undefined && item.epsEstimate !== null) ? `$${item.epsEstimate.toFixed(2)}` : 'N/A';
        const revEst = (item.revenueEstimate !== undefined && item.revenueEstimate !== null)
          ? (item.revenueEstimate >= 1e9 ? `$${(item.revenueEstimate / 1e9).toFixed(1)}B` : `$${(item.revenueEstimate / 1e6).toFixed(0)}M`)
          : 'N/A';
        const normDate = normalizeDateKey(item.date);

        return `
          <div class="earnings-card-item font-mono tabular-nums" data-event-date="${sanitize(normDate)}">
            <div class="earnings-header-row">
              <a href="/ticker/${encodeURIComponent(item.ticker.toLowerCase())}/" class="earnings-symbol-btn font-mono tabular-nums">
                $${sanitize(item.ticker)}
              </a>
              <span class="timing-badge ${timingClass} font-mono tabular-nums">${timingLabel} &bull; ${sanitize(item.date)}</span>
            </div>
            <div class="earnings-stats-table font-mono tabular-nums">
              <span>EPS Est: <strong>${epsEst}</strong></span>
              <span>Rev Est: <strong>${revEst}</strong></span>
              <button type="button" class="wire-why-btn font-mono tabular-nums" data-open-diagnostic="${sanitize(item.ticker)}">
                Audit &rarr;
              </button>
            </div>
          </div>
        `;
      }).join('');

      earningsContainer.innerHTML = html;
    }

    function renderMacro(events) {
      if (!macroContainer) return;
      if (!events || events.length === 0) {
        macroContainer.innerHTML = '<div class="wire-empty-state">No high-impact macro prints scheduled.</div>';
        if (countMacro) countMacro.textContent = '0';
        return;
      }
      if (countMacro) countMacro.textContent = String(events.length);

      const html = events.map(item => {
        const impact = (item.impact || 'medium').toLowerCase();
        const impactLabel = impact.toUpperCase();
        const actStr = (item.actual !== undefined && item.actual !== null) ? String(item.actual) : 'Pending';
        const estStr = (item.estimate !== undefined && item.estimate !== null) ? String(item.estimate) : '---';
        const prevStr = (item.prev !== undefined && item.prev !== null) ? String(item.prev) : '---';
        const normDate = normalizeDateKey(item.date);

        return `
          <div class="macro-card-item font-mono tabular-nums" data-event-date="${sanitize(normDate)}">
            <div class="macro-header-row">
              <span class="macro-name">${sanitize(item.event)}</span>
              <span class="macro-impact-badge ${impact} font-mono tabular-nums">${impactLabel}</span>
            </div>
            <div class="macro-stats-row font-mono tabular-nums">
              <span>Act: <strong>${actStr}</strong></span>
              <span>Est: <strong>${estStr}</strong></span>
              <span>Prev: <strong>${prevStr}</strong></span>
            </div>
            <div class="earnings-date-meta font-mono tabular-nums">
              <span>${sanitize(item.country || 'US')} &bull; ${sanitize(item.date)}</span>
            </div>
          </div>
        `;
      }).join('');

      macroContainer.innerHTML = html;
    }

    async function loadCatalysts() {
      if (isFetching) return;
      isFetching = true;

      if (refreshBtn) refreshBtn.classList.add('spinning');
      if (refreshLabel) refreshLabel.textContent = 'Syncing';

      try {
        const res = await fetch('/api/catalysts');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        if (data.success) {
          const newsList = data.breakingNews || [];
          const earningsList = data.earnings || [];
          const macroList = data.economic || [];

          renderNews(newsList);
          renderEarnings(earningsList);
          renderMacro(macroList);
          renderDateStrip(earningsList, macroList, newsList);

          const radarCount = earningsList.length + macroList.length;
          if (countAll) countAll.textContent = String(radarCount || newsList.length);

          if (allContainer) {
            const combinedHtml = [
              earningsList.length > 0 && earningsContainer ? earningsContainer.innerHTML : '',
              macroList.length > 0 && macroContainer ? macroContainer.innerHTML : ''
            ].filter(Boolean).join('');

            allContainer.innerHTML = combinedHtml || (newsContainer ? newsContainer.innerHTML : '<div class="wire-empty-state">Radar monitoring session flow.</div>');
          }

          applyWireFiltersAndCollapse();

          if (lastUpdatedLabel) {
            const now = new Date();
            lastUpdatedLabel.textContent = `Synced ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
          }
        }
      } catch (err) {
        console.warn('[LiveCatalystWire] Telemetry sync notice:', err);
      } finally {
        isFetching = false;
        if (refreshBtn) refreshBtn.classList.remove('spinning');
        if (refreshLabel) refreshLabel.textContent = 'Sync';
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', (e) => {
        e.preventDefault();
        loadCatalysts();
      });
    }

    loadCatalysts();
    setInterval(loadCatalysts, 60000);
  })();
</script>
