  }

  .earnings-symbol-btn:hover {
    color: #38BDF8;
  }

  .timing-badge {
    font-size: 0.6rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
  }

  .timing-badge.bmo {
    background: rgba(245, 158, 11, 0.1);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.2);
  }

  .timing-badge.amc {
    background: rgba(56, 189, 248, 0.1);
    color: #38BDF8;
