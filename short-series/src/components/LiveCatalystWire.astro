  }

  .wire-skeleton-card {
    background: #090D16;
    border: 1px solid #1E293B;
    border-radius: 5px;
    padding: 0.55rem;
    min-height: 54px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .skeleton-line {
    background: #1E293B;
    border-radius: 3px;
  }
  .skeleton-line.title { height: 12px; width: 70%; }
  .skeleton-line.meta { height: 10px; width: 45%; }

  .wire-empty-state {
    text-align: center;
    padding: 0.85rem 0.5rem;
    color: #94A3B8;
    font-size: 0.72rem;
  }

