---
// short-series/src/components/LiveCatalystWire.astro
// Clean, seamless market catalyst & macro calendar
// Kept internal to prevent off-site redirects
---

<section class="catalyst-wire-section" id="catalyst-wire">
  <div class="section-label">04 // Market Catalysts &bull; Earnings &amp; Macro Calendar</div>

  <div class="wire-container card">
    <div class="wire-top-bar">
      <div>
        <h3 class="wire-heading">Real-Time Catalysts &amp; Market Calendar</h3>
        <p class="wire-desc">
          Scheduled corporate earnings releases, upcoming macroeconomic prints, and real-time market catalysts with integrated 5-layer attribution.
        </p>
      </div>

      <div class="wire-controls">
        <button id="wire-refresh-btn" class="wire-refresh-btn" type="button" title="Sync live market calendar">
          <svg class="refresh-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path>
            <path d="M1 20v-6h6"></path>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span id="wire-refresh-label">Sync Calendar</span>
        </button>
      </div>
    </div>

    <!-- Tab Selector -->
    <div class="wire-tabs-bar" role="tablist">
      <button class="wire-tab-btn active" data-wire-tab="news" type="button" role="tab" aria-selected="true">
        <span>Breaking News Wire</span>
        <span class="tab-count-pill" id="count-news">--</span>
      </button>
      <button class="wire-tab-btn" data-wire-tab="earnings" type="button" role="tab" aria-selected="false">
        <span>Earnings Schedule</span>
        <span class="tab-count-pill" id="count-earnings">--</span>
      </button>
      <button class="wire-tab-btn" data-wire-tab="macro" type="button" role="tab" aria-selected="false">
        <span>Macroeconomic Prints</span>
        <span class="tab-count-pill" id="count-macro">--</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="wire-panels-wrap">
      <!-- Panel 1: News Wire -->
      <div class="wire-panel active" id="wire-panel-news" role="tabpanel">
        <div class="wire-items-grid" id="wire-news-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
            <div class="skeleton-line text"></div>
          </div>
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
            <div class="skeleton-line text"></div>
          </div>
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
            <div class="skeleton-line text"></div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Earnings Schedule -->
      <div class="wire-panel" id="wire-panel-earnings" role="tabpanel" style="display: none;">
        <div class="wire-items-grid" id="wire-earnings-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Macro Prints -->
      <div class="wire-panel" id="wire-panel-macro" role="tabpanel" style="display: none;">
        <div class="wire-items-grid" id="wire-macro-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Note -->
    <div class="wire-footer-bar">
      <div class="wire-footer-left">
        <span class="status-indicator"></span>
        <span id="wire-last-updated">Synchronized with live market stream</span>
      </div>
      <div class="wire-footer-right">
        <a href="/screener" class="screener-quick-link">
          Open Live Screener &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .catalyst-wire-section {
    margin-bottom: 2.5rem;
  }

  .wire-container.card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
    box-shadow: var(--card-shadow);
  }

  .wire-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .wire-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.3rem 0;
    letter-spacing: -0.01em;
  }

  .wire-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.45;
  }

  .wire-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wire-refresh-btn {
    background: var(--bg-surface-elevated, #161a24);
    border: 1px solid var(--border-subtle, #252c3e);
    color: var(--text-secondary, #94a3b8);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .wire-refresh-btn:hover {
    color: var(--text-primary, #ffffff);
    border-color: var(--border-strong, #3b82f6);
  }

  .wire-refresh-btn.spinning .refresh-icon {
    animation: wireSpin 0.8s linear infinite;
  }

  @keyframes wireSpin {
    100% { transform: rotate(360deg); }
  }

  /* Tabs */
  .wire-tabs-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.65rem;
    margin-bottom: 1.15rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .wire-tab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    font-size: 0.78125rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .wire-tab-btn:hover {
    color: var(--text-primary);
    background: var(--bg-surface-elevated, #181d29);
  }

  .wire-tab-btn.active {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.25);
    color: var(--brand-accent);
  }

  .tab-count-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    background: var(--bg-surface-elevated, #202636);
    color: var(--text-muted, #64748b);
    padding: 0.1rem 0.35rem;
    border-radius: 9999px;
  }

  .wire-tab-btn.active .tab-count-pill {
    background: var(--brand-accent);
    color: #ffffff;
  }

  /* Items Grid */
  .wire-items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.85rem;
  }

  /* News Card Item */
  .wire-card-item {
    background: var(--bg-surface-elevated, #141721);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .wire-card-item:hover {
    border-color: var(--border-strong, #3b82f6);
    transform: translateY(-1px);
  }

  .wire-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
    gap: 0.5rem;
  }

  .wire-source-tag {
    font-size: 0.6875rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    color: var(--brand-accent);
  }

  .wire-time-tag {
    font-size: 0.6875rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted);
  }

  .wire-headline-btn {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: left;
    background: none;
    border: none;
    padding: 0;
    margin: 0 0 0.5rem 0;
    cursor: pointer;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: inherit;
    transition: color 0.15s ease;
  }

  .wire-headline-btn:hover {
    color: var(--brand-accent);
  }

  .wire-summary-text {
    font-size: 0.78125rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .wire-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
  }

  .wire-why-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brand-accent);
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.12s ease;
    font-family: inherit;
  }

  .wire-why-btn:hover {
    background: var(--brand-accent);
    color: #ffffff;
  }

  /* Earnings Card Item */
  .earnings-card-item {
    background: var(--bg-surface-elevated, #141721);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition: border-color 0.15s ease;
  }

  .earnings-card-item:hover {
    border-color: var(--border-strong, #3b82f6);
  }

  .earnings-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .earnings-symbol-btn {
    font-size: 1.05rem;
    font-family: var(--font-mono, monospace);
    font-weight: 800;
    color: var(--text-primary);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s ease;
  }

  .earnings-symbol-btn:hover {
    color: var(--brand-accent);
  }

  .timing-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .timing-badge.bmo {
    background: rgba(234, 179, 8, 0.12);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.25);
  }

  .timing-badge.amc {
    background: rgba(99, 102, 241, 0.12);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .timing-badge.general {
    background: rgba(100, 116, 139, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(100, 116, 139, 0.25);
  }

  .earnings-stats-table {
    display: flex;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.65rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .earnings-stats-table strong {
    font-family: var(--font-mono, monospace);
    color: var(--text-primary);
  }

  .earnings-date-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted);
  }

  /* Macro Card Item */
  .macro-card-item {
    background: var(--bg-surface-elevated, #141721);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.95rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition: border-color 0.15s ease;
  }

  .macro-card-item:hover {
    border-color: var(--border-strong, #3b82f6);
  }

  .macro-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .macro-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .macro-impact-badge {
    font-size: 0.625rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .macro-impact-badge.high {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .macro-impact-badge.medium {
    background: rgba(234, 179, 8, 0.12);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.25);
  }

  .macro-impact-badge.low {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .macro-stats-row {
    display: flex;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.45rem 0.65rem;
    border-radius: 4px;
    font-size: 0.71875rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary);
  }

  .macro-stats-row strong {
    color: var(--text-primary);
  }

  /* Skeleton Loading */
  .wire-skeleton-card {
    background: var(--bg-surface-elevated, #141721);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem;
    min-height: 100px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skeleton-line {
    background: linear-gradient(90deg, #181d29 25%, #232a3b 50%, #181d29 75%);
    background-size: 200% 100%;
    animation: wireSkeleton 1.5s infinite;
    border-radius: 4px;
  }

  .skeleton-line.title { height: 16px; width: 75%; }
  .skeleton-line.meta { height: 12px; width: 40%; }
  .skeleton-line.text { height: 12px; width: 90%; }

  @keyframes wireSkeleton {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .wire-empty-state {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    grid-column: 1 / -1;
  }

  /* Footer */
  .wire-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.15rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.71875rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wire-footer-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .screener-quick-link {
    color: var(--brand-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .screener-quick-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .wire-container.card {
      padding: 1rem;
    }
    .wire-items-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function initLiveCatalystWire() {
    let isFetching = false;

    const refreshBtn = document.getElementById('wire-refresh-btn');
    const refreshLabel = document.getElementById('wire-refresh-label');
    const lastUpdatedLabel = document.getElementById('wire-last-updated');
    const tabBtns = document.querySelectorAll('.wire-tab-btn');
    const countNews = document.getElementById('count-news');
    const countEarnings = document.getElementById('count-earnings');
    const countMacro = document.getElementById('count-macro');

    const newsContainer = document.getElementById('wire-news-container');
    const earningsContainer = document.getElementById('wire-earnings-container');
    const macroContainer = document.getElementById('wire-macro-container');

    // Tab Navigation
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-wire-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        ['news', 'earnings', 'macro'].forEach(t => {
          const panel = document.getElementById('wire-panel-' + t);
          if (panel) {
            panel.style.display = (t === targetTab) ? 'block' : 'none';
          }
        });
      });
    });

    function formatTimeDelta(isoString) {
      if (!isoString) return 'Just now';
      try {
        const diffMs = Date.now() - new Date(isoString).getTime();
        const diffMins = Math.max(1, Math.floor(diffMs / 60000));
        if (diffMins < 60) return `${diffMins}m ago`;
        const diffHours = Math.floor(diffMins / 60);
        if (diffHours < 24) return `${diffHours}h ago`;
        return `${Math.floor(diffHours / 24)}d ago`;
      } catch (_) {
        return 'Recent';
      }
    }

    function sanitize(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Known common tickers to match safely without grabbing words like 'US' or 'ETF'
    function extractTicker(title) {
      if (!title) return null;
      // Check for explicit $TICKER
      const cashMatch = title.match(/\$([A-Z]{1,5})\b/);
      if (cashMatch) return cashMatch[1];

      // Check for (TICKER)
      const parenMatch = title.match(/\(([A-Z]{1,5})\)/);
      if (parenMatch && !['US', 'ETF', 'CEO', 'IPO', 'SEC', 'FED', 'AI'].includes(parenMatch[1])) {
        return parenMatch[1];
      }

      // Check for ticker before colon, e.g. "NVDA: Q3 earnings"
      const colonMatch = title.match(/\b([A-Z]{2,5}):/);
      if (colonMatch && !['NEWS', 'POST', 'LIVE'].includes(colonMatch[1])) {
        return colonMatch[1];
      }

      return null;
    }

    // Render News Wire (all clicks trigger internal diagnostic drawer, keeping users on site)
    function renderNews(news) {
      if (!newsContainer) return;
      if (!news || news.length === 0) {
        newsContainer.innerHTML = '<div class="wire-empty-state">Market wire is actively monitoring session flow.</div>';
        if (countNews) countNews.textContent = '0';
        return;
      }
      if (countNews) countNews.textContent = String(news.length);

      const html = news.map(item => {
        const detectedTicker = extractTicker(item.title);
        const diagnosticTicker = detectedTicker || 'SPY';

        return `
          <div class="wire-card-item">
            <div>
              <div class="wire-meta-row">
                <span class="wire-source-tag">${sanitize(item.source || 'Market Wire')}</span>
                <span class="wire-time-tag">${formatTimeDelta(item.pubDate)}</span>
              </div>
              <button type="button" class="wire-headline-btn" data-open-diagnostic="${sanitize(diagnosticTicker)}" title="Inspect catalyst in diagnostic drawer">
                ${sanitize(item.title)}
              </button>
              ${item.summary ? `<p class="wire-summary-text">${sanitize(item.summary)}</p>` : ''}
            </div>
            <div class="wire-action-row">
              <span class="wire-time-tag">${detectedTicker ? '$' + sanitize(detectedTicker) : 'Market Catalyst'}</span>
              <button type="button" class="wire-why-btn" data-open-diagnostic="${sanitize(diagnosticTicker)}">
                Why Is It Moving? &rarr;
              </button>
            </div>
          </div>
        `;
      }).join('');

      newsContainer.innerHTML = html;
    }

    // Render Earnings Schedule
    function renderEarnings(earnings) {
      if (!earningsContainer) return;
      if (!earnings || earnings.length === 0) {
        earningsContainer.innerHTML = '<div class="wire-empty-state">No upcoming earnings releases scheduled for this cycle.</div>';
        if (countEarnings) countEarnings.textContent = '0';
        return;
      }
      if (countEarnings) countEarnings.textContent = String(earnings.length);

      const html = earnings.map(item => {
        const hour = item.hour ? item.hour.toLowerCase() : 'bmo';
        const timingClass = hour === 'bmo' ? 'bmo' : (hour === 'amc' ? 'amc' : 'general');
        const timingLabel = hour === 'bmo' ? '☀️ Before Open' : (hour === 'amc' ? '🌙 After Close' : 'Market Hours');
        const epsEst = (item.epsEstimate !== undefined && item.epsEstimate !== null) ? `$${item.epsEstimate.toFixed(2)}` : 'N/A';
        const revEst = (item.revenueEstimate !== undefined && item.revenueEstimate !== null) 
          ? (item.revenueEstimate >= 1e9 ? `$${(item.revenueEstimate / 1e9).toFixed(1)}B` : `$${(item.revenueEstimate / 1e6).toFixed(0)}M`) 
          : 'N/A';

        return `
          <div class="earnings-card-item">
            <div class="earnings-header-row">
              <button type="button" class="earnings-symbol-btn" data-open-diagnostic="${sanitize(item.ticker)}" title="Run 5-layer diagnostic on $${sanitize(item.ticker)}">
                $${sanitize(item.ticker)}
              </button>
              <span class="timing-badge ${timingClass}">${timingLabel}</span>
            </div>
            <div class="earnings-stats-table">
              <span>EPS Est: <strong>${epsEst}</strong></span>
              <span>Rev Est: <strong>${revEst}</strong></span>
            </div>
            <div class="earnings-date-meta">
              <span>Date: ${sanitize(item.date)}</span>
              <button type="button" class="wire-why-btn" data-open-diagnostic="${sanitize(item.ticker)}">
                Inspect
              </button>
            </div>
          </div>
        `;
      }).join('');

      earningsContainer.innerHTML = html;
    }

    // Render Macroeconomic Prints
    function renderMacro(events) {
      if (!macroContainer) return;
      if (!events || events.length === 0) {
        macroContainer.innerHTML = '<div class="wire-empty-state">No high-impact economic prints scheduled in the immediate horizon.</div>';
        if (countMacro) countMacro.textContent = '0';
        return;
      }
      if (countMacro) countMacro.textContent = String(events.length);

      const html = events.map(item => {
        const impact = (item.impact || 'medium').toLowerCase();
        const impactLabel = impact.toUpperCase();
        const actStr = (item.actual !== undefined && item.actual !== null) ? String(item.actual) : 'Pending';
        const estStr = (item.estimate !== undefined && item.estimate !== null) ? String(item.estimate) : '---';
        const prevStr = (item.prev !== undefined && item.prev !== null) ? String(item.prev) : '---';

        return `
          <div class="macro-card-item">
            <div class="macro-header-row">
              <span class="macro-name">${sanitize(item.event)}</span>
              <span class="macro-impact-badge ${impact}">${impactLabel}</span>
            </div>
            <div class="macro-stats-row">
              <span>Act: <strong>${actStr}</strong></span>
              <span>Est: <strong>${estStr}</strong></span>
              <span>Prev: <strong>${prevStr}</strong></span>
            </div>
            <div class="earnings-date-meta">
              <span>${sanitize(item.country || 'US')} &bull; ${sanitize(item.date)}</span>
            </div>
          </div>
        `;
      }).join('');

      macroContainer.innerHTML = html;
    }

    // Load Data from internal SSR API
    async function loadCatalysts() {
      if (isFetching) return;
      isFetching = true;

      if (refreshBtn) refreshBtn.classList.add('spinning');
      if (refreshLabel) refreshLabel.textContent = 'Syncing...';

      try {
        const res = await fetch('/api/catalysts');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();

        if (data.success) {
          renderNews(data.breakingNews || []);
          renderEarnings(data.earnings || []);
          renderMacro(data.economic || []);

          if (lastUpdatedLabel) {
            const now = new Date();
            lastUpdatedLabel.textContent = `Market Calendar Synchronized (${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })})`;
          }
        }
      } catch (err) {
        console.warn('[LiveCatalystWire] Telemetry sync notice:', err);
      } finally {
        isFetching = false;
        if (refreshBtn) refreshBtn.classList.remove('spinning');
        if (refreshLabel) refreshLabel.textContent = 'Sync Calendar';
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', (e) => {
        e.preventDefault();
        loadCatalysts();
      });
    }

    loadCatalysts();
    setInterval(loadCatalysts, 60000);
  })();
</script>
