  /* Demoted RSS Drawer */
  .demoted-rss-drawer {
    margin-top: 0.65rem;
    border-top: 1px solid #1E293B;
    padding-top: 0.55rem;
  }

  .demoted-rss-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    font-weight: 600;
    color: #64748B;
    cursor: pointer;
    list-style: none;
    padding: 0.25rem 0.4rem;
    border-radius: 4px;
    background: #090D16;
