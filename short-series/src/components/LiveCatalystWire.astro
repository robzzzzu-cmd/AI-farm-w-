---
// short-series/src/components/LiveCatalystWire.astro
// Compact Macro & Earnings Radar + Demoted Third-Party RSS Drawer
---

<section class="catalyst-wire-section text-xs font-mono tabular-nums tracking-tight" id="catalyst-wire">
  <div class="wire-container card bg-[#111726] border border-[#1E293B] rounded-lg p-3.5">
    <div class="wire-top-bar">
      <div>
        <div class="wire-kicker font-mono tabular-nums tracking-tight">MACRO &amp; EARNINGS RADAR</div>
        <h3 class="wire-heading font-sans">Scheduled Catalysts &amp; Prints</h3>
      </div>

      <div class="wire-controls">
        <button id="wire-refresh-btn" class="wire-refresh-btn font-mono tabular-nums tracking-tight" type="button" title="Sync live market calendar">
          <svg class="refresh-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path>
            <path d="M1 20v-6h6"></path>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span id="wire-refresh-label">Sync</span>
        </button>
      </div>
    </div>

    <!-- Tab Selector (Compact Radar Tabs) -->
    <div class="wire-tabs-bar font-mono tabular-nums tracking-tight" role="tablist">
      <button class="wire-tab-btn active" data-wire-tab="all" type="button" role="tab" aria-selected="true">
        <span>Radar</span>
        <span class="tab-count-pill font-mono tabular-nums" id="count-all">--</span>
      </button>
      <button class="wire-tab-btn" data-wire-tab="earnings" type="button" role="tab" aria-selected="false">
        <span>Earnings</span>
        <span class="tab-count-pill font-mono tabular-nums" id="count-earnings">--</span>
      </button>
      <button class="wire-tab-btn" data-wire-tab="macro" type="button" role="tab" aria-selected="false">
        <span>Macro</span>
        <span class="tab-count-pill font-mono tabular-nums" id="count-macro">--</span>
      </button>
      <button class="wire-tab-btn wire-tab-demoted" data-wire-tab="news" type="button" role="tab" aria-selected="false" title="Raw Third-Party RSS Headlines">
        <span>RSS</span>
        <span class="tab-count-pill font-mono tabular-nums" id="count-news">--</span>
      </button>
    </div>

    <!-- Compact Horizontal Date-Strip Filter Bar -->
    <div class="wire-date-strip font-mono tabular-nums tracking-tight" id="wire-date-strip" aria-label="Filter calendar catalysts by date">
      <span class="wire-date-label">DATES:</span>
      <div class="wire-date-pills" id="wire-date-pills">
        <button type="button" class="wire-date-pill active font-mono tabular-nums" data-wire-date="all">All</button>
      </div>
    </div>

    <!-- Tab Panels (Compact Stacked Radar List) -->
    <div class="wire-panels-wrap">
      <!-- Panel 0: All Radar Catalysts (Earnings + Macro) -->
      <div class="wire-panel active" id="wire-panel-all" role="tabpanel">
        <div class="wire-items-grid" id="wire-all-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Earnings Schedule -->
      <div class="wire-panel" id="wire-panel-earnings" role="tabpanel" style="display: none;">
        <div class="wire-items-grid" id="wire-earnings-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Macro Prints -->
      <div class="wire-panel" id="wire-panel-macro" role="tabpanel" style="display: none;">
        <div class="wire-items-grid" id="wire-macro-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>

      <!-- Compact View Expand / Collapse Control Bar -->
      <div class="wire-expand-bar" id="wire-expand-bar" style="display: none;">
        <button type="button" class="wire-expand-btn font-mono tabular-nums" id="wire-expand-btn" aria-expanded="false">
          <span id="wire-expand-label">Show All Events &darr;</span>
        </button>
        <a href="/calendar/" class="wire-full-cal-link font-mono tabular-nums">Full Calendar &rarr;</a>
      </div>
    </div>

    <!-- Demoted Third-Party RSS News Drawer (Never competes with proprietary Gemini AI content) -->
    <details class="demoted-rss-drawer" id="demoted-rss-details">
      <summary class="demoted-rss-summary font-mono tabular-nums tracking-tight">
        <span>Third-Party Wire / Raw RSS Headlines (Yahoo &bull; WSJ &bull; CNBC)</span>
        <span class="demoted-rss-chevron">&darr;</span>
      </summary>
      <div class="wire-panel demoted-rss-panel" id="wire-panel-news" role="tabpanel">
        <div class="wire-items-grid" id="wire-news-container">
          <div class="wire-skeleton-card">
            <div class="skeleton-line title"></div>
            <div class="skeleton-line meta"></div>
          </div>
        </div>
      </div>
    </details>

    <!-- Footer Note -->
    <div class="wire-footer-bar font-mono tabular-nums tracking-tight">
      <div class="wire-footer-left">
        <span class="status-indicator"></span>
        <span id="wire-last-updated">Live calendar synced</span>
      </div>
      <div class="wire-footer-right">
        <a href="/calendar/" class="screener-quick-link">
          Calendar &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .catalyst-wire-section {
    margin-bottom: 0;
  }

  .wire-container.card {
    background: #111726;
    border: 1px solid #1E293B;
    border-radius: 0.5rem;
    padding: 0.875rem;
    box-shadow: var(--card-shadow);
  }

  .wire-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .wire-kicker {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #38BDF8;
    text-transform: uppercase;
  }

  .wire-heading {
    font-size: 0.875rem;
    font-weight: 700;
    color: #F8FAFC;
    margin: 0.1rem 0 0 0;
    letter-spacing: -0.01em;
  }

  .wire-controls {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .wire-refresh-btn {
    background: #090D16;
    border: 1px solid #1E293B;
    color: #94A3B8;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .wire-refresh-btn:hover {
    color: #F8FAFC;
    border-color: #38BDF8;
    background: #1A2234;
  }

  .wire-refresh-btn.spinning .refresh-icon {
    animation: wireSpin 0.8s linear infinite;
  }

  @keyframes wireSpin {
    100% { transform: rotate(360deg); }
