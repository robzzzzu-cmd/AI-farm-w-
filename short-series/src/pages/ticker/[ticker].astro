---
// short-series/src/pages/ticker/[ticker].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DiagnosticDrawer from '../../components/DiagnosticDrawer.astro';
import EquityExecutionCTA from '../../components/EquityExecutionCTA.astro';
import { formatMarketDate } from '../../utils/dateFormat';

export const prerender = false;

const rawParam = (Astro.params.ticker || '').trim().toUpperCase().replace(/^\$/, '');
if (!rawParam || !/^[A-Z0-9.-]{1,10}$/.test(rawParam) || /[\^#+/?&=%]/.test(rawParam)) {
  return Astro.redirect('/screener/');
}

const ticker = rawParam;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const allPosts = await getCollection('blog');
const matchingPosts: any[] = [];
let latestStats: any = null;

const sortedAllPosts = allPosts.sort((a: any, b: any) => {
  const dateA = new Date(a.data?.pubDate || a.data?.date || 0).getTime();
  const dateB = new Date(b.data?.pubDate || b.data?.date || 0).getTime();
  return dateB - dateA;
});

for (const post of sortedAllPosts) {
  const mentioned = new Set([
    ...(post.data?.tickers || []),
    ...(post.data?.leadTicker ? [post.data.leadTicker] : []),
    ...(post.data?.gainers?.map((g: any) => g.ticker) || []),
    ...(post.data?.losers?.map((l: any) => l.ticker) || []),
    ...(post.data?.active?.map((a: any) => a.ticker) || []),
  ]);

  const hasMatch = Array.from(mentioned).some(
    (t) => typeof t === 'string' && t.trim().toUpperCase().replace(/^\$/, '') === ticker
  );

  if (hasMatch) {
    matchingPosts.push(post);
    if (!latestStats) {
      const foundItem =
        post.data?.gainers?.find((g: any) => String(g.ticker).toUpperCase() === ticker) ||
        post.data?.losers?.find((l: any) => String(l.ticker).toUpperCase() === ticker) ||
        post.data?.active?.find((a: any) => String(a.ticker).toUpperCase() === ticker);
      if (foundItem) {
        latestStats = {
          price: parseFloat(foundItem.price) || 0,
          change_percentage: parseFloat(foundItem.change_percentage) || 0,
          volume: parseInt(foundItem.volume || '0', 10) || 0,
          rvol: null,
          name: ticker
        };
      }
    }
  }
}

// Fetch live market quote from TradingView scanner so ANY ticker has real-time SSR metrics
try {
  const tvRes = await fetch('https://scanner.tradingview.com/america/scan', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    },
    body: JSON.stringify({
      filter: [{ left: 'name', operation: 'equal', right: ticker }],
      columns: ['name', 'description', 'close', 'change', 'volume', 'relative_volume_10d_calc']
    })
  });
  if (tvRes.ok) {
    const tvJson = await tvRes.json();
    const row = tvJson?.data?.[0]?.d;
    if (Array.isArray(row) && row.length >= 5) {
      latestStats = {
        name: String(row[1] || ticker),
        price: typeof row[2] === 'number' ? row[2] : (latestStats?.price || 0),
        change_percentage: typeof row[3] === 'number' ? row[3] : (latestStats?.change_percentage || 0),
        volume: typeof row[4] === 'number' ? row[4] : (latestStats?.volume || 0),
        rvol: typeof row[5] === 'number' ? parseFloat(row[5].toFixed(2)) : null
      };
    }
  }
} catch (_) {}

const posts = matchingPosts;
const hasValidPrice = Boolean(latestStats && typeof latestStats.price === 'number' && latestStats.price > 0);
const companyName = latestStats?.name && latestStats.name !== ticker ? latestStats.name : `${ticker} Equity`;
const canonicalURL = new URL(`/ticker/${ticker.toLowerCase()}/`, Astro.site ?? 'https://www.tradeopportunities.trade').href;
const tvSymbolUrl = `https://www.tradingview.com/symbols/${ticker}/?aff_id=170147`;
const totalMentions = posts.length;

const tickerSchema = {
  "@context": "https://schema.org",
  "@type": "ItemPage",
  "name": `$${ticker} (${companyName}) Stock Momentum & Liquidity Scan Hub`,
  "description": `Quantitative breakout analysis, relative volume (RVOL) metrics, SEC dilution diagnostics, and market intelligence for $${ticker}.`,
  "url": canonicalURL,
  "mainEntity": {
    "@type": "FinancialProduct",
    "name": `$${ticker} - ${companyName}`,
    "tickerSymbol": ticker
  },
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": "https://www.tradeopportunities.trade"
  }
};
---

<Layout 
  title={`$${ticker} Stock Breakout Analysis, RVOL & SEC Diagnostic | Trade Opportunities`}
  description={`Live relative volume (RVOL), technical breakout profile, SEC dilution risk check, and historical momentum scans for $${ticker} (${companyName}).`}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(tickerSchema)} />
  </Fragment>

  <div class="ticker-page-wrapper">
    <!-- Breadcrumb & Header -->
    <header class="ticker-header">
      <div class="breadcrumb">
        <a href="/">Dashboard</a> &rsaquo; 
        <a href="/screener/">Live Screener</a> &rsaquo; 
        <span>${ticker}</span>
      </div>

      <div class="header-main">
        <div class="header-left">
          <div class="symbol-badge font-mono tabular-nums tracking-tight">${ticker}</div>
          <div>
            <h1>${ticker} Breakout &amp; Liquidity Hub</h1>
            <p class="header-sub" id="ticker-company-sub">
              {companyName !== `${ticker} Equity` ? `${companyName} • ` : ''}
              {totalMentions > 0 ? `Tracked across ${totalMentions} quantitative market dispatch(es)` : 'Live US Equity Momentum & Catalyst Telemetry'}
            </p>
          </div>
        </div>

        <div class="header-actions">
          <button
            type="button"
            id="ticker-open-diagnostic-btn"
            class="btn btn-primary"
            data-open-diagnostic={ticker}
            data-name={encodeURIComponent(companyName)}
            data-price={hasValidPrice ? latestStats.price : ''}
            data-change={hasValidPrice ? latestStats.change_percentage : ''}
            data-volume={hasValidPrice ? latestStats.volume : ''}
            data-rvol={latestStats?.rvol || ''}
            style="border: none; cursor: pointer; font-family: inherit;"
          >
            Why Is ${ticker} Moving? (5-Layer Diagnostic) &rarr;
          </button>
          <a href={tvSymbolUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Analyze ${ticker} on TradingView ↗
          </a>
        </div>
      </div>

      <!-- Quick Metrics Ribbon (SSR Immediate Render or Clean Skeleton Hydration) -->
      <div class="metrics-grid">
        <div class="metric-card bg-[#111726] border border-[#1E293B] rounded-lg">
          <span class="m-label font-mono">Last Observed Price</span>
          <span class="m-value font-mono tabular-nums tracking-tight" id="ticker-stat-price">
            {hasValidPrice ? (
              `$${latestStats.price < 1 ? parseFloat(latestStats.price).toFixed(4) : parseFloat(latestStats.price).toFixed(2)}`
            ) : (
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            )}
          </span>
        </div>
        <div class="metric-card bg-[#111726] border border-[#1E293B] rounded-lg">
          <span class="m-label font-mono">Intraday Delta</span>
          <span class={`m-value font-mono tabular-nums tracking-tight ${hasValidPrice ? (parseFloat(latestStats.change_percentage) >= 0 ? 'text-gain' : 'text-loss') : ''}`} id="ticker-stat-delta">
            {hasValidPrice ? (
              `${parseFloat(latestStats.change_percentage) >= 0 ? '+' : ''}${parseFloat(latestStats.change_percentage).toFixed(2)}%`
            ) : (
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            )}
          </span>
        </div>
        <div class="metric-card bg-[#111726] border border-[#1E293B] rounded-lg">
          <span class="m-label font-mono">Session Volume</span>
          <span class="m-value font-mono tabular-nums tracking-tight" id="ticker-stat-volume">
            {hasValidPrice && Number(latestStats.volume) > 0 ? (
              Number(latestStats.volume).toLocaleString()
            ) : (
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            )}
          </span>
        </div>
        <div class="metric-card bg-[#111726] border border-[#1E293B] rounded-lg">
          <span class="m-label font-mono">Relative Volume (RVOL)</span>
          <span class="m-value text-accent font-mono tabular-nums tracking-tight" id="ticker-stat-rvol">
            {latestStats?.rvol ? (
              `${latestStats.rvol}x Baseline`
            ) : (
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            )}
          </span>
        </div>
      </div>

      <!-- Above-the-Fold Equity Execution & Multi-Timeframe Charting CTA -->
      <EquityExecutionCTA symbol={ticker} dilutionRisk="LOW DILUTION" />
    </header>

    <!-- 5-Layer AI Audit & SEC Dilution 2-Column Bento Grid -->
    <section class="bento-audit-section">
      <div class="bento-section-header">
        <h2 class="section-heading" style="margin: 0;">01 // 5-Layer AI Attribution &amp; SEC Dilution Audit</h2>
        <span class="bento-live-tag font-mono tabular-nums tracking-tight">EDGAR + TAPE TELEMETRY</span>
      </div>

      <div class="bento-grid-2col grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Card 1: Synthesis Verdict & Layer 01 Catalyst Attribution -->
        <div class="bento-card bg-[#111726] border border-[#1E293B] rounded-lg p-4">
          <div class="bento-card-head">
            <span class="bento-layer-tag font-mono tabular-nums tracking-tight">LAYER 01 // CATALYST &amp; VERDICT</span>
            <span id="bento-verdict-badge" class="bento-status-pill pill-emerald font-mono tabular-nums tracking-tight">
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            </span>
          </div>
          <p id="bento-catalyst-summary" class="bento-summary-text">
            Synchronizing SEC EDGAR 8-K filings, press wires, and real-time catalyst attribution for ${ticker}...
          </p>
          <div class="bento-meta-foot">
            <span id="bento-catalyst-source" class="bento-meta-label font-mono tabular-nums tracking-tight">Source: Consolidated Exchange Wire</span>
            <button type="button" class="bento-inline-trigger font-mono" data-open-diagnostic={ticker}>Open Full Drawer &rarr;</button>
          </div>
        </div>

        <!-- Card 2: Layer 05 SEC Dilution & Offering Risk Audit -->
        <div class="bento-card bg-[#111726] border border-[#1E293B] rounded-lg p-4">
          <div class="bento-card-head">
            <span class="bento-layer-tag font-mono tabular-nums tracking-tight">LAYER 05 // SEC DILUTION &amp; SHELF RISK</span>
            <span id="bento-dilution-badge" class="bento-status-pill text-[#10B981] bg-[#10B981]/10 border border-[#10B981]/20 font-mono tabular-nums tracking-tight">
              LOW DILUTION
            </span>
          </div>
          <div class="bento-risk-row">
            <span class="bento-metric-label">Composite SEC Risk Rating</span>
            <span id="bento-risk-score" class="bento-metric-val font-mono tabular-nums tracking-tight">
              <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
            </span>
          </div>
          <div id="bento-risk-flags" class="bento-flags-box">
            <div class="bento-flag-line">Scanning S-3 shelf registrations, 424B5 ATM capacity, and listing compliance...</div>
          </div>
        </div>

        <!-- Card 3: Layer 02 Technical Structure & RVOL Pivots -->
        <div class="bento-card bg-[#111726] border border-[#1E293B] rounded-lg p-4">
          <div class="bento-card-head">
            <span class="bento-layer-tag font-mono tabular-nums tracking-tight">LAYER 02 // TECHNICAL PIVOTS &amp; RVOL</span>
            <span class="bento-sub-hint font-mono tabular-nums tracking-tight">INTRADAY TAPE</span>
          </div>
          <div class="bento-kv-grid">
            <div class="bento-kv-cell">
              <span class="bento-kv-label">Relative Volume</span>
              <span id="bento-tech-rvol" class="bento-kv-val font-mono tabular-nums tracking-tight">
                {latestStats?.rvol ? `${latestStats.rvol}x` : <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>}
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">VWAP Divergence</span>
              <span id="bento-tech-vwap" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">52W High Structure</span>
              <span id="bento-tech-52w" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">RSI (14) Momentum</span>
              <span id="bento-tech-rsi" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 4: Layer 03 & 04 Liquidity, Float Turnover & Order Flow -->
        <div class="bento-card bg-[#111726] border border-[#1E293B] rounded-lg p-4">
          <div class="bento-card-head">
            <span class="bento-layer-tag font-mono tabular-nums tracking-tight">LAYERS 03–04 // LIQUIDITY &amp; ORDER FLOW</span>
            <span id="bento-flow-bias" class="bento-sub-hint font-mono tabular-nums tracking-tight">FLOW SCAN</span>
          </div>
          <div class="bento-kv-grid">
            <div class="bento-kv-cell">
              <span class="bento-kv-label">Free Float Tier</span>
              <span id="bento-liq-float" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">Float Turnover %</span>
              <span id="bento-liq-turnover" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">Dollar Volume</span>
              <span id="bento-liq-dollar" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
            <div class="bento-kv-cell">
              <span class="bento-kv-label">Short Interest (% Float)</span>
              <span id="bento-flow-short" class="bento-kv-val font-mono tabular-nums tracking-tight">
                <span class="inline-block h-6 w-24 animate-pulse rounded bg-slate-800/80"></span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Embedded Live TradingView Chart Widget -->
    <section class="chart-section">
      <h2 class="section-heading">02 // Multi-Timeframe Technical Workspace</h2>
      <div class="tv-embed-box bg-[#111726] border border-[#1E293B] rounded-lg">
        <div class="tradingview-widget-container" id="ticker-tv-chart-container" data-symbol={ticker} style="height: 480px; width: 100%;">
          <div class="tradingview-widget-container__widget" style="height: calc(100% - 32px); width: 100%;"></div>
        </div>
      </div>
      <script is:inline>
        (function initTickerTvChart() {
          const container = document.getElementById('ticker-tv-chart-container');
          if (!container) return;
          const sym = container.getAttribute('data-symbol') || 'SPY';
          const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
          const script = document.createElement('script');
          script.type = 'text/javascript';
          script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
          script.async = true;
          script.innerHTML = JSON.stringify({
            "autosize": true,
            "symbol": sym,
            "interval": "D",
            "timezone": "Etc/UTC",
            "theme": theme,
            "style": "1",
            "locale": "en",
            "enable_publishing": false,
            "allow_symbol_change": true,
            "support_host": "https://www.tradingview.com"
          });
          container.appendChild(script);
        })();
      </script>
    </section>

    <!-- Intelligence Dispatches Timeline -->
    <section class="dispatches-section">
      <h2 class="section-heading">03 // Market Intelligence &amp; Anomaly Scans</h2>
      {posts.length > 0 ? (
        <div class="posts-list">
          {posts.map((post: any) => (
            <article class="post-item">
              <div class="post-meta">
                <time>{formatMarketDate(post.data?.pubDate || post.data?.date || post.data?.displayDate)}</time>
                <span class="pill pill-category">{post.data?.category || 'Equities'}</span>
                {post.data?.leadTicker === ticker && (
                  <span class="pill pill-lead">Lead Runner ({post.data?.leadGain || 'Breakout'})</span>
                )}
              </div>

              <h3 class="post-title">
                <a href={`/blog/${post.id.replace(/\.md$/, '').toLowerCase()}/`}>
                  {post.data?.title}
                </a>
              </h3>

              {post.data?.description && (
                <p class="post-desc">{post.data.description}</p>
              )}

              <div class="post-foot">
                <a href={`/blog/${post.id.replace(/\.md$/, '').toLowerCase()}/`} class="read-link">
                  Read Full Intelligence Dispatch &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="post-item">
          <h3 class="post-title">Live Telemetry Active for ${ticker}</h3>
          <p class="post-desc">
            <strong>${ticker}</strong> ({companyName}) is actively monitored by our real-time volume and catalyst engines. Click <strong>"Why Is ${ticker} Moving?"</strong> above to run a live 5-layer attribution scan across SEC EDGAR filings (Form 8-K, S-3 shelf registrations, 424B5 ATM offerings), news catalysts, and relative volume anomalies.
          </p>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.75rem;">
            <a href="/screener/" class="read-link">Open Live Breakout Screener &rarr;</a>
            <a href="/rvol-screener/" class="read-link">Scan Relative Volume (RVOL) &rarr;</a>
            <a href="/calendar/" class="read-link">Check Earnings &amp; Catalyst Calendar &rarr;</a>
            <a href="/dilution-risk/" class="read-link">SEC Dilution Risk Playbook &rarr;</a>
          </div>
        </div>
      )}
    </section>

    <!-- Primary Research Citation Footer -->
    <div class="research-footer">
      <p>
        <strong>Compliance &amp; Verification:</strong> Intraday price expansions and volume profiles for <strong>${ticker}</strong> are ingested via consolidated US exchange feeds and TradingView. For official corporate disclosures, prospectuses, and proxy statements, consult the <a href={`https://www.sec.gov/edgar/searchedgar/companysearch?companyName=${encodeURIComponent(ticker)}`} target="_blank" rel="noopener noreferrer">U.S. SEC EDGAR Database</a>.
      </p>
    </div>
  </div>

  <DiagnosticDrawer />

  <script is:inline define:vars={{ activeTicker: ticker }}>
    (function initTickerPageHydration() {
      const sym = (activeTicker || '').trim().toUpperCase();
      if (!sym) return;

      const openBtn = document.getElementById('ticker-open-diagnostic-btn');
      const priceEl = document.getElementById('ticker-stat-price');
      const deltaEl = document.getElementById('ticker-stat-delta');
      const volEl = document.getElementById('ticker-stat-volume');
      const rvolEl = document.getElementById('ticker-stat-rvol');

      const verdictBadgeEl = document.getElementById('bento-verdict-badge');
      const catSummaryEl = document.getElementById('bento-catalyst-summary');
      const catSourceEl = document.getElementById('bento-catalyst-source');
      const dilutionBadgeEl = document.getElementById('bento-dilution-badge');
      const riskScoreEl = document.getElementById('bento-risk-score');
      const riskFlagsEl = document.getElementById('bento-risk-flags');
      const techRvolEl = document.getElementById('bento-tech-rvol');
      const techVwapEl = document.getElementById('bento-tech-vwap');
      const tech52wEl = document.getElementById('bento-tech-52w');
      const techRsiEl = document.getElementById('bento-tech-rsi');
      const liqFloatEl = document.getElementById('bento-liq-float');
      const liqTurnoverEl = document.getElementById('bento-liq-turnover');
      const liqDollarEl = document.getElementById('bento-liq-dollar');
      const flowBiasEl = document.getElementById('bento-flow-bias');
      const flowShortEl = document.getElementById('bento-flow-short');

      async function hydrateTickerBento() {
        try {
          const params = new URLSearchParams({ ticker: sym });
          if (openBtn) {
            const p = openBtn.getAttribute('data-price');
            const c = openBtn.getAttribute('data-change');
            const v = openBtn.getAttribute('data-volume');
            const r = openBtn.getAttribute('data-rvol');
            if (p) params.append('price', p);
            if (c) params.append('change', c);
            if (v) params.append('volume', v);
            if (r) params.append('rvol', r);
          }

          const res = await fetch(`/api/diagnostic?${params.toString()}`);
          if (!res.ok) return;
          const json = await res.json();
          if (!json.success || !json.data) return;

          const d = json.data;

          // Hydrate header stats if skeleton or fresh quote available
          if (d.price && d.price > 0) {
            if (priceEl) {
              priceEl.textContent = '$' + (d.price < 1 ? d.price.toFixed(4) : d.price.toFixed(2));
            }
            if (deltaEl) {
              const isPos = d.changePercent >= 0;
              deltaEl.textContent = (isPos ? '+' : '') + d.changePercent.toFixed(2) + '%';
              deltaEl.className = 'm-value font-mono tabular-nums tracking-tight ' + (isPos ? 'text-gain' : 'text-loss');
            }
            if (openBtn) {
              openBtn.setAttribute('data-price', String(d.price));
              openBtn.setAttribute('data-change', String(d.changePercent));
              if (d.name) openBtn.setAttribute('data-name', encodeURIComponent(d.name));
            }
          }
          if (volEl && d.volume && d.volume > 0) {
            volEl.textContent = Number(d.volume).toLocaleString();
          }
          if (rvolEl && d.technical && d.technical.rvolMultiplier) {
            rvolEl.textContent = d.technical.rvolMultiplier.toFixed(2) + 'x Baseline';
          }

          // Card 1: Verdict & Catalyst
          if (verdictBadgeEl && d.synthesisVerdict) {
            verdictBadgeEl.textContent = d.synthesisVerdict;
            const isBearish = d.verdictColor === 'RED';
            verdictBadgeEl.className = 'bento-status-pill font-mono tabular-nums tracking-tight ' + (isBearish ? 'pill-rose' : 'pill-emerald');
          }
          if (catSummaryEl && d.catalyst?.summary) {
            catSummaryEl.textContent = d.catalyst.summary;
          }
          if (catSourceEl && d.catalyst?.source) {
            catSourceEl.textContent = 'Source: ' + d.catalyst.source;
          }

          // Card 2: SEC Dilution & Risk Audit
          if (d.riskRating) {
            const hasDilution = Boolean(d.riskRating.hasActiveS3Shelf || d.riskRating.overallRiskScore >= 65);
            if (dilutionBadgeEl) {
              if (hasDilution) {
                dilutionBadgeEl.textContent = 'HIGH DILUTION / ATM ACTIVE';
                dilutionBadgeEl.className = 'bento-status-pill text-[#F43F5E] bg-[#F43F5E]/10 border border-[#F43F5E]/20 font-mono tabular-nums tracking-tight';
              } else {
                dilutionBadgeEl.textContent = 'LOW DILUTION';
                dilutionBadgeEl.className = 'bento-status-pill text-[#10B981] bg-[#10B981]/10 border border-[#10B981]/20 font-mono tabular-nums tracking-tight';
              }
            }
            if (riskScoreEl) {
              riskScoreEl.textContent = `${d.riskRating.overallRiskScore}/100`;
            }
            if (riskFlagsEl) {
              if (Array.isArray(d.riskRating.flags) && d.riskRating.flags.length > 0) {
                riskFlagsEl.innerHTML = d.riskRating.flags.slice(0, 2).map(f => {
                  const icon = f.severity === 'safe' ? '✓' : '⚠';
                  return `<div class="bento-flag-line"><strong>${icon} ${f.label}:</strong> ${f.description}</div>`;
                }).join('');
              } else if (d.riskRating.hasActiveS3Shelf) {
                riskFlagsEl.innerHTML = `<div class="bento-flag-line"><strong>⚠ Active S-3 / 424B Shelf:</strong> Financing or ATM capacity registered on EDGAR. Monitor supply overhang on spikes.</div>`;
              } else {
                riskFlagsEl.innerHTML = `<div class="bento-flag-line"><strong>✓ Clean SEC Filing Structure:</strong> No active toxic S-3 ATM dilution flags detected in recent EDGAR disclosures.</div>`;
              }
            }
          }

          // Card 3: Technical Structure
          if (d.technical) {
            if (techRvolEl) techRvolEl.textContent = d.technical.rvolMultiplier.toFixed(2) + 'x';
            if (techVwapEl) {
              const vwap = d.technical.pctFromVWAP;
              techVwapEl.textContent = (vwap >= 0 ? '+' : '') + vwap.toFixed(2) + '%';
            }
            if (tech52wEl) {
              tech52wEl.textContent = d.technical.is52WeekHighBreach ? '52W High Breach' : 'Within Range';
            }
            if (techRsiEl) {
              techRsiEl.textContent = String(d.technical.rsi || 50);
            }
          }

          // Card 4: Liquidity & Order Flow
          if (d.liquidity) {
            if (liqFloatEl) liqFloatEl.textContent = d.liquidity.floatCategory.replace(/_/g, ' ');
            if (liqTurnoverEl) liqTurnoverEl.textContent = d.liquidity.floatTurnoverPct.toFixed(1) + '%';
            if (liqDollarEl) {
              const dv = d.liquidity.dollarVolume || 0;
              liqDollarEl.textContent = '$' + (dv >= 1e6 ? (dv / 1e6).toFixed(1) + 'M' : (dv >= 1e3 ? (dv / 1e3).toFixed(1) + 'K' : String(dv)));
            }
          }
          if (d.marketBehavior) {
            if (flowBiasEl) flowBiasEl.textContent = d.marketBehavior.orderFlowBias.replace(/_/g, ' ');
            if (flowShortEl) {
              flowShortEl.textContent = d.marketBehavior.shortInterestPct > 0 ? d.marketBehavior.shortInterestPct.toFixed(1) + '% Float' : 'Low / Unreported';
            }
          }
        } catch (_) {}
      }

      hydrateTickerBento();
    })();
  </script>
</Layout>

