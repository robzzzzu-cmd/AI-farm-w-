---
// short-series/src/pages/blog/[...slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => {
    const cleanId = post.id.replace(/\.md$/, '').toLowerCase();
    return {
      params: { slug: cleanId },
      props: { post, allPosts: posts },
    };
  });
}

let { post, allPosts = [] } = Astro.props;

// Fallback retrieval for case-normalized routes
if (!post) {
  const all = await getCollection('blog');
  allPosts = all;
  const currentParam = (Astro.params.slug || '').toLowerCase().replace(/\/$/, '');
  post = all.find((p) => p.id.replace(/\.md$/, '').toLowerCase() === currentParam);
}

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

// Canonical and Date normalization
const rawPubDate = post.data?.pubDate || post.data?.date;
const rawModDate = post.data?.updatedDate || rawPubDate;

const pubDateObj = rawPubDate ? new Date(rawPubDate) : new Date();
const modDateObj = rawModDate ? new Date(rawModDate) : pubDateObj;

const isoPubDate = !isNaN(pubDateObj.getTime()) ? pubDateObj.toISOString() : new Date().toISOString();
const isoModDate = !isNaN(modDateObj.getTime()) ? modDateObj.toISOString() : isoPubDate;

const displayDate = post.data?.displayDate || pubDateObj.toLocaleDateString('en-US', { dateStyle: 'long' });

const slug = post.id.replace(/\.md$/, '').toLowerCase();
const canonicalURL = new URL(`/blog/${slug}/`, Astro.site ?? 'https://tradeopportunities.trade').href;

// Dynamic Image URL
const postImage = post.data?.image && post.data.image.startsWith('http') && !post.data.image.includes('favicon.svg')
  ? post.data.image
  : `https://tradeopportunities.trade/og/${slug}.svg`;

const postCategory = post.data?.category || 'Equities';
const categorySlug = postCategory.toLowerCase().replace(/\s+/g, '-');

// Internal Linking: Find related posts
const currentSlug = slug;
const relatedPosts = allPosts
  .filter((p) => p.id.replace(/\.md$/, '').toLowerCase() !== currentSlug)
  .sort((a, b) => {
    const aTickers = a.data?.tickers || [];
    const bTickers = b.data?.tickers || [];
    const currentTickers = post.data?.tickers || [];
    const aMatch = aTickers.some((t: string) => currentTickers.includes(t)) ? 2 : 0;
    const bMatch = bTickers.some((t: string) => currentTickers.includes(t)) ? 2 : 0;

    const dateA = new Date(a.data?.pubDate || a.data?.date || 0).getTime();
    const dateB = new Date(b.data?.pubDate || b.data?.date || 0).getTime();

    return (bMatch + dateB) - (aMatch + dateA);
  })
  .slice(0, 3);

// NewsArticle JSON-LD Schema
const newsArticleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "headline": post.data?.title || "Market Intelligence Report",
  "description": post.data?.description || `Market intelligence update covering liquidity expansion in ${post.data?.leadTicker || 'momentum equities'}.`,
  "image": [postImage],
  "datePublished": isoPubDate,
  "dateModified": isoModDate,
  "author": {
    "@type": "Organization",
    "name": "Trade Opportunities Intelligence Desk",
    "url": "https://tradeopportunities.trade/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "logo": {
      "@type": "ImageObject",
      "url": "https://tradeopportunities.trade/favicon.svg"
    }
  }
};
---

<Layout 
  title={`${post.data?.title || 'Market Update'} | Trade Opportunities`}
  description={post.data?.description}
  canonicalURL={canonicalURL}
  image={postImage}
  articleDate={isoPubDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />
  </Fragment>

  <article class="article-wrapper">
    <div class="article-banner-container">
      <img 
        src={`/og/${slug}.svg`} 
        alt={post.data?.title || "Market Momentum Scan"} 
        class="article-banner-img" 
        loading="eager" 
      />
    </div>

    <header class="article-header">
      {displayDate && (
        <time datetime={isoPubDate}>{displayDate}</time>
      )}
      <h1>{post.data?.title}</h1>
      <div class="header-badges">
        <a href={`/category/${categorySlug}/`} class="pill pill-gain" title={`View all ${postCategory} updates`}>
          {postCategory} Hub &rarr;
        </a>
        <a href="/about/" class="pill pill-methodology">
          Audited Model &rarr;
        </a>
      </div>
    </header>

    <div class="risk-callout">
      <span><strong>Notice:</strong> Algorithmic market tracking for informational purposes only. Sourced via Alpha Vantage & TradingView. Not financial advice.</span>
    </div>

    <div class="article-body">
      <Content />
    </div>

    {post.data?.tickers && (
      <div class="ticker-tags">
        {post.data.tickers.map((t: string) => (
          <a href={`https://www.tradingview.com/symbols/${t}/?aff_id=170147`} target="_blank" rel="noopener noreferrer" class="ticker-pill">
            ${t}
          </a>
        ))}
      </div>
    )}

    {post.data?.refUrl && (
      <a href={post.data.refUrl} target="_blank" rel="noopener noreferrer" class="card-action-btn">
        {post.data.refLabel || "Access Liquidity Terminal"} &rarr;
      </a>
    )}

    <div class="eeat-box">
      <div class="eeat-header">
        <span class="eeat-badge">Verified Model</span>
        <span class="eeat-title">Quantitative Model Architecture</span>
      </div>
      <p class="eeat-desc">
        This dispatch was compiled programmatically via the <strong>Trade Opportunities Anomaly Engine</strong> utilizing tier-1 data ingestion from Alpha Vantage and verified against a 50,000 share minimum session liquidity filter. Review our complete <a href="/about/">Quantitative Methodology & Verification Guidelines</a>.
      </p>
      <div class="eeat-sources">
        <span>Primary Verification Sources:</span>
        <a href="https://www.sec.gov/edgar/searchedgar/companysearch" target="_blank" rel="noopener noreferrer">SEC EDGAR ↗</a>
        <a href="https://www.tradingview.com/?aff_id=170147" target="_blank" rel="noopener noreferrer">TradingView Feeds ↗</a>
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <section class="related-intel-section">
        <h3 class="related-intel-title">Related Market Opportunities</h3>
        <div class="related-intel-grid">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.id.replace(/\.md$/, '').toLowerCase()}/`} class="related-card">
              <span class="related-date">
                {related.data?.displayDate || (related.data?.date ? new Date(related.data.date).toISOString().slice(0, 10) : 'Recent')}
              </span>
              <span class="related-title">{related.data?.title}</span>
              {related.data?.leadTicker && (
                <span class="related-lead">${related.data.leadTicker} ({related.data?.leadGain || 'Breakout'})</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="article-footer-disclaimer">
      <p>
        <strong>Risk Disclosure:</strong> Securities, equities, and crypto trading involve substantial financial risk. Past results are not indicative of future performance.
      </p>
    </footer>
  </article>

  <script is:inline>
    (function() {
      const tables = document.querySelectorAll('.article-body table');
      tables.forEach(table => {
        if (!table.parentElement.classList.contains('article-table-scroll')) {
          const wrap = document.createElement('div');
          wrap.className = 'article-table-scroll';
          table.parentNode.insertBefore(wrap, table);
          wrap.appendChild(table);
        }
      });
    })();
  </script>
</Layout>

<style is:global>
  .article-wrapper {
    max-width: 820px;
    margin: 2rem auto 4rem auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }
  .article-banner-container {
    width: 100%;
    margin-bottom: 1.75rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface-elevated);
    box-shadow: var(--card-shadow);
  }
  .article-banner-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1200 / 630;
  }
  .article-header time {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono, monospace);
    margin-bottom: 0.5rem;
  }
  .article-header h1 {
    font-size: 2.1rem;
    font-weight: 800;
    margin: 0 0 0.85rem 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .header-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .pill-gain {
    background: var(--gain-bg);
    color: var(--gain-color);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }
  .pill-methodology {
    background: rgba(59, 130, 246, 0.1);
    color: var(--brand-accent);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }
  .pill:hover {
    opacity: 0.85;
  }
  .risk-callout {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
    color: #f59e0b;
    padding: 0.85rem 1.15rem;
    border-radius: 6px;
    font-size: 0.825rem;
    line-height: 1.5;
    margin: 1.5rem 0 2rem 0;
  }
  [data-theme="light"] .risk-callout {
    background: rgba(217, 119, 6, 0.08);
    border-color: rgba(217, 119, 6, 0.25);
    color: #b45309;
  }
  .article-body {
    line-height: 1.75;
    color: var(--text-secondary);
    font-size: 1.025rem;
  }
  .article-body p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }
  .article-body h2, .article-body h3, .article-body h4 {
    color: var(--text-primary);
    font-weight: 800;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .article-body h4 {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }
  .article-table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.5rem 0 2rem 0;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--bg-surface);
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin: 1.5rem 0 2rem 0;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
  }
  .article-table-scroll table {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
  }
  .article-body th {
    background: var(--bg-surface-elevated);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
    white-space: nowrap;
  }
  .article-body td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .article-body tr:last-child td {
    border-bottom: none;
  }
  .article-body tbody tr {
    transition: background-color 0.15s ease;
  }
  .article-body tbody tr:hover {
    background: var(--bg-surface-elevated);
  }
  .article-body th:last-child, .article-body td:last-child {
    text-align: right;
  }
  .article-body code {
    font-family: var(--font-mono, monospace);
    color: var(--gain-color);
    background: var(--gain-bg);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875em;
  }
  .article-body a {
    color: var(--brand-accent);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .article-body a:hover {
    text-decoration: underline;
    filter: brightness(1.12);
  }
  .ticker-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }
  .ticker-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--brand-accent);
    background: var(--bg-surface);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .ticker-pill:hover {
    border-color: var(--brand-accent);
    transform: translateY(-1px);
    background: var(--bg-surface-elevated);
  }
  .card-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--brand-accent);
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    margin-top: 1.5rem;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }
  .card-action-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .eeat-box {
    margin-top: 2.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .eeat-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .eeat-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--bg-surface-elevated);
    color: var(--brand-accent);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }
  .eeat-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .eeat-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 0.85rem 0;
  }
  .eeat-desc a {
    color: var(--brand-accent);
    text-decoration: underline;
  }
  .eeat-sources {
    display: flex;
    gap: 0.85rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    align-items: center;
    flex-wrap: wrap;
  }
  .eeat-sources a {
    color: var(--brand-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .eeat-sources a:hover {
    text-decoration: underline;
  }
  .related-intel-section {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
  }
  .related-intel-title {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 1.15rem;
    font-weight: 700;
  }
  .related-intel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
  }
  .related-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: all 0.2s ease;
  }
  .related-card:hover {
    border-color: var(--brand-accent);
    transform: translateY(-2px);
    box-shadow: var(--card-shadow);
  }
  .related-date {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: var(--font-mono, monospace);
  }
  .related-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .related-lead {
    font-size: 0.75rem;
    color: var(--gain-color);
    font-weight: 600;
    font-family: var(--font-mono, monospace);
  }
  .article-footer-disclaimer {
    margin-top: 3rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--brand-accent);
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 0 6px 6px 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
