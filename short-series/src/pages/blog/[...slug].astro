---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title || post.id} description={post.data.description} pubDate={post.data.pubDate}>
  <main style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; font-family: system-ui, sans-serif;">
    <a href="/" style="display: inline-block; margin-bottom: 1.5rem; color: #2563eb; text-decoration: none;">← Back to Home</a>
    <article>
      <Content />
    </article>
  </main>
</Layout>
