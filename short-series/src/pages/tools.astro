---
// short-series/src/pages/tools.astro
import Layout from '../layouts/Layout.astro';

const canonicalURL = new URL('/tools/', Astro.site ?? 'https://tradeopportunities.trade').href;
const pageTitle = "Trading Tools, Spot Swaps & Analytical Workspaces | Trade Opportunities";
const pageDescription = "Dedicated non-custodial crypto swap utility, professional TradingView charting suites, and quantitative market screening tools for active traders.";

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "url": canonicalURL,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": "https://tradeopportunities.trade",
    "logo": {
      "@type": "ImageObject",
      "url": "https://tradeopportunities.trade/favicon.svg"
    }
  }
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(toolsSchema)} />
  </Fragment>

  <div class="tools-page-container">
    <!-- Header -->
    <header class="tools-page-header">
      <div class="section-tag">TRADING RESOURCES &bull; UTILITIES</div>
      <h1 class="page-headline">Analytical Tools &amp; Trading Utilities</h1>
      <p class="page-subheadline">
        While Trade Opportunities focuses primarily on US equity momentum scans, volume surge detection, and SEC dilution risk research, we provide curated technical workspaces and non-custodial spot swap utilities below for multi-asset management and trade execution.
      </p>
    </header>

    <!-- Core Momentum Tools Quick Links -->
    <section class="equity-tools-banner">
      <div class="banner-content">
        <span class="banner-badge">Core Platform Capabilities</span>
        <h2 class="banner-title">US Stock Momentum &amp; Breakout Research</h2>
        <p class="banner-text">Looking for real-time equity momentum, unusual volume, or corporate catalysts? Explore our dedicated research terminals:</p>
      </div>
      <div class="banner-links">
        <a href="/screener" class="banner-btn primary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Live Stock Screener</span>
        </a>
        <a href="/rvol-screener" class="banner-btn secondary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>Relative Volume (RVOL)</span>
        </a>
        <a href="/calendar" class="banner-btn secondary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Catalyst &amp; Earnings Calendar</span>
        </a>
        <a href="/dilution-risk" class="banner-btn secondary">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          <span>Stock Dilution Research</span>
        </a>
      </div>
    </section>

    <!-- Execution Utilities Grid -->
    <section class="tools-grid-section">
      <div class="section-label">PARTNER PLATFORMS &bull; CHARTING &amp; SWAP PROTOCOLS</div>
      
      <div class="tools-grid">
        <!-- TradingView -->
        <div class="tool-card featured">
          <div class="tool-card-top">
            <span class="tool-badge">Professional Charting</span>
            <h3 class="tool-name">TradingView Desktop &amp; Web</h3>
            <p class="tool-desc">
              The industry gold standard for multi-timeframe candlestick analysis, volume profiling (VPVR), anchored VWAPs, and real-time alerts. Used by Trade Opportunities for quantitative charting and breakout confirmation.
            </p>
            <ul class="tool-features">
              <li>Comprehensive technical indicator library &amp; Pine Script</li>
              <li>Anchored Volume-Weighted Average Price (AVWAP)</li>
              <li>Real-time NASDAQ, NYSE, and OTC liquidity feeds</li>
            </ul>
          </div>
          <div class="tool-card-bottom">
            <a href="https://www.tradingview.com/?aff_id=170147" target="_blank" rel="noopener noreferrer" class="tool-action-btn primary">
              Open TradingView Workspace &rarr;
            </a>
          </div>
        </div>

        <!-- ChangeNOW -->
        <div class="tool-card">
          <div class="tool-card-top">
            <span class="tool-badge">Non-Custodial Swaps</span>
            <h3 class="tool-name">ChangeNOW Protocol</h3>
            <p class="tool-desc">
              Instant non-custodial cryptocurrency exchange supporting 900+ digital assets across 70+ blockchains. No registration required; direct wallet-to-wallet execution at competitive market rates.
            </p>
            <ul class="tool-features">
              <li>Non-custodial: funds never held by third-party broker</li>
              <li>Cross-chain settlement between BTC, ETH, SOL, USDT</li>
              <li>Fixed and floating exchange rate options</li>
            </ul>
          </div>
          <div class="tool-card-bottom">
            <a href="https://changenow.app.link/referral?link_id=1c434a8e93e8ff" target="_blank" rel="noopener noreferrer" class="tool-action-btn">
              Launch ChangeNOW Exchange &rarr;
            </a>
          </div>
        </div>

        <!-- SimpleSwap -->
        <div class="tool-card">
          <div class="tool-card-top">
            <span class="tool-badge">Multi-Coin Swaps</span>
            <h3 class="tool-name">SimpleSwap</h3>
            <p class="tool-desc">
              User-friendly instant cryptocurrency exchange platform with support for over 1,500 coins and tokens. Fast order routing across leading liquidity providers with no mandatory accounts.
            </p>
            <ul class="tool-features">
              <li>Support for 1,500+ cryptocurrency pairs</li>
              <li>Zero deposit lockup; non-custodial wallet routing</li>
              <li>24/7 live transaction tracking and support</li>
            </ul>
          </div>
          <div class="tool-card-bottom">
            <a href="https://simpleswap.io/?ref=566becc568f4" target="_blank" rel="noopener noreferrer" class="tool-action-btn">
              Launch SimpleSwap Tool &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Embedded Swap Terminal Section -->
    <section class="embedded-swap-section">
      <div class="swap-terminal-header">
        <div>
          <span class="section-tag">UTILITY TERMINAL</span>
          <h2 class="terminal-title">Non-Custodial Spot Swap Terminal</h2>
          <p class="terminal-desc">
            Directly execute fast cross-chain transfers through the ChangeNOW widget below. Trade Opportunities does not handle fiat transactions, operate as a custodian, or intermediate trades.
          </p>
        </div>
      </div>

      <div class="swap-embed-box">
        <iframe
          id="changenow-tools-widget"
          src="https://changenow.io/embeds/exchange-widget/v2/widget.html?amount=0.1&backgroundColor=121620&darkMode=true&from=btc&horizontal=false&isFiat=false&lang=en&link_id=1c434a8e93e8ff&locales=false&logo=false&primaryColor=3b82f6&to=eth"
          style="height: 380px; width: 100%; max-width: 460px; border: none; border-radius: 8px; margin: 0 auto; display: block;"
          loading="lazy">
        </iframe>
      </div>

      <div class="terminal-disclosure">
        <strong>Important Non-Custodial Disclosure:</strong>
        All cryptocurrency exchanges initiated through the terminal above are processed entirely by ChangeNOW (CHG Meridian Ltd). Trade Opportunities does not operate an exchange, hold custody of private keys or deposits, or provide investment advice regarding digital assets. Always verify wallet receiving addresses before confirming transactions.
      </div>
    </section>
  </div>
</Layout>

<style>
  .tools-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem 1.25rem;
  }

  .tools-page-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-tag {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--brand-accent);
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .page-headline {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .page-subheadline {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
  }

  /* Equity tools banner */
  .equity-tools-banner {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    box-shadow: var(--card-shadow);
  }

  .banner-content {
    max-width: 540px;
  }

  .banner-badge {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.35rem 0;
  }

  .banner-text {
    font-size: 0.84rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.45;
  }

  .banner-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .banner-btn.primary {
    background: var(--brand-accent);
    color: #ffffff;
  }

  .banner-btn.primary:hover {
    background: #2563eb;
    transform: translateY(-1px);
  }

  .banner-btn.secondary {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .banner-btn.secondary:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    transform: translateY(-1px);
  }

  /* Tools Grid Section */
  .tools-grid-section {
    margin-bottom: 3rem;
  }

  .section-label {
    font-size: 0.725rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .tool-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .tool-card.featured {
    border-color: rgba(59, 130, 246, 0.4);
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.03) 0%, var(--bg-surface) 100%);
  }

  .tool-badge {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--brand-accent);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .tool-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .tool-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .tool-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    font-size: 0.78125rem;
    color: var(--text-secondary);
  }

  .tool-features li {
    padding-left: 1.1rem;
    position: relative;
    margin-bottom: 0.4rem;
  }

  .tool-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: 700;
  }

  .tool-action-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    transition: all 0.15s ease;
  }

  .tool-action-btn:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
  }

  .tool-action-btn.primary {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
  }

  .tool-action-btn.primary:hover {
    background: #2563eb;
    color: #ffffff;
  }

  /* Embedded Swap Terminal */
  .embedded-swap-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--card-shadow);
  }

  .swap-terminal-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 1.75rem auto;
  }

  .terminal-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .terminal-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .swap-embed-box {
    margin-bottom: 1.5rem;
  }

  .terminal-disclosure {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.55;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    border-radius: 6px;
    max-width: 860px;
    margin: 0 auto;
  }

  .terminal-disclosure strong {
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .tools-page-container {
      padding: 1.5rem 1rem 3rem 1rem;
    }
    .equity-tools-banner {
      flex-direction: column;
      align-items: flex-start;
    }
    .banner-links {
      width: 100%;
    }
    .banner-btn {
      width: 100%;
      justify-content: center;
    }
    .embedded-swap-section {
      padding: 1.25rem;
    }
  }
</style>
