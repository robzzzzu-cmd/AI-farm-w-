---
// short-series/src/pages/terms.astro
import Layout from '../layouts/Layout.astro';

const canonicalURL = new URL('/terms/', Astro.site ?? 'https://tradeopportunities.trade').href;
const pageTitle = "Terms of Service & Financial Disclosures // Trade Opportunities";
const pageDescription = "Terms of service, execution risk disclaimers, and regulatory disclosures for Trade Opportunities.";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <meta name="bitmedia-site-verification" content="07522f1ef9d6b60ae5363fe10b37f8c5" />
  </Fragment>

  <div class="legal-container">
    <a href="/" class="back-link">&larr; Return to Market Terminal</a>
    <h1>Terms of Service</h1>
    <p class="last-updated">Last Updated: August 2026</p>

    <div class="alert-box">
      <strong>Risk Disclosure:</strong> Trade Opportunities is an automated financial data aggregator. No information published on this domain constitutes personalized investment, tax, legal, or financial advice. All trades or market actions are conducted at your own discretion and risk.
    </div>

    <section class="legal-section">
      <h2>1. Nature of the Service</h2>
      <p>
        Trade Opportunities provides programmatic market commentary, dynamic breakout tracking (sourced via APIs such as Alpha Vantage), volume scans, and liquidity widget integration. The website is intended solely for educational, analytical, and informational use.
      </p>
    </section>

    <section class="legal-section">
      <h2>2. No Fiduciary Duty or Financial Advice</h2>
      <p>
        Trade Opportunities is not a registered broker-dealer, financial adviser, commodity trading advisor (CTA), or portfolio management entity. We do not assess your individual financial situation, risk tolerance, or investment objectives.
      </p>
    </section>

    <section class="legal-section">
      <h2>3. Market Data &amp; Third-Party APIs</h2>
      <p>
        Real-time and delayed pricing data, stock gainers/losers percentages, and volume calculations are retrieved through third-party financial data feeds. While we strive to maintain uninterrupted feeds, we do not warrant the accuracy, timeliness, or completeness of any market data.
      </p>
    </section>

    <section class="legal-section">
      <h2>4. Affiliate Disclosures &amp; External Desks</h2>
      <p>
        Trade Opportunities integrates external tools and widgets, including TradingView, ChangeNOW, SimpleSwap, and Bitmedia/A-ADS ad placements. When interacting with these external tools, you are subject to the individual terms of those third-party operators. We may receive affiliate commissions or referral compensation from links displayed on this site.
      </p>
    </section>

    <section class="legal-section">
      <h2>5. Limitation of Liability</h2>
      <p>
        In no event shall Trade Opportunities or its operators be held liable for any direct, indirect, incidental, punitive, or consequential damages, including loss of capital or profits, resulting from reliance on the data or market commentary published on this platform.
      </p>
    </section>
  </div>
</Layout>

<style>
  .legal-container {
    max-width: 820px;
    margin: 2.5rem auto 4rem auto;
    padding: 0 1.5rem;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--brand-accent);
    text-decoration: none;
    font-weight: 600;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .last-updated {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 2rem;
  }
  .alert-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .alert-box strong {
    color: var(--text-primary);
  }
  [data-theme="light"] .alert-box {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border-color: var(--border-subtle);
  }
  .legal-section {
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 700;
  }
  p {
    font-size: 0.925rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.65;
  }
  a {
    color: var(--brand-accent);
    text-decoration: none;
    font-weight: 600;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
