---
// short-series/src/pages/screener.astro
import Layout from '../layouts/Layout.astro';
import LiveStockScreener from '../components/LiveStockScreener.astro';

const canonicalURL = new URL('/screener/', Astro.site ?? 'https://tradeopportunities.trade').href;
const pageTitle = "Live Real-Time Stock Screener & Breakout Matrix | Trade Opportunities";
const pageDescription = "Real-time momentum screener tracking relative volume (RVOL), multi-week consolidation breakouts, and live 'Why Is It Moving?' attribution layers.";

const screenerSchema = {
  "@context": "https://schema.org",
  "@type": "ItemPage",
  "name": "Live Stock Screener & Real-Time Market Opportunities",
  "url": canonicalURL,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": "https://tradeopportunities.trade",
    "logo": {
      "@type": "ImageObject",
      "url": "https://tradeopportunities.trade/favicon.svg"
    }
  }
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify(screenerSchema)} />
  </Fragment>

  <div class="screener-page-container">
    <header class="page-intro-header">
      <div class="breadcrumb">
        <a href="/">Dashboard</a> &rsaquo; <span>Live Screener</span>
      </div>
      <span class="hub-pill">REAL-TIME MOMENTUM MATRIX</span>
      <h1>Live Breakout Screener</h1>
      <p class="subtitle">
        Scan volume explosions (RVOL &ge; 3.0x), technical consolidation breaches, and instant 5-layer "Why Is It Moving?" diagnostics on US equities.
      </p>
    </header>

    <!-- Full Interactive Screener Module -->
    <LiveStockScreener />

    <!-- Quantitative Framework Documentation -->
    <section class="methodology-note-card">
      <h2>Screener Architecture &amp; Execution Parameters</h2>
      <div class="framework-grid">
        <div class="framework-item">
          <strong>Penny Stocks (&lt;$5)</strong>
          <p>Equities trading below $5.00/share. Filtered against a 25,000 share minimum session volume floor to minimize illiquid quotation anomalies.</p>
        </div>
        <div class="framework-item">
          <strong>Small &amp; Mid Cap ($300M–$10B)</strong>
          <p>Equities between $300M and $10B market capitalization. Targets growth breakouts, relative volume surges, and institutional accumulation.</p>
        </div>
        <div class="framework-item">
          <strong>Large Cap (&gt;$10B)</strong>
          <p>Established liquid market anchors with market capitalization exceeding $10B, index drivers, and macro rotation benchmarks.</p>
        </div>
      </div>
      <p class="footer-clarification">
        <em>Note: Thresholds are practical platform categories engineered for volatility tracking and rapid scanning rather than universal regulatory definitions. Data feed refreshes automatically; off-hours and consolidated exchange feeds reflect 15-minute standard statutory delays.</em>
      </p>
    </section>
  </div>
</Layout>

<style>
  .screener-page-container {
    max-width: 1240px;
    margin: 2rem auto 4rem auto;
    padding: 0 1.25rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }
  .breadcrumb a {
    color: var(--brand-accent);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .page-intro-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .hub-pill {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    background: rgba(59, 130, 246, 0.12);
    color: var(--brand-accent);
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }
  .subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .methodology-note-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 2rem;
  }
  .methodology-note-card h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .framework-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1rem;
  }
  .framework-item strong {
    display: block;
    font-size: 0.85rem;
    color: var(--brand-accent);
    margin-bottom: 0.35rem;
  }
  .framework-item p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .footer-clarification {
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
    margin-top: 0.75rem;
    margin-bottom: 0;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .screener-page-container {
      margin: 1rem auto 2.5rem auto;
      padding: 0 0.75rem;
    }
    .page-intro-header {
      padding-bottom: 1rem;
      margin-bottom: 1.25rem;
    }
    h1 {
      font-size: 1.6rem;
      letter-spacing: -0.015em;
    }
    .subtitle {
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .methodology-note-card {
      padding: 1rem;
    }
    .framework-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .screener-page-container {
      padding: 0 0.5rem;
    }
    h1 {
      font-size: 1.35rem;
    }
  }
</style>
