        border-radius: 4px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
      }
      .disclosure-box strong { color: var(--text-primary); }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .footer-links {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
      }
      .footer-links a { color: var(--text-secondary); text-decoration: none; }
      .footer-links a:hover { color: var(--text-primary); }

      .cookie-banner {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        max-width: 500px;
        margin: 0 auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        z-index: 9999;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      }
      .cookie-banner.hidden { display: none; }
      .cookie-content { display: flex; flex-direction: column; gap: 0.75rem; }
      .cookie-content p { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.4; }
      .cookie-content a { color: var(--brand-accent); text-decoration: underline; }
      .cookie-actions { display: flex; gap: 0.5rem; }
      .cookie-btn {
        padding: 0.4rem 0.85rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
      }
      .cookie-btn.accept { background: var(--brand-accent); color: #fff; }
      .cookie-btn.decline { background: var(--bg-surface-elevated); color: var(--text-secondary); }

      @media (max-width: 1160px) {
        .nav-links { display: none; }
      }

      @media (max-width: 900px) {
        .grid-main, .tools-split-grid { grid-template-columns: minmax(0, 1fr); }
        .newsletter-box { flex-direction: column; align-items: flex-start; }
      }

      @media (max-width: 768px) {
        .search-box { display: none; }
      }

      @media (max-width: 560px) {
        .app-wrapper { padding: 0 0.75rem; }
        .nav-inner { padding: 0.4rem 0; gap: 0.5rem; }
        .brand-group { gap: 0.5rem; }
        .logo { font-size: 0.92rem; }
        .dashboard-toggle-btn { padding: 0.35rem 0.55rem; font-size: 0.72rem; }
        .newsletter-box { padding: 1.15rem; }
        .newsletter-input-group { flex-direction: column; width: 100%; }
        .newsletter-input, #subscribe-btn { width: 100%; font-size: 16px; }
        .card { padding: 1rem; }
        .ad-leaderboard { margin: 0.75rem auto 0.85rem auto !important; padding: 0.5rem 0.25rem !important; }
        .hero-repositioned { padding: 0.85rem 0.75rem !important; margin-bottom: 1rem !important; }
        .hero-headline { font-size: 1.25rem !important; line-height: 1.3 !important; }
        .hero-subheadline { font-size: 0.82rem !important; line-height: 1.4 !important; margin-bottom: 0.75rem !important; }
        .hero-cta-group { flex-direction: column; width: 100%; gap: 0.45rem; }
        .hero-primary-btn, .hero-secondary-btn { width: 100%; justify-content: center; text-align: center; padding: 0.55rem 0.85rem; font-size: 0.85rem; }
        .persona-pills { overflow-x: auto; -webkit-overflow-scrolling: touch; flex-wrap: nowrap; scrollbar-width: none; padding-bottom: 2px; }
        .persona-pills::-webkit-scrollbar { display: none; }
        .persona-pill-btn { flex-shrink: 0; }
