        .instant-chips-list::-webkit-scrollbar { display: none; }
        .hero-chip-btn { flex-shrink: 0; }
        .footer-meta { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
      }

      @media (max-width: 480px) {
        .alerts-action-btn span { display: none; }
        .alerts-action-btn { padding: 0.35rem 0.5rem; }
      }
    </style>
  </head>
