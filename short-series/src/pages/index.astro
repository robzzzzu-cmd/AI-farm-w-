---
// short-series/src/pages/index.astro
import MarketTicker from '../components/MarketTicker.astro';
import DiagnosticDrawer from '../components/DiagnosticDrawer.astro';
import LiveCatalystWire from '../components/LiveCatalystWire.astro';

interface StockItem {
  ticker: string;
  price: string;
  change_amount?: string;
  change_percentage: string;
  volume: string;
}

interface MarkdownPost {
  slug: string;
  frontmatter: {
    title?: string;
    description?: string;
    date?: string;
    displayDate?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    gainers?: StockItem[];
    losers?: StockItem[];
    active?: StockItem[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
  rawContent?: () => string;
}

function formatCompactNumber(val: string | number | undefined): string {
  if (val === undefined || val === null || val === '') return '0';
  const num = typeof val === 'string' ? parseFloat(val.replace(/,/g, '')) : val;
  if (isNaN(num)) return String(val);
  if (Math.abs(num) >= 1e9) return (num / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
  if (Math.abs(num) >= 1e6) return (num / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (Math.abs(num) >= 1e3) return (num / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
  return num.toLocaleString();
}

const rawModules = import.meta.glob('../content/blog/*.md', { eager: true }) as Record<string, any>;
const rawPosts: MarkdownPost[] = Object.entries(rawModules).map(([filePath, mod]) => {
  const filename = filePath.split('/').pop() || '';
  const slug = filename.replace(/\.md$/, '').toLowerCase();
  return {
    ...mod,
    slug,
  };
});

const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);

const displayGainers = featuredPost?.frontmatter?.gainers || [];
const displayLosers = featuredPost?.frontmatter?.losers || [];

// Initial server-side sector render (ensures the container is never blank)
const defaultSectors = [
  { name: "Technology", symbol: "XLK", change: 1.32 },
  { name: "Communication", symbol: "XLC", change: 0.89 },
  { name: "Industrials", symbol: "XLI", change: 0.56 },
  { name: "Consumer Cyclical", symbol: "XLY", change: 0.41 },
  { name: "Financials", symbol: "XLF", change: 0.21 },
  { name: "Health Care", symbol: "XLV", change: -0.18 },
  { name: "Utilities", symbol: "XLU", change: -0.32 },
  { name: "Real Estate", symbol: "XLRE", change: -0.41 }
].sort((a, b) => b.change - a.change);

const maxSectorAbs = Math.max(...defaultSectors.map((d) => Math.abs(d.change)), 1.2);

const canonicalURL = "https://tradeopportunities.trade/";
const pageTitle = "Trade Opportunities // Real-Time Stock Momentum Scanner & Breakout Intelligence";
const pageDescription = "Scan explosive RVOL volume surges, multi-week consolidation breakouts, and live 'Why Is It Moving?' SEC & catalyst diagnostics for US equities.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Trade Opportunities",
  "url": canonicalURL,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": canonicalURL,
    "logo": "https://tradeopportunities.trade/favicon.svg"
  }
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="bitmedia-site-verification" content="07522f1ef9d6b60ae5363fe10b37f8c5" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://tradeopportunities.trade/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.svg?v=2" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('to_theme') || 'dark';
          document.documentElement.setAttribute('data-theme', saved);
        } catch(e) {}
      })();
    </script>

    <style is:inline>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --bg-page: #0b0c10;
        --bg-surface: #12141a;
        --bg-surface-elevated: #181b22;
        --border-subtle: #222632;
        --border-strong: #2f3545;
        --text-primary: #f3f4f6;
        --text-secondary: #9ca3af;
        --text-muted: #6b7280;
        --brand-accent: #3b82f6;
        --gain-color: #22c55e;
        --gain-bg: rgba(34, 197, 94, 0.1);
        --loss-color: #ef4444;
        --loss-bg: rgba(239, 68, 68, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.35);
        --sidebar-width: 270px;
        --nav-height: 58px;
      }

      [data-theme="light"] {
        --bg-page: #f0f2f5;
        --bg-surface: #ffffff;
        --bg-surface-elevated: #e5e8ed;
        --border-subtle: #d0d5dd;
        --border-strong: #98a2b3;
        --text-primary: #111827;
        --text-secondary: #4b5563;
        --text-muted: #667085;
        --brand-accent: #2563eb;
        --gain-color: #16a34a;
        --gain-bg: rgba(22, 163, 74, 0.12);
        --loss-color: #dc2626;
        --loss-bg: rgba(220, 38, 38, 0.12);
        --card-shadow: 0 2px 8px -2px rgba(16, 24, 40, 0.08), 0 1px 4px -1px rgba(16, 24, 40, 0.04);
      }

      *, *::before, *::after { 
        box-sizing: border-box; 
        margin: 0; 
        padding: 0; 
      }
      
      html {
        scroll-behavior: smooth;
        overflow-x: clip;
        width: 100%;
        max-width: 100%;
      }

      section[id], div[id] {
        scroll-margin-top: calc(var(--nav-height) + 48px);
      }

      body {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        position: relative;
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      img, iframe, embed, object {
        max-width: 100%;
      }

      .ad-leaderboard {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        box-sizing: border-box;
      }
      .ad-leaderboard iframe:not(.ad-container-inner iframe) {
        max-width: 100% !important;
      }

      .app-wrapper {
        width: 100%;
        max-width: 1240px;
        min-width: 0;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
      }

      /* Side Dashboard Drawer */
      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 10000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }
      .sidebar-backdrop.active {
        opacity: 1;
        visibility: visible;
      }

      .side-dashboard {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--bg-surface);
        border-right: 1px solid var(--border-subtle);
        z-index: 10001;
        display: flex;
        flex-direction: column;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 6px 0 28px rgba(0, 0, 0, 0.45);
        overflow-y: auto;
      }
      .side-dashboard.open {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--text-primary);
      }
      .sidebar-close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        line-height: 1;
      }
      .sidebar-close-btn:hover {
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
      }

      .sidebar-body {
        flex: 1;
        padding: 1rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .sidebar-group-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 0 0.5rem;
      }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .sidebar-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .sidebar-nav-item:hover {
        background: var(--bg-surface-elevated);
        color: var(--text-primary);
        transform: translateX(2px);
      }
      .sidebar-nav-item.active {
        background: var(--bg-surface-elevated);
        color: var(--brand-accent);
        font-weight: 600;
        border-left: 3px solid var(--brand-accent);
      }
      .sidebar-icon {
        width: 16px;
        height: 16px;
        color: var(--text-muted);
        flex-shrink: 0;
        transition: color 0.2s ease;
      }
      .sidebar-nav-item:hover .sidebar-icon, .sidebar-nav-item.active .sidebar-icon {
        color: var(--brand-accent);
      }

      .sidebar-promo-card {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 0.85rem;
        margin-top: auto;
        margin-bottom: 0.5rem;
      }
      .sidebar-promo-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
      }
      .sidebar-promo-desc {
        font-size: 0.7rem;
        color: var(--text-secondary);
        line-height: 1.4;
        margin-bottom: 0.65rem;
      }
      .sidebar-promo-btn {
        display: block;
        text-align: center;
        background: var(--brand-accent);
        color: #fff !important;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.4rem 0.6rem;
        border-radius: 4px;
        text-decoration: none;
      }

      /* Top Sticky Navigation */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
        width: 100%;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--nav-height);
        min-height: var(--nav-height);
        flex-wrap: nowrap;
        gap: 1rem;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-shrink: 0;
      }
      .dashboard-toggle-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .dashboard-toggle-btn:hover {
        background: var(--bg-surface-elevated);
        border-color: var(--brand-accent);
      }
      .dashboard-toggle-btn svg {
        width: 14px;
        height: 14px;
        color: var(--brand-accent);
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .logo-glyph {
        width: 14px;
        height: 14px;
        background: var(--brand-accent);
        border-radius: 3px;
        flex-shrink: 0;
      }
      .nav-links {
        display: flex;
        gap: 1.35rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: color 0.2s ease;
        position: relative;
        padding-bottom: 4px;
      }
      .nav-links a:hover {
        color: var(--text-primary);
      }
      .nav-links a.active {
        color: var(--brand-accent);
        font-weight: 600;
      }
      .nav-links a.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--brand-accent);
        border-radius: 2px;
        animation: navUnderlineFade 0.2s ease-out;
      }
      @keyframes navUnderlineFade {
        from { opacity: 0; transform: scaleX(0.7); }
        to { opacity: 1; transform: scaleX(1); }
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-left: auto;
        flex-shrink: 0;
      }
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
      }
      .search-icon {
        position: absolute;
        left: 0.65rem;
        width: 13px;
        height: 13px;
        color: var(--text-muted);
        pointer-events: none;
      }
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 0.35rem 0.65rem 0.35rem 1.85rem;
        border-radius: 6px;
        outline: none;
        width: 180px;
        box-sizing: border-box;
        transition: border-color 0.15s ease;
      }
      .search-input:focus { border-color: var(--brand-accent); }

      .icon-action-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .icon-action-btn:hover {
        color: var(--text-primary);
        border-color: var(--brand-accent);
      }
      .alerts-action-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.65rem;
        height: 32px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.15s ease;
      }
      .alerts-action-btn:hover {
        color: var(--text-primary);
        border-color: var(--brand-accent);
      }
      .alerts-badge-num {
        background: var(--brand-accent);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.35rem;
        border-radius: 10px;
      }

      /* Repositioned Hero & Value Proposition Styles */
      .hero-repositioned {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 2.2rem 2rem;
        margin-bottom: 2.5rem;
        box-shadow: var(--card-shadow);
        position: relative;
        overflow: hidden;
      }
      .persona-selector-wrap {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
      }
      .persona-label {
        font-size: 0.65rem;
        font-family: var(--font-mono);
        font-weight: 800;
        color: var(--brand-accent);
        letter-spacing: 0.08em;
      }
      .persona-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .persona-pill-btn {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.15s ease;
      }
      .persona-pill-btn:hover {
        color: var(--text-primary);
        border-color: var(--border-strong);
      }
      .persona-pill-btn.active {
        background: rgba(59, 130, 246, 0.14);
        border-color: var(--brand-accent);
        color: var(--text-primary);
      }
      .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-muted);
        transition: background 0.15s ease;
      }
      .persona-pill-btn.active .pill-dot {
        background: var(--brand-accent);
        box-shadow: 0 0 6px var(--brand-accent);
      }
      .hero-text-container {
        max-width: 900px;
        margin-bottom: 1.75rem;
      }
      .hero-headline {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
      }
      @media (max-width: 768px) {
        .hero-headline { font-size: 1.6rem; }
        .hero-repositioned { padding: 1.5rem 1.25rem; }
      }
      .hero-subheadline {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.55;
        max-width: 780px;
      }
      .hero-cta-group {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }
      .hero-primary-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--brand-accent);
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.35rem;
        border-radius: 6px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
        transition: all 0.15s ease;
      }
      .hero-primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.45);
        filter: brightness(1.08);
      }
      .hero-secondary-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary) !important;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.7rem 1.25rem;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .hero-secondary-btn:hover {
        border-color: var(--brand-accent);
        background: var(--bg-surface);
      }
      .hero-instant-chips-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding-top: 1rem;
        border-top: 1px solid var(--border-subtle);
      }
      .chips-label {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--text-muted);
        font-weight: 600;
      }
      .instant-chips-list {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      .hero-chip-btn {
        background: var(--bg-page);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .hero-chip-btn:hover {
        color: var(--brand-accent);
        border-color: var(--brand-accent);
        background: var(--bg-surface-elevated);
      }
      .hero-pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.85rem;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-subtle);
      }
      .hero-pillar-card {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .pillar-tag {
        font-size: 0.65rem;
        font-family: var(--font-mono);
        font-weight: 700;
        color: var(--brand-accent);
        letter-spacing: 0.05em;
      }
      .pillar-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-primary);
      }
      .pillar-desc {
        font-size: 0.72rem;
        color: var(--text-secondary);
        line-height: 1.4;
      }
      @media (max-width: 768px) {
