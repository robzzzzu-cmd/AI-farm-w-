---
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true }));
posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal // Market Intelligence & Breakouts</title>
    <style>
      :root {
        --bg-color: #0b0f19;
        --card-bg: #111827;
        --border-color: #1f2937;
        --accent-green: #10b981;
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        line-height: 1.6;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1.5rem;
        margin-bottom: 2.5rem;
      }
      .logo {
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.025em;
        color: #ffffff;
      }
      .logo span { color: var(--accent-green); }
      .status-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        background: var(--card-bg);
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        border: 1px solid var(--border-color);
      }
      .pulse {
        width: 8px;
        height: 8px;
        background-color: var(--accent-green);
        border-radius: 50%;
        box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }
      .hero {
        margin-bottom: 3rem;
      }
      .hero h1 {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -0.05em;
        margin-bottom: 0.5rem;
      }
      .hero p {
        color: var(--text-muted);
        font-size: 1.1rem;
      }
      .post {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      }
      .post h2, .post h1 {
        font-size: 1.4rem;
        margin-top: 0;
        color: #ffffff;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
      }
      .post p {
        font-size: 1.05rem;
        color: #e5e7eb;
      }
      .post hr {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 1.5rem 0;
      }
      /* Affiliate Box Styling */
      .post a {
        display: block;
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #ffffff;
        text-align: center;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        margin-top: 1rem;
        transition: opacity 0.2s;
      }
      .post a:hover {
        opacity: 0.9;
      }
      .disclaimer {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: 3rem;
        border-top: 1px solid var(--border-color);
        padding-top: 1.5rem;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">ALPHA<span>FEED</span>.AI</div>
      <div class="status-badge">
        <div class="pulse"></div>
        <span>Live Engine Active</span>
      </div>
    </header>

    <div class="hero">
      <h1>Autonomous Market Intelligence</h1>
      <p>Real-time algorithmic tracking of extreme volume surges, momentum runners, and market movers.</p>
    </div>

    <main>
      {posts.length === 0 ? (
        <div class="post">
          <p>Initializing sequence. Waiting for the next market batch...</p>
        </div>
      ) : (
        posts.map(post => (
          <article class="post">
            <post.Content />
          </article>
        ))
      )}
    </main>

    <div class="disclaimer">
      <p>&copy; 2026 AlphaFeed AI. Automated reports for informational purposes only. Not financial advice.</p>
    </div>
  </body>
</html>
