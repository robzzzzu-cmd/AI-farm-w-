---
// short-series/src/pages/index.astro
import MarketTicker from '../components/MarketTicker.astro';

interface StockItem {
  ticker: string;
  price: string;
  change_amount?: string;
  change_percentage: string;
  volume: string;
}

interface MarkdownPost {
  frontmatter: {
    title?: string;
    description?: string;
    date?: string;
    displayDate?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    gainers?: StockItem[];
    losers?: StockItem[];
    active?: StockItem[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
  rawContent?: () => string;
}

// Compact metric formatter: transforms 116127 into 116.1K, 32100000 into 32.1M
function formatCompactNumber(val: string | number | undefined): string {
  if (val === undefined || val === null || val === '') return '0';
  const num = typeof val === 'string' ? parseFloat(val.replace(/,/g, '')) : val;
  if (isNaN(num)) return String(val);
  if (Math.abs(num) >= 1e9) {
    return (num / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
  }
  if (Math.abs(num) >= 1e6) {
    return (num / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  }
  if (Math.abs(num) >= 1e3) {
    return (num / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
  }
  return num.toLocaleString();
}

const rawPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as MarkdownPost[];
const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);

const displayGainers = featuredPost?.frontmatter?.gainers || [];
const displayLosers = featuredPost?.frontmatter?.losers || [];

const canonicalURL = "https://tradeopportunities.trade/";
const pageTitle = "Trade Opportunities // Quantitative Market Intelligence & Volatility Monitoring";
const pageDescription = "Automated quantitative tracking of high-momentum equity breakouts, unusual relative volume, and sector liquidity shifts.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Trade Opportunities",
  "url": canonicalURL,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": canonicalURL,
    "logo": "https://tradeopportunities.trade/favicon.svg"
  }
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="bitmedia-site-verification" content="07522f1ef9d6b60ae5363fe10b37f8c5" />

    <!-- Open Graph & Social Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://tradeopportunities.trade/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Dynamic Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.svg?v=2" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <style is:inline>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --bg-page: #0b0e14;
        --bg-surface: #111622;
        --bg-surface-elevated: #161d2d;
        --border-subtle: #1e2638;
        --border-strong: #2d374d;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --brand-accent: #3b82f6;
        --gain-color: #22c55e;
        --gain-bg: rgba(34, 197, 94, 0.1);
        --loss-color: #ef4444;
        --loss-bg: rgba(239, 68, 68, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.25);
        --sidebar-width: 270px;
        --nav-height: 58px;
      }

      [data-theme="light"] {
        --bg-page: #f8fafc;
        --bg-surface: #ffffff;
        --bg-surface-elevated: #f1f5f9;
        --border-subtle: #e2e8f0;
        --border-strong: #cbd5e1;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;
        --brand-accent: #2563eb;
        --gain-color: #16a34a;
        --gain-bg: rgba(22, 163, 74, 0.1);
        --loss-color: #dc2626;
        --loss-bg: rgba(220, 38, 38, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }

      *, *::before, *::after { 
        box-sizing: border-box; 
        margin: 0; 
        padding: 0; 
      }
      
      html {
        scroll-behavior: smooth;
      }

      /* Offset anchor jumps cleanly below the sticky navigation */
      section[id], div[id] {
        scroll-margin-top: calc(var(--nav-height) + 48px);
      }

      body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      .app-wrapper {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
      }

      /* Side Dashboard (Drawer) */
      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }
      .sidebar-backdrop.active {
        opacity: 1;
        visibility: visible;
      }

      .side-dashboard {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--bg-surface);
        border-right: 1px solid var(--border-subtle);
        z-index: 1001;
        display: flex;
        flex-direction: column;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 6px 0 28px rgba(0, 0, 0, 0.45);
        overflow-y: auto;
      }
      .side-dashboard.open {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--text-primary);
      }
      .sidebar-close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        line-height: 1;
      }
      .sidebar-close-btn:hover {
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
      }

      .sidebar-body {
        flex: 1;
        padding: 1rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .sidebar-group-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 0 0.5rem;
      }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .sidebar-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .sidebar-nav-item:hover, .sidebar-nav-item.active {
        background: var(--bg-surface-elevated);
        color: var(--text-primary);
      }
      .sidebar-nav-item.active {
        border-left: 3px solid var(--brand-accent);
      }
      .sidebar-icon {
        width: 16px;
        height: 16px;
        color: var(--text-muted);
        flex-shrink: 0;
      }
      .sidebar-nav-item:hover .sidebar-icon, .sidebar-nav-item.active .sidebar-icon {
        color: var(--brand-accent);
      }

      .sidebar-promo-card {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 0.85rem;
        margin-top: auto;
      }
      .sidebar-promo-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
      }
      .sidebar-promo-desc {
        font-size: 0.7rem;
        color: var(--text-secondary);
        line-height: 1.4;
        margin-bottom: 0.65rem;
      }
      .sidebar-promo-btn {
        display: block;
        text-align: center;
        background: var(--brand-accent);
        color: #fff !important;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.4rem 0.6rem;
        border-radius: 4px;
        text-decoration: none;
      }

      .sidebar-footer {
        padding: 0.85rem 1rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }
      .user-badge {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        font-family: var(--font-mono);
        color: var(--brand-accent);
      }
      .user-meta-name {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-primary);
      }
      .user-meta-status {
        font-size: 0.65rem;
        color: var(--text-muted);
      }

      /* Top Sticky Navigation */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
        width: 100%;
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: var(--nav-height);
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-shrink: 0;
      }
      .dashboard-toggle-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .dashboard-toggle-btn:hover {
        background: var(--bg-surface-elevated);
        border-color: var(--brand-accent);
      }
      .dashboard-toggle-btn svg {
        width: 14px;
        height: 14px;
        color: var(--brand-accent);
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .logo-glyph {
        width: 14px;
        height: 14px;
        background: var(--brand-accent);
        border-radius: 3px;
        flex-shrink: 0;
      }
      .nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: color 0.15s ease;
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
      }
      .search-icon {
        position: absolute;
        left: 0.65rem;
        width: 13px;
        height: 13px;
        color: var(--text-muted);
        pointer-events: none;
      }
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 0.35rem 0.65rem 0.35rem 1.85rem;
        border-radius: 6px;
        outline: none;
        width: 180px;
        box-sizing: border-box;
        transition: border-color 0.15s ease;
      }
      .search-input:focus { border-color: var(--brand-accent); }

      .icon-action-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .icon-action-btn:hover {
        color: var(--text-primary);
        border-color: var(--brand-accent);
      }
      .alerts-action-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.65rem;
        height: 32px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.15s ease;
      }
      .alerts-action-btn:hover {
        color: var(--text-primary);
        border-color: var(--brand-accent);
      }
      .alerts-badge-num {
        background: var(--brand-accent);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.35rem;
        border-radius: 10px;
      }

      /* Hero */
      .hero-section {
        padding: 1.75rem 0 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border-subtle);
        margin-bottom: 2rem;
        gap: 1rem;
      }
      .hero-left h1 {
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
      }
      .hero-left p { font-size: 0.9rem; color: var(--text-secondary); }
      
      .scanning-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.3rem 0.65rem;
        border-radius: 4px;
        white-space: nowrap;
      }
      .scanning-dot {
        width: 7px;
        height: 7px;
        background-color: var(--gain-color);
        border-radius: 50%;
        animation: pulseFade 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }
      @keyframes pulseFade {
        0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
        50% { opacity: 0.2; box-shadow: 0 0 0 rgba(34, 197, 94, 0); }
      }

      .section-label {
        font-size: 0.78125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }

      /* Macro Grid & Sector Performance */
      .macro-row-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.6fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .sector-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.25rem;
        box-shadow: var(--card-shadow);
      }
      .sector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.15rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .sector-title {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
      }
      .sector-context-note {
        font-size: 0.7rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
      }

      .sector-table {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        min-height: 260px;
        justify-content: center;
      }
      .sector-row {
        display: grid;
        grid-template-columns: 140px 1fr 65px;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
      }
      .sector-name {
        color: var(--text-secondary);
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sector-bar-bg {
        height: 6px;
        background: var(--bg-surface-elevated);
        border-radius: 3px;
        overflow: hidden;
      }
      .sector-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .sector-bar-fill.pos { background: var(--gain-color); }
      .sector-bar-fill.neg { background: var(--loss-color); }
      .sector-val {
        text-align: right;
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.78125rem;
      }
      .val-pos { color: var(--gain-color); }
      .val-neg { color: var(--loss-color); }

      .sector-footer-note {
        margin-top: 1rem;
        padding-top: 0.65rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
      }
      .sector-footer-note a {
        color: var(--brand-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .sector-footer-note a:hover { text-decoration: underline; }

      .grid-main {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(0, 1.2fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        align-items: start;
      }

      .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.35rem;
        box-shadow: var(--card-shadow);
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .pill {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .pill-gain { background: var(--gain-bg); color: var(--gain-color); border-color: transparent; }
      
      .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.85rem;
      }

      .card-body {
        font-size: 0.885rem;
        color: var(--text-secondary);
        line-height: 1.65;
        word-break: break-word;
      }
      .card-body p { margin-bottom: 0.9rem; }
      .card-body a { color: var(--brand-accent); text-decoration: none; font-weight: 600; }
      .card-body a:hover { text-decoration: underline; }
      .card-body h4 { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 1.25rem 0 0.5rem 0; }
      
      .card-body table, .compact-table {
        display: block;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.78rem;
        margin: 0.75rem 0 0.5rem 0;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: 4px;
      }
      .card-body th, .compact-table th {
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-muted);
        text-align: left;
        padding: 0.5rem 0.65rem;
        border-bottom: 1px solid var(--border-subtle);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.68rem;
        white-space: nowrap;
      }
      .card-body td, .compact-table td {
        padding: 0.5rem 0.65rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .card-body code, .compact-table code {
        font-family: var(--font-mono);
        color: var(--gain-color);
      }

      tr.table-row-hidden {
        display: none !important;
      }

      .toggle-table-btn {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--brand-accent);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 1rem;
        transition: all 0.15s ease;
      }
      .toggle-table-btn:hover {
        border-color: var(--brand-accent);
        color: var(--text-primary);
      }

      .card-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        background: var(--brand-accent);
        color: #ffffff !important;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8125rem;
        padding: 0.65rem 0.85rem;
        border-radius: 5px;
        margin-top: 1rem;
        transition: opacity 0.15s;
      }
      .card-action-btn:hover { opacity: 0.9; }

      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-accent);
        background: var(--bg-surface-elevated);
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        border: 1px solid var(--border-subtle);
        text-decoration: none;
      }

      .stream-list { display: flex; flex-direction: column; gap: 0.75rem; }
      .stream-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.1rem;
      }
      .stream-title { 
        font-size: 0.875rem; 
        font-weight: 600; 
        margin-bottom: 0.4rem; 
      }
      .stream-body {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.5;
        max-height: 140px;
        overflow: hidden;
      }
      .stream-body table { display: none; }
      .stream-date { font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.35rem; }

      /* Table Card */
      .table-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow-x: auto;
        margin-bottom: 2.5rem;
      }
      .data-table {
        width: 100%;
        min-width: 540px;
        border-collapse: collapse;
        font-size: 0.8125rem;
        text-align: left;
      }
      .data-table th {
        background: var(--bg-surface-elevated);
        color: var(--text-muted);
        font-size: 0.725rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        white-space: nowrap;
      }
      .data-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .table-symbol { font-weight: 700; color: var(--text-primary); font-family: var(--font-mono); }
      .table-gain { color: var(--gain-color); font-weight: 600; font-family: var(--font-mono); }
      .table-loss { color: var(--loss-color); font-weight: 600; font-family: var(--font-mono); }
      .table-vol { font-family: var(--font-mono); color: var(--text-secondary); }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 3.5rem;
      }
      .tool-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tool-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin-bottom: 0.35rem;
      }
      .tool-name { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; }
      .tool-desc { font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.45; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78125rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        padding: 0.45rem 0.75rem;
        border-radius: 4px;
      }
      .tool-btn:hover { background: var(--brand-accent); color: #fff; border-color: var(--brand-accent); }

      .newsletter-box {
        background: linear-gradient(180deg, var(--bg-surface-elevated) 0%, var(--bg-surface) 100%);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.5rem;
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
      }
      .newsletter-input-group {
        display: flex;
        gap: 0.5rem;
      }
      .newsletter-input {
        background: var(--bg-page);
        border: 1px solid var(--border-strong);
        color: var(--text-primary);
        font-size: 0.8125rem;
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        outline: none;
      }

      footer {
        border-top: 1px solid var(--border-subtle);
        padding: 2.5rem 0 2rem;
        font-size: 0.78125rem;
        color: var(--text-muted);
      }
      .disclosure-box {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-left: 3px solid var(--brand-accent);
        border-radius: 4px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
      }
      .disclosure-box strong { color: var(--text-primary); }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .footer-links {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
      }
      .footer-links a { color: var(--text-secondary); text-decoration: none; }
      .footer-links a:hover { color: var(--text-primary); }

      /* Cookie Consent */
      .cookie-banner {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        max-width: 500px;
        margin: 0 auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        z-index: 9999;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      }
      .cookie-banner.hidden { display: none; }
      .cookie-content { display: flex; flex-direction: column; gap: 0.75rem; }
      .cookie-content p { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.4; }
      .cookie-content a { color: var(--brand-accent); text-decoration: underline; }
      .cookie-actions { display: flex; gap: 0.5rem; }
      .cookie-btn {
        padding: 0.4rem 0.85rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
      }
      .cookie-btn.accept { background: var(--brand-accent); color: #fff; }
      .cookie-btn.decline { background: var(--bg-surface-elevated); color: var(--text-secondary); }

      @media (max-width: 900px) {
        .macro-row-grid, .grid-main { grid-template-columns: minmax(0, 1fr); }
        .hero-section { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .nav-links { display: none; }
        .newsletter-box { flex-direction: column; align-items: flex-start; }
      }

      @media (max-width: 560px) {
        .app-wrapper { padding: 0 0.85rem; }
        .nav-inner { flex-direction: column; align-items: stretch; padding: 0.6rem 0; }
        .brand-group { width: 100%; justify-content: space-between; }
        .nav-actions { width: 100%; justify-content: space-between; }
        .search-box, .search-input { width: 100%; }
        .newsletter-box { padding: 1.15rem; }
        .newsletter-input-group { flex-direction: column; width: 100%; }
        .newsletter-input, #subscribe-btn { width: 100%; }
        .card { padding: 1rem; }
      }
    </style>
  </head>
