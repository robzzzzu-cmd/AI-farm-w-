---
interface MarkdownPost {
  frontmatter: {
    title?: string;
    date?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
}

const rawPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as MarkdownPost[];
const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1);
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trade Opportunities // Financial Intelligence & Signals</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <style is:inline>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;

        --bg-page: #f8fafc;
        --bg-surface: #ffffff;
        --bg-surface-elevated: #f1f5f9;
        --border-subtle: #e2e8f0;
        --border-strong: #cbd5e1;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #94a3b8;
        --brand-accent: #2563eb;
        --gain-color: #059669;
        --gain-bg: rgba(5, 150, 105, 0.1);
        --loss-color: #dc2626;
        --card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
      }

      html[data-theme="dark"] {
        --bg-page: #080b11;
        --bg-surface: #0e1420;
        --bg-surface-elevated: #141c2c;
        --border-subtle: #1e293b;
        --border-strong: #334155;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --brand-accent: #3b82f6;
        --gain-color: #10b981;
        --gain-bg: rgba(16, 185, 129, 0.12);
        --loss-color: #f43f5e;
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .app-wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* Navigation */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
        backdrop-filter: blur(12px);
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 60px;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -0.03em;
        text-decoration: none;
        color: var(--text-primary);
      }
      .logo-glyph {
        width: 18px;
        height: 18px;
        background: var(--brand-accent);
        border-radius: 4px;
      }
      .nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
      }
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 0.4rem 0.75rem 0.4rem 2rem;
        border-radius: 6px;
        outline: none;
        width: 180px;
      }
      .search-icon {
        position: absolute;
        left: 0.65rem;
        width: 12px;
        height: 12px;
        stroke: var(--text-muted);
      }
      .theme-btn {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        width: 34px;
        height: 34px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Ticker Strip */
      .ticker-strip {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        font-size: 0.75rem;
        font-family: var(--font-mono);
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: none;
      }
      .ticker-strip::-webkit-scrollbar { display: none; }
      .ticker-items {
        display: flex;
        gap: 2rem;
        padding: 0.45rem 1.25rem;
        max-width: 1240px;
        margin: 0 auto;
      }
      .ticker-item { display: flex; align-items: center; gap: 0.5rem; }
      .ticker-symbol { font-weight: 600; color: var(--text-primary); }
      .ticker-pos { color: var(--gain-color); }

      /* Ad Placements */
      .ad-leaderboard {
        margin: 1.5rem auto 0.5rem auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.75rem;
      }
      .ad-label {
        font-size: 0.625rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
      }

      /* Hero Section */
      .hero-section {
        padding: 1.75rem 0 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border-subtle);
        margin-bottom: 2rem;
      }
      .hero-left h1 {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.35rem;
      }
      .hero-left p { font-size: 0.9375rem; color: var(--text-secondary); }
      .system-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 600;
        font-family: var(--font-mono);
        color: var(--gain-color);
        background: var(--gain-bg);
        border: 1px solid var(--gain-color);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
      }
      .pulse-dot {
        width: 6px;
        height: 6px;
        background: var(--gain-color);
        border-radius: 50%;
      }

      /* Content Layout */
      .section-label {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }
      .grid-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.75rem;
        margin-bottom: 3rem;
      }

      /* Cards */
      .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .pill {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .pill-gain { background: var(--gain-bg); color: var(--gain-color); border-color: transparent; }
      .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .card-body {
        font-size: 0.9375rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 1.25rem;
      }
      .card-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        background: var(--brand-accent);
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.65rem 1rem;
        border-radius: 6px;
        margin-top: 1rem;
        transition: opacity 0.15s;
      }
      .card-action-btn:hover { opacity: 0.9; }

      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-subtle);
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-accent);
        background: var(--bg-surface-elevated);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--border-subtle);
      }

      /* Stream Items */
      .stream-list { display: flex; flex-direction: column; gap: 0.85rem; }
      .stream-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1rem 1.15rem;
      }
      .stream-title { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; }
      .stream-date { font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-muted); }

      /* Table */
      .table-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 3rem;
      }
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
        text-align: left;
      }
      .data-table th {
        background: var(--bg-surface-elevated);
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .data-table td {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .table-symbol { font-weight: 700; color: var(--text-primary); font-family: var(--font-mono); }
      .table-gain { color: var(--gain-color); font-weight: 600; font-family: var(--font-mono); }

      /* Tools Grid */
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
        margin-bottom: 3.5rem;
      }
      .tool-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tool-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin-bottom: 0.5rem;
      }
      .tool-name { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.35rem; }
      .tool-desc { font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1.25rem; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8125rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        padding: 0.5rem 0.85rem;
        border-radius: 6px;
      }
      .tool-btn:hover { background: var(--brand-accent); color: #fff; border-color: var(--brand-accent); }

      /* Footer */
      footer {
        border-top: 1px solid var(--border-subtle);
        padding: 2.5rem 0;
        font-size: 0.8125rem;
        color: var(--text-muted);
      }
      .disclaimer { font-size: 0.75rem; margin-top: 0.5rem; }

      @media (max-width: 860px) {
        .grid-main { grid-template-columns: 1fr; }
        .hero-section { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .nav-links { display: none; }
      }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <div class="app-wrapper nav-inner">
        <div class="brand-group">
          <a href="#" class="logo">
            <span class="logo-glyph"></span>
            TRADE OPPORTUNITIES
          </a>
          <ul class="nav-links">
            <li><a href="#intelligence" class="active">Intelligence</a></li>
            <li><a href="#movers">Market Movers</a></li>
            <li><a href="#tools">Platforms & Tools</a></li>
          </ul>
        </div>
        <div class="nav-actions">
          <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="filter-input" class="search-input" placeholder="Filter tickers / intel..." />
          </div>
          <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <div class="ticker-strip">
      <div class="ticker-items">
        <div class="ticker-item"><span class="ticker-symbol">S&P 500</span><span class="ticker-pos">+0.48%</span></div>
        <div class="ticker-item"><span class="ticker-symbol">NASDAQ</span><span class="ticker-pos">+0.82%</span></div>
        <div class="ticker-item"><span class="ticker-symbol">BTC/USD</span><span class="ticker-pos">+1.45%</span></div>
        <div class="ticker-item"><span class="ticker-symbol">ETH/USD</span><span class="ticker-pos">+2.10%</span></div>
      </div>
    </div>

    <div class="app-wrapper">
      <!-- Top Leaderboard A-ADS Unit Slot -->
      <div class="ad-leaderboard">
        <span class="ad-label">Sponsored Intelligence</span>
        <div id="frame" style="width: 100%; margin: auto; position: relative;">
          <iframe 
            data-aa="2453491" 
            src="//acceptable.a-ads.com/2453491/?size=Adaptive&background_color=0e1420" 
            style="border: 0; padding: 0; width: 100%; max-width: 728px; height: 90px; overflow: hidden; display: block; margin: auto;"
            loading="lazy">
          </iframe>
        </div>
      </div>

      <header class="hero-section">
        <div class="hero-left">
          <h1>Market Intelligence, Without The Noise</h1>
          <p>Autonomous technical tracking of volume anomalies, momentum leaders, and actionable opportunities.</p>
        </div>
        <div class="hero-right">
          <div class="system-badge">
            <div class="pulse-dot"></div>
            SCANNER ENGINE ACTIVE
          </div>
        </div>
      </header>

      <!-- Live Dispatches -->
      <section id="intelligence">
        <div class="section-label">01 // Live Intelligence Stream</div>
        <div class="grid-main">
          
          {featuredPost ? (
            <article class="card dispatch-card">
              <div class="card-meta">
                <span class="pill pill-gain">{featuredPost.frontmatter.category || 'Breakout'}</span>
                <span style="font-family: var(--font-mono);">{featuredPost.frontmatter.date}</span>
              </div>
              <h2 class="card-title">{featuredPost.frontmatter.title}</h2>
              <div class="card-body">
                <featuredPost.Content />
              </div>
              
              {featuredPost.frontmatter.tickers && (
                <div class="ticker-tags">
                  {featuredPost.frontmatter.tickers.map((t: string) => (
                    <span class="ticker-pill">${t}</span>
                  ))}
                </div>
              )}

              <!-- Primary Referral CTA -->
              <a href={featuredPost.frontmatter.refUrl || "https://changenow.io/?link_id=1c434a8e93e8ff"} 
                 target="_blank" 
                 rel="noopener noreferrer" 
                 class="card-action-btn">
                {featuredPost.frontmatter.refLabel || "Execute Spot Order on ChangeNOW"} &rarr;
              </a>
            </article>
          ) : (
            <div class="card">
              <p style="color: var(--text-secondary);">Initializing scan sequence. Next batch will populate at market close.</p>
            </div>
          )}

          <div class="stream-list">
            {secondaryPosts.map(post => (
              <article class="stream-item dispatch-card">
                <div class="stream-date">{post.frontmatter.date}</div>
                <h3 class="stream-title">{post.frontmatter.title}</h3>
                <div style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.4; margin-top: 0.35rem;">
                  <post.Content />
                </div>
                <a href={post.frontmatter.refUrl || "https://changenow.io/?link_id=1c434a8e93e8ff"} 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   style="display: inline-block; font-size: 0.75rem; font-weight: 600; color: var(--brand-accent); text-decoration: none; margin-top: 0.5rem;">
                  {post.frontmatter.refLabel || "Access Order Terminal"} &rarr;
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Market Movers Section -->
      <section id="movers">
        <div class="section-label">02 // Monitored Breakouts</div>
        <div class="table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Asset</th>
                <th>Classification</th>
                <th>Signal Type</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="table-symbol">{featuredPost?.frontmatter?.leadTicker || 'KLXER'}</td>
                <td>High Relative Volume</td>
                <td><span class="pill pill-gain">Expansion</span></td>
                <td class="table-gain">{featuredPost?.frontmatter?.leadGain || '+269.3%'}</td>
              </tr>
              <tr>
                <td class="table-symbol">CRE</td>
                <td>Volume Expansion</td>
                <td><span class="pill pill-gain">Breakout</span></td>
                <td class="table-gain">+162.9%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Trading Platforms & Tools -->
      <section id="tools">
        <div class="section-label">03 // Analytical Tools & Liquidity</div>
        <div class="tools-grid">
          <div class="tool-card">
            <div>
              <span class="tool-badge">Charting</span>
              <h3 class="tool-name">TradingView</h3>
              <p class="tool-desc">Multi-timeframe charting and volume profiling suites.</p>
            </div>
            <a href="https://www.tradingview.com/?aff_id=170147" target="_blank" rel="noopener noreferrer" class="tool-btn">
              Open Workspace &rarr;
            </a>
          </div>

          <div class="tool-card">
            <div>
              <span class="tool-badge">Non-Custodial</span>
              <h3 class="tool-name">ChangeNOW</h3>
              <p class="tool-desc">Cross-chain crypto spot settlement with instant routing.</p>
            </div>
            <a href="https://changenow.io/?link_id=1c434a8e93e8ff" target="_blank" rel="noopener noreferrer" class="tool-btn">
              Access Liquidity &rarr;
            </a>
          </div>

          <div class="tool-card">
            <div>
              <span class="tool-badge">Asset Swaps</span>
              <h3 class="tool-name">SimpleSwap</h3>
              <p class="tool-desc">Frictionless asset routing across 1,500+ pairs.</p>
            </div>
            <a href="https://simpleswap.io/?ref=566becc568f4" target="_blank" rel="noopener noreferrer" class="tool-btn">
              Launch Exchange &rarr;
            </a>
          </div>
        </div>
      </section>

      <footer>
        <div>&copy; 2026 Trade Opportunities. All rights reserved.</div>
        <p class="disclaimer">
          Market information is synthesized algorithmically for informational purposes only and does not constitute financial advice.
        </p>
      </footer>
    </div>

    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const rootHtml = document.documentElement;
      const savedTheme = localStorage.getItem('to_theme') || 'dark';
      rootHtml.setAttribute('data-theme', savedTheme);

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const currentTheme = rootHtml.getAttribute('data-theme');
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          rootHtml.setAttribute('data-theme', nextTheme);
          localStorage.setItem('to_theme', nextTheme);
        });
      }

      const filterInput = document.getElementById('filter-input') as HTMLInputElement | null;
      if (filterInput) {
        filterInput.addEventListener('input', (e) => {
          const query = (e.target as HTMLInputElement).value.toLowerCase();
          const cards = document.querySelectorAll('.dispatch-card');
          cards.forEach((card) => {
            const text = (card as HTMLElement).innerText.toLowerCase();
            (card as HTMLElement).style.display = text.includes(query) ? '' : 'none';
          });
        });
      }
    </script>
  </body>
</html>
