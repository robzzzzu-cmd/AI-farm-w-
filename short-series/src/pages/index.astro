          <span class="workspace-kicker font-mono tabular-nums tracking-tight">LIVE SCANNER</span>
          <h1 class="workspace-heading">High-Conviction Momentum &amp; RVOL Breakout Terminal</h1>
        </div>

        {reportDateStripPosts.length > 0 && (
          <div class="workspace-date-pills" aria-label="Quick access to recent market dispatches by date">
            {reportDateStripPosts.map((post, idx) => {
              const leadSym = post.frontmatter.leadTicker || post.frontmatter.gainers?.[0]?.ticker;
              return (
                <a
                  href={`/blog/${post.slug}/`}
                  class:list={['report-date-pill font-mono tabular-nums tracking-tight', { latest: idx === 0 }]}
                  title={post.frontmatter.title || 'Open Market Dispatch'}
                >
                  {idx === 0 && <span class="report-pill-badge">Latest</span>}
                  <span>{formatCompactReportDate(post)}</span>
                  {leadSym && <span class="report-pill-ticker">${sanitizeTickerSymbol(leadSym)}</span>}
                </a>
              );
            })}
            <a href="/category/equities/" class="report-date-pill font-mono tabular-nums tracking-tight" title="Browse full equities report archive">
              Archive &rarr;
            </a>
          </div>
        )}
      </div>

      <!-- 2. 12-Column Asymmetric Desktop Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 max-w-[1440px] mx-auto px-4">
