---
// Fetch all AI markdown files using standard Vite globbing
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true }));

// Sort them from newest to oldest
posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Market Farm</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background-color: #111827;
        color: #f9fafb;
        max-width: 700px;
        margin: 0 auto;
        padding: 2rem;
      }
      h1 { color: #10b981; }
      .post {
        background-color: #1f2937;
        padding: 1.5rem;
        border-radius: 8px;
        margin-top: 2rem;
        border-left: 4px solid #10b981;
      }
      a {
        color: #3b82f6;
        text-decoration: none;
        font-weight: bold;
      }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <h1>📈 Market Movers Daily</h1>
    <p>Automated market intelligence and breakout tracking.</p>

    {posts.length === 0 ? (
      <p>No market updates yet. The bot is resting...</p>
    ) : (
      posts.map(post => (
        <div class="post">
          <post.Content />
        </div>
      ))
    )}
  </body>
</html>
