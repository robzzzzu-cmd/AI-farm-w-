---
import MarketTicker from '../components/MarketTicker.astro';

interface StockItem {
  ticker: string;
  price: string;
  change_amount?: string;
  change_percentage: string;
  volume: string;
}

interface MarkdownPost {
  frontmatter: {
    title?: string;
    description?: string;
    date?: string;
    displayDate?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    gainers?: StockItem[];
    losers?: StockItem[];
    active?: StockItem[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
}

const rawPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as MarkdownPost[];
const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);

const displayGainers = featuredPost?.frontmatter?.gainers || [];
const displayLosers = featuredPost?.frontmatter?.losers || [];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Trade Opportunities // Financial Intelligence & Market Signals</title>
    <meta name="bitmedia-site-verification" content="07522f1ef9d6b60ae5363fe10b37f8c5" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <style is:inline>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --bg-page: #0b0e14;
        --bg-surface: #111622;
        --bg-surface-elevated: #161d2d;
        --border-subtle: #1e2638;
        --border-strong: #2d374d;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --brand-accent: #3b82f6;
        --gain-color: #22c55e;
        --gain-bg: rgba(34, 197, 94, 0.1);
        --loss-color: #ef4444;
        --loss-bg: rgba(239, 68, 68, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.25);
      }

      *, *::before, *::after { 
        box-sizing: border-box; 
        margin: 0; 
        padding: 0; 
      }
      html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
      }

      .app-wrapper {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.25rem;
        box-sizing: border-box;
      }

      /* Navigation */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
        width: 100%;
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 58px;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-shrink: 0;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .logo-glyph {
        width: 14px;
        height: 14px;
        background: var(--brand-accent);
        border-radius: 3px;
        flex-shrink: 0;
      }
      .nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        outline: none;
        width: 180px;
        box-sizing: border-box;
      }
      .search-input:focus { border-color: var(--brand-accent); }

      .ad-leaderboard {
        margin: 1.5rem auto 0.5rem auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.75rem;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
      }
      .ad-label {
        font-size: 0.625rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
      }

      .hero-section {
        padding: 1.75rem 0 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border-subtle);
        margin-bottom: 2rem;
        gap: 1rem;
      }
      .hero-left h1 {
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
        word-break: break-word;
      }
      .hero-left p { font-size: 0.9rem; color: var(--text-secondary); }
      
      .scanning-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.3rem 0.65rem;
        border-radius: 4px;
        white-space: nowrap;
      }
      .scanning-dot {
        width: 7px;
        height: 7px;
        background-color: var(--gain-color);
        border-radius: 50%;
        animation: pulseFade 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }
      @keyframes pulseFade {
        0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
        50% { opacity: 0.2; box-shadow: 0 0 0 rgba(34, 197, 94, 0); }
      }

      .section-label {
        font-size: 0.78125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }
      .grid-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        width: 100%;
      }

      .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.35rem;
        box-shadow: var(--card-shadow);
        box-sizing: border-box;
        width: 100%;
        overflow: hidden;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .pill {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .pill-gain { background: var(--gain-bg); color: var(--gain-color); border-color: transparent; }
      .pill-loss { background: var(--loss-bg); color: var(--loss-color); border-color: transparent; }
      
      .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.65rem;
        word-break: break-word;
      }
      .card-body {
        font-size: 0.875rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0.75rem 0 1.25rem 0;
      }
      .card-body p { margin-bottom: 0.6rem; }
      .card-body ul { padding-left: 1.25rem; margin-bottom: 0.6rem; list-style-type: disc; }
      .card-body li { margin-bottom: 0.45rem; color: var(--text-secondary); }
      .card-body strong { color: var(--text-primary); font-weight: 600; }
      .card-body a { color: var(--brand-accent); text-decoration: none; font-weight: 600; }
      .card-body a:hover { text-decoration: underline; }

      .card-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: var(--brand-accent);
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8125rem;
        padding: 0.6rem 0.85rem;
        border-radius: 5px;
        margin-top: 0.75rem;
        transition: opacity 0.15s;
        box-sizing: border-box;
      }
      .card-action-btn:hover { opacity: 0.9; }

      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-accent);
        background: var(--bg-surface-elevated);
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        border: 1px solid var(--border-subtle);
        text-decoration: none;
      }

      .stream-list { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
      .stream-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1rem;
        box-sizing: border-box;
        width: 100%;
      }
      .stream-title { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; word-break: break-word; }
      .stream-date { font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.25rem; }

      .table-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 2.5rem;
        width: 100%;
        box-sizing: border-box;
      }
      .data-table {
        width: 100%;
        min-width: 540px;
        border-collapse: collapse;
        font-size: 0.8125rem;
        text-align: left;
      }
      .data-table th {
        background: var(--bg-surface-elevated);
        color: var(--text-muted);
        font-size: 0.725rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        white-space: nowrap;
      }
      .data-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .table-symbol { font-weight: 700; color: var(--text-primary); font-family: var(--font-mono); }
      .table-gain { color: var(--gain-color); font-weight: 600; font-family: var(--font-mono); }
      .table-loss { color: var(--loss-color); font-weight: 600; font-family: var(--font-mono); }

      .swap-and-ads-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        width: 100%;
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 3.5rem;
        width: 100%;
      }
      .tool-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-sizing: border-box;
        width: 100%;
      }
      .tool-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin-bottom: 0.35rem;
      }
      .tool-name { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; }
      .tool-desc { font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78125rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        padding: 0.45rem 0.75rem;
        border-radius: 4px;
        box-sizing: border-box;
      }
      .tool-btn:hover { background: var(--brand-accent); color: #fff; border-color: var(--brand-accent); }

      .newsletter-box {
        background: linear-gradient(180deg, var(--bg-surface-elevated) 0%, var(--bg-surface) 100%);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.5rem;
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        box-sizing: border-box;
        width: 100%;
      }
      .newsletter-input-group {
        display: flex;
        gap: 0.5rem;
      }
      .newsletter-input {
        background: var(--bg-page);
        border: 1px solid var(--border-strong);
        color: var(--text-primary);
        font-size: 0.8125rem;
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        outline: none;
        box-sizing: border-box;
      }

      /* Legal & Risk Disclaimer Footer */
      footer {
        border-top: 1px solid var(--border-subtle);
        padding: 2.5rem 0 2rem;
        font-size: 0.78125rem;
        color: var(--text-muted);
        width: 100%;
      }
      .disclosure-box {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-left: 3px solid var(--brand-accent);
        border-radius: 4px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
        box-sizing: border-box;
      }
      .disclosure-box strong { color: var(--text-primary); }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .footer-links {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
      }
      .footer-links a { color: var(--text-secondary); text-decoration: none; }
      .footer-links a:hover { color: var(--text-primary); }

      /* Cookie Banner */
      .cookie-banner {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        max-width: 500px;
        margin: 0 auto;
        background: #0b0e14;
        border: 1px solid #1e2638;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        z-index: 9999;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        box-sizing: border-box;
      }
      .cookie-banner.hidden { display: none; }
      .cookie-content { display: flex; flex-direction: column; gap: 0.75rem; }
      .cookie-content p { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.4; }
      .cookie-content a { color: var(--brand-accent); text-decoration: underline; }
      .cookie-actions { display: flex; gap: 0.5rem; }
      .cookie-btn {
        padding: 0.4rem 0.85rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: opacity 0.2s;
      }
      .cookie-btn.accept { background: var(--brand-accent); color: #fff; }
      .cookie-btn.decline { background: var(--bg-surface-elevated); color: var(--text-secondary); }

      @media (max-width: 860px) {
        .grid-main, .swap-and-ads-grid { grid-template-columns: 1fr; }
        .hero-section { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .nav-links { display: none; }
        .newsletter-box { flex-direction: column; align-items: flex-start; }
      }

      @media (max-width: 560px) {
        .app-wrapper { padding: 0 0.85rem; }
        .nav-inner { flex-direction: column; align-items: stretch; padding: 0.6rem 0; }
        .brand-group { width: 100%; justify-content: space-between; }
        .nav-actions { width: 100%; }
        .search-input { width: 100%; }
        .newsletter-box { padding: 1.15rem; }
        .newsletter-input-group { flex-direction: column; width: 100%; }
        .newsletter-input, #subscribe-btn { width: 100%; }
        .card { padding: 1rem; }
      }
    </style>
  </head>
  <body>
    <!-- Live Automated Ticker Ribbon Component -->
    <MarketTicker />

    <nav class="top-nav">
      <div class="app-wrapper nav-inner">
        <div class="brand-group">
          <a href="/" class="logo">
            <span class="logo-glyph"></span>
            TRADE OPPORTUNITIES
          </a>
          <ul class="nav-links">
            <li><a href="#intelligence" class="active">Intelligence</a></li>
            <li><a href="#movers">Market Movers</a></li>
            <li><a href="#terminal">Order Terminal</a></li>
            <li><a href="#tools">Platforms</a></li>
          </ul>
        </div>
        <div class="nav-actions">
          <input type="text" id="filter-input" class="search-input" placeholder="Filter tickers..." />
        </div>
      </div>
    </nav>

    <div class="app-wrapper">
      <!-- Sponsored Leaderboard (A-ADS) -->
      <div class="ad-leaderboard">
        <span class="ad-label">Sponsored Intelligence</span>
        <div style="width: 100%; margin: auto; position: relative;">
          <iframe 
            data-aa="2453491" 
            src="//acceptable.a-ads.com/2453491/?size=Adaptive&background_color=111622" 
            style="border: 0; padding: 0; width: 100%; max-width: 728px; height: 90px; overflow: hidden; display: block; margin: auto;"
            loading="lazy">
          </iframe>
        </div>
      </div>

      <header class="hero-section">
        <div class="hero-left">
          <h1>Market Intelligence Feed</h1>
          <p>Automated quantitative tracking of high-momentum equity breakouts and volume divergences.</p>
        </div>
        <div class="hero-right">
          <div class="scanning-badge">
            <div class="scanning-dot"></div>
            <span>LIVE SCAN</span>
          </div>
        </div>
      </header>

      <!-- Section 01: Dispatches (Render Clean Content) -->
      <section id="intelligence">
        <div class="section-label">01 // Recent Dispatches</div>
        <div class="grid-main">
          {featuredPost ? (
            <article class="card dispatch-card" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div class="card-meta">
                  <span class="pill pill-gain">{featuredPost.frontmatter.category || 'Equities'}</span>
                  <span style="font-family: var(--font-mono);">{featuredPost.frontmatter.displayDate || featuredPost.frontmatter.date?.slice(0, 10)}</span>
                </div>
                <h2 class="card-title">{featuredPost.frontmatter.title}</h2>
                
                <div class="card-body">
                  <featuredPost.Content />
                </div>
              </div>
              
              <div>
                {featuredPost.frontmatter.tickers && (
                  <div class="ticker-tags">
                    {featuredPost.frontmatter.tickers.map((t: string) => (
                      <a href={`https://www.tradingview.com/symbols/${t}/?aff_id=170147`} target="_blank" rel="noopener noreferrer" class="ticker-pill">
                        ${t}
                      </a>
                    ))}
                  </div>
                )}

                <a href={featuredPost.frontmatter.refUrl || "https://www.tradingview.com/?aff_id=170147"} 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="card-action-btn">
                  {featuredPost.frontmatter.refLabel || "Analyze Lead Mover on TradingView"} &rarr;
                </a>
              </div>
            </article>
          ) : (
            <div class="card">
              <p style="color: var(--text-secondary);">Initializing scan sequence. Next batch will populate at US market open.</p>
            </div>
          )}

          <div class="stream-list">
            {secondaryPosts.map(post => (
              <article class="stream-item dispatch-card">
                <div class="stream-date">{post.frontmatter.displayDate || post.frontmatter.date?.slice(0, 10)}</div>
                <h3 class="stream-title">{post.frontmatter.title}</h3>
                <div class="card-body" style="font-size: 0.8rem; margin: 0.35rem 0 0.5rem 0;">
                  <post.Content />
                </div>
                <a href={post.frontmatter.refUrl || "https://www.tradingview.com/?aff_id=170147"} 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   style="display: inline-block; font-size: 0.75rem; font-weight: 600; color: var(--brand-accent); text-decoration: none;">
                  {post.frontmatter.refLabel || "View Chart"} &rarr;
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 02: Real Live Stock Percentages & Breakouts Table -->
      <section id="movers">
        <div class="section-label">02 // Monitored Breakouts (Alpha Vantage Feed)</div>
        <div class="table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Asset</th>
                <th>Price</th>
                <th>Change (%)</th>
                <th>Session Volume</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {displayGainers.length > 0 ? (
                <>
                  {displayGainers.map((stock: StockItem) => (
                    <tr>
                      <td class="table-symbol">${stock.ticker}</td>
                      <td>${parseFloat(stock.price).toFixed(2)}</td>
                      <td class="table-gain">+{parseFloat(stock.change_percentage).toFixed(2)}%</td>
                      <td>{Number(stock.volume).toLocaleString()}</td>
                      <td>
                        <a href={`https://www.tradingview.com/symbols/${stock.ticker}/?aff_id=170147`} target="_blank" rel="noopener noreferrer" style="color: var(--brand-accent); text-decoration: none; font-weight: 600;">
                          Analyze Chart &rarr;
                        </a>
                      </td>
                    </tr>
                  ))}
