          <!-- 2.2 Inline Email Capture Strip (Between Top 3 Cards and Table) -->
          <div id="alerts" class="newsletter-strip bg-[#111726] border border-[#38BDF8]/30 rounded-lg p-3 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="newsletter-copy">
