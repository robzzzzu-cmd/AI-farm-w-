      .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.35rem;
        box-shadow: var(--card-shadow);
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .pill {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .pill-gain { background: var(--gain-bg); color: var(--gain-color); border-color: transparent; }
      
      .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.85rem;
      }

      .card-body {
        font-size: 0.885rem;
        color: var(--text-secondary);
        line-height: 1.65;
        word-break: break-word;
      }
      .card-body p { margin-bottom: 0.9rem; }
      .card-body a { color: var(--brand-accent); text-decoration: none; font-weight: 600; }
