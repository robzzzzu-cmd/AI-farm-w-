        </div>
        <div class="hero-right">
          <div class="scanning-badge">
            <div class="scanning-dot"></div>
            <span>LIVE SCAN</span>
          </div>
        </div>
      </header>

      <!-- Section 01: Dispatches -->
      <section id="intelligence">
        <div class="section-label">01 // Recent Dispatches</div>
        <div class="grid-main">
          {featuredPost ? (
            <article class="card dispatch-card">
              <div class="card-meta">
                <span class="pill pill-gain">{featuredPost.frontmatter.category || 'Breakout'}</span>
                <span style="font-family: var(--font-mono);">{featuredPost.frontmatter.displayDate || featuredPost.frontmatter.date?.slice(0, 10)}</span>
              </div>
              <h2 class="card-title">{featuredPost.frontmatter.title}</h2>
              <div class="card-body">
                <featuredPost.Content />
              </div>
              
              {featuredPost.frontmatter.tickers && (
                <div class="ticker-tags">
                  {featuredPost.frontmatter.tickers.map((t: string) => (
                    <span class="ticker-pill">${t}</span>
                  ))}
                </div>
              )}

              <a href={featuredPost.frontmatter.refUrl || `https://www.tradingview.com/symbols/${featuredPost.frontmatter.leadTicker}/?aff_id=170147`} 
                 target="_blank" 
                 rel="noopener noreferrer" 
                 class="card-action-btn">
                {featuredPost.frontmatter.refLabel || "Open Chart Analysis"} &rarr;
              </a>
            </article>
          ) : (
            <div class="card">
              <p style="color: var(--text-secondary);">Initializing scan sequence. Next batch will populate at market open.</p>
            </div>
          )}

          <div class="stream-list">
            {secondaryPosts.map(post => (
              <article class="stream-item dispatch-card">
                <div class="stream-date">{post.frontmatter.displayDate || post.frontmatter.date?.slice(0, 10)}</div>
                <h3 class="stream-title">{post.frontmatter.title}</h3>
                <div style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.4; margin-top: 0.35rem;">
                  <post.Content />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 02: Dynamic Breakouts Table -->
      <section id="movers">
        <div class="section-label">02 // Active Market Movers (Live Feed)</div>
        <div class="table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Ticker</th>
                <th>Price</th>
                <th>Change (%)</th>
                <th>Session Volume</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {displayGainers.map((stock: StockItem) => (
                <tr>
                  <td class="table-symbol">${stock.ticker}</td>
                  <td>${parseFloat(stock.price).toFixed(2)}</td>
                  <td class="table-gain">+{parseFloat(stock.change_percentage).toFixed(2)}%</td>
                  <td>{Number(stock.volume).toLocaleString()}</td>
                  <td>
                    <a href={`https://www.tradingview.com/symbols/${stock.ticker}/?aff_id=170147`} target="_blank" rel="noopener noreferrer" style="color: var(--brand-accent); text-decoration: none; font-weight: 600;">
                      Analyze &rarr;
                    </a>
                  </td>
                </tr>
              ))}
              {displayLosers.slice(0, 2).map((stock: StockItem) => (
                <tr>
                  <td class="table-symbol">${stock.ticker}</td>
                  <td>${parseFloat(stock.price).toFixed(2)}</td>
                  <td class="table-loss">{parseFloat(stock.change_percentage).toFixed(2)}%</td>
                  <td>{Number(stock.volume).toLocaleString()}</td>
                  <td>
                    <a href={`https://www.tradingview.com/symbols/${stock.ticker}/?aff_id=170147`} target="_blank" rel="noopener noreferrer" style="color: var(--brand-accent); text-decoration: none; font-weight: 600;">
                      Analyze &rarr;
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 03: TradingView Verified Embeds -->
      <section id="technical-gauge" style="margin-bottom: 2.5rem;">
        <div class="section-label">03 // Broad Market Momentum Gauges</div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem;">
          
          <!-- QQQ Gauge -->
          <div class="card tv-card-container">
            <div class="tradingview-widget-container" style="height:100%;width:100%">
              <div class="tradingview-widget-container__widget" style="height:calc(100% - 32px);width:100%"></div>
              <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-technical-analysis.js" async is:inline>
              {
                "interval": "1D",
                "width": "100%",
                "isTransparent": true,
                "height": "100%",
                "symbol": "NASDAQ:QQQ",
                "showIntervalTabs": true,
                "displayMode": "single",
                "locale": "en",
                "colorTheme": "dark"
              }
              </script>
            </div>
          </div>

          <!-- SPY Gauge -->
          <div class="card tv-card-container">
            <div class="tradingview-widget-container" style="height:100%;width:100%">
              <div class="tradingview-widget-container__widget" style="height:calc(100% - 32px);width:100%"></div>
              <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-technical-analysis.js" async is:inline>
              {
                "interval": "1D",
                "width": "100%",
                "isTransparent": true,
                "height": "100%",
                "symbol": "AMEX:SPY",
                "showIntervalTabs": true,
                "displayMode": "single",
                "locale": "en",
                "colorTheme": "dark"
              }
              </script>
            </div>
          </div>

        </div>
      </section>

      <!-- Section 04: Monetization Grid -->
      <section id="tools">
        <div class="section-label">04 // Analytical Workstations & Liquidity</div>
        <div class="tools-grid">
          <div class="tool-card">
            <div>
              <span class="tool-badge">Institutional Charting</span>
              <h3 class="tool-name">TradingView Pro</h3>
              <p class="tool-desc">Multi-timeframe volume profiles, automated pattern recognition, and Pine Script indicators.</p>
            </div>
            <a href="https://www.tradingview.com/?aff_id=170147" target="_blank" rel="noopener noreferrer" class="tool-btn">
              Open Workstation &rarr;
            </a>
          </div>

          <div class="tool-card">
            <div>
              <span class="tool-badge">Funded Accounts</span>
              <h3 class="tool-name">Proprietary Trading</h3>
              <p class="tool-desc">Trade institutional capital allocations with up to 90% profit splits across equity and index futures.</p>
            </div>
            <a href="https://ftmo.com/?aff_id=YOUR_ID" target="_blank" rel="noopener noreferrer" class="tool-btn">
              View Evaluations &rarr;
            </a>
          </div>

          <div class="tool-card">
            <div>
              <span class="tool-badge">Non-Custodial Swaps</span>
              <h3 class="tool-name">ChangeNOW</h3>
              <p class="tool-desc">Frictionless cross-chain spot asset settlements without registration limits.</p>
            </div>
            <a href="https://changenow.app.link/referral?link_id=1c434a8e93e8ff" target="_blank" rel="noopener noreferrer" class="tool-btn">
              Execute Orders &rarr;
            </a>
          </div>
        </div>
      </section>

      <footer>
        <div class="footer-links">
          <a href="terms">Terms of Service</a>
          <a href="privacy">Privacy Policy</a>
        </div>
        <div>&copy; 2026 Trade Opportunities. All rights reserved.</div>
        <p style="margin-top: 0.5rem; font-size: 0.725rem;">
          Informational intelligence only. Does not constitute investment advice.
        </p>
      </footer>
    </div>

    <script is:inline>
      const filterInput = document.getElementById('filter-input');
      if (filterInput) {
        filterInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase();
          const cards = document.querySelectorAll('.dispatch-card');
          cards.forEach((card) => {
            const text = card.innerText.toLowerCase();
            card.style.display = text.includes(query) ? '' : 'none';
          });
        });
      }
    </script>
  </body>
</html>
