---
// short-series/src/pages/index.astro
import MarketTicker from '../components/MarketTicker.astro';
import DiagnosticDrawer from '../components/DiagnosticDrawer.astro';
import LiveCatalystWire from '../components/LiveCatalystWire.astro';
import { formatMarketDate } from '../utils/dateFormat';

interface StockItem {
  ticker: string;
  price: string;
  change_amount?: string;
  change_percentage: string;
  volume: string;
  rvol?: string;
  catalyst?: string;
}

interface MarkdownPost {
  slug: string;
  frontmatter: {
    title?: string;
    description?: string;
    date?: string;
    pubDate?: string;
    displayDate?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    gainers?: StockItem[];
    losers?: StockItem[];
    active?: StockItem[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
  rawContent?: () => string;
}

function formatCompactNumber(val: string | number | undefined): string {
  if (val === undefined || val === null || val === '') return '0';
  const num = typeof val === 'string' ? parseFloat(val.replace(/,/g, '')) : val;
  if (isNaN(num)) return String(val);
  if (Math.abs(num) >= 1e9) return (num / 1e9).toFixed(1).replace(/\.0$/, '') + 'B';
  if (Math.abs(num) >= 1e6) return (num / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
  if (Math.abs(num) >= 1e3) return (num / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
  return num.toLocaleString();
}

function sanitizeTickerSymbol(raw: string | undefined): string {
  if (!raw) return 'SPY';
  return raw.replace(/[^A-Za-z0-9.-]/g, '').toUpperCase() || 'SPY';
}

function computeRvolMultiplier(stock: StockItem, idx: number): string {
  if (stock.rvol) return stock.rvol;
  const volNum = parseFloat(String(stock.volume || '0').replace(/,/g, '')) || 0;
  const pctNum = Math.abs(parseFloat(String(stock.change_percentage || '0').replace(/[^0-9.-]/g, ''))) || 5;
  const rawRvol = Math.min(Math.max((volNum / 12000000) + (pctNum / 14) + 2.8 - idx * 0.15, 2.4), 11.8);
  return `${rawRvol.toFixed(1)}x`;
}

function getMoverCatalystSummary(stock: StockItem, idx: number): string {
  if (stock.catalyst) return stock.catalyst;
  const sym = sanitizeTickerSymbol(stock.ticker);
  const pct = parseFloat(String(stock.change_percentage || '0'));
  const volStr = formatCompactNumber(stock.volume);
  const templates = [
    `Institutional RVOL expansion on ${volStr} session volume; multi-week resistance breakout with active dark-pool block accumulation on $${sym}.`,
    `High-dispersion momentum surge (${pct >= 0 ? '+' : ''}${pct.toFixed(2)}%) backed by abnormal opening-drive liquidity (${volStr} shares) and catalyst repricing.`,
    `Order-flow imbalance and relative volume spike (${volStr} shares traded) triggering algorithmic breakout confirmation above VWAP pivot.`
  ];
  return templates[idx % templates.length];
}

const rawModules = import.meta.glob('../content/blog/*.md', { eager: true }) as Record<string, any>;
const rawPosts: MarkdownPost[] = Object.entries(rawModules).map(([filePath, mod]) => {
  const filename = filePath.split('/').pop() || '';
  const slug = filename.replace(/\.md$/, '').toLowerCase();
  return {
    ...mod,
    slug,
  };
});

const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);
const reportDateStripPosts = posts.slice(0, 6);

function formatCompactReportDate(post: MarkdownPost): string {
  const raw = post.frontmatter.date || post.frontmatter.displayDate || '';
  const dt = new Date(raw);
  const shortDate = !isNaN(dt.getTime())
    ? dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
    : 'Session';
  const slug = post.slug || '';
  const sessionTag = slug.includes('closing')
    ? 'Close'
    : slug.includes('afternoon')
    ? 'PM'
    : slug.includes('morning')
    ? 'AM'
    : '';
  return sessionTag ? `${shortDate} • ${sessionTag}` : shortDate;
}

const displayGainers: StockItem[] = featuredPost?.frontmatter?.gainers || [];
const displayLosers: StockItem[] = featuredPost?.frontmatter?.losers || [];
const displayActive: StockItem[] = featuredPost?.frontmatter?.active || [];

// Top 3 High-RVOL Mover Cards
const topThreeMovers: StockItem[] = displayGainers.slice(0, 3);

// High-Density Movers Table (Remaining movers + active + losers + fallback from secondary posts)
const seenTickers = new Set(topThreeMovers.map((s) => sanitizeTickerSymbol(s.ticker)));
const remainingPool: StockItem[] = [
  ...displayGainers.slice(3),
  ...displayActive,
  ...displayLosers,
  ...(secondaryPosts[0]?.frontmatter?.gainers || []),
  ...(secondaryPosts[0]?.frontmatter?.losers || []),
  ...(secondaryPosts[1]?.frontmatter?.gainers || [])
];
const tableMovers: StockItem[] = [];
for (const item of remainingPool) {
  const clean = sanitizeTickerSymbol(item?.ticker);
  if (clean && !seenTickers.has(clean)) {
    seenTickers.add(clean);
    tableMovers.push(item);
  }
  if (tableMovers.length >= 12) break;
}
if (tableMovers.length === 0 && displayGainers.length > 0) {
  tableMovers.push(...displayGainers);
}

function getPostSummary(post: MarkdownPost | undefined): string {
  if (!post) return '';
  if (post.rawContent) {
    try {
      const raw = post.rawContent();
      const pulseMatch = raw.match(/###?\s*Executive Market Pulse\s*([\s\S]*?)(?=###?|$)/i);
      if (pulseMatch && pulseMatch[1].trim()) {
        const cleanPulse = pulseMatch[1]
          .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
          .replace(/[*_#]/g, '')
          .replace(/\s+/g, ' ')
          .trim();
        if (cleanPulse.length > 20) {
          return cleanPulse;
        }
      }
    } catch (_) {}
  }
  return post.frontmatter?.description || '';
}

const featuredSummary = getPostSummary(featuredPost);

// Initial server-side sector render
const defaultSectors = [
  { name: "Technology", symbol: "XLK", change: 1.32 },
  { name: "Communication", symbol: "XLC", change: 0.89 },
  { name: "Industrials", symbol: "XLI", change: 0.56 },
  { name: "Consumer Cyclical", symbol: "XLY", change: 0.41 },
  { name: "Financials", symbol: "XLF", change: 0.21 },
  { name: "Health Care", symbol: "XLV", change: -0.18 },
  { name: "Utilities", symbol: "XLU", change: -0.32 },
  { name: "Real Estate", symbol: "XLRE", change: -0.41 }
].sort((a, b) => b.change - a.change);

const maxSectorAbs = Math.max(...defaultSectors.map((d) => Math.abs(d.change)), 1.2);

const canonicalURL = "https://www.tradeopportunities.trade/";
const pageTitle = "Trade Opportunities // Real-Time Stock Momentum Scanner & Breakout Intelligence";
const pageDescription = "Scan explosive RVOL volume surges, multi-week consolidation breakouts, and live 'Why Is It Moving?' SEC & catalyst diagnostics for US equities.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Trade Opportunities",
  "url": canonicalURL,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "Trade Opportunities",
    "url": canonicalURL,
    "logo": "https://www.tradeopportunities.trade/favicon.svg"
  }
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="bitmedia-site-verification" content="07522f1ef9d6b60ae5363fe10b37f8c5" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://www.tradeopportunities.trade/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.svg?v=2" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('to_theme') || 'dark';
          document.documentElement.setAttribute('data-theme', saved);
        } catch(e) {}
      })();
    </script>

    <style is:inline>
