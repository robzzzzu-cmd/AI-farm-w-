        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --bg-page: #090D16;
        --bg-surface: #111726;
        --bg-surface-elevated: #1A2234;
        --border-subtle: #1E293B;
        --border-strong: #334155;
        --text-primary: #F8FAFC;
        --text-secondary: #94A3B8;
        --text-muted: #64748B;
        --brand-accent: #38BDF8;
        --gain-color: #10B981;
        --gain-bg: rgba(16, 185, 129, 0.1);
        --loss-color: #F43F5E;
        --loss-bg: rgba(244, 63, 94, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.35);
        --sidebar-width: 270px;
        --nav-height: 56px;
      }

      [data-theme="light"] {
        --bg-page: #f0f2f5;
        --bg-surface: #ffffff;
        --bg-surface-elevated: #e5e8ed;
        --border-subtle: #d0d5dd;
        --border-strong: #98a2b3;
        --text-primary: #111827;
        --text-secondary: #4b5563;
        --text-muted: #667085;
        --brand-accent: #0284c7;
        --gain-color: #10B981;
        --gain-bg: rgba(16, 185, 129, 0.12);
        --loss-color: #F43F5E;
        --loss-bg: rgba(244, 63, 94, 0.12);
        --card-shadow: 0 2px 8px -2px rgba(16, 24, 40, 0.08), 0 1px 4px -1px rgba(16, 24, 40, 0.04);
      }

      *, *::before, *::after { 
        box-sizing: border-box; 
        margin: 0; 
        padding: 0; 
      }
      
      html {
        scroll-behavior: smooth;
        overflow-x: clip;
        width: 100%;
        max-width: 100%;
      }

      section[id], div[id] {
        scroll-margin-top: calc(var(--nav-height) + 48px);
      }

      body {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        position: relative;
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      img, iframe, embed, object {
        max-width: 100%;
      }

      /* Precision Dark-Mode Terminal & Tailwind Utility Support (REVAMP_RULES.md) */
      .font-sans { font-family: var(--font-sans); }
      .font-mono { font-family: var(--font-mono); }
      .tabular-nums { font-variant-numeric: tabular-nums; }
      .tracking-tight { letter-spacing: -0.015em; }
      .antialiased { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
      .selection\:bg-sky-500\/20 ::selection,
      .selection\:bg-sky-500\/20::selection {
        background-color: rgba(14, 165, 233, 0.2);
        color: #7dd3fc;
      }

      .bg-\[\#090D16\] { background-color: #090D16; }
      .bg-\[\#111726\] { background-color: #111726; }
      .bg-\[\#111726\]\/90 { background-color: rgba(17, 23, 38, 0.9); }
      .bg-\[\#1A2234\] { background-color: #1A2234; }
      .hover\:bg-\[\#1A2234\]:hover { background-color: #1A2234; }

      .text-white { color: #FFFFFF; }
      .text-\[\#F8FAFC\] { color: #F8FAFC; }
      .text-\[\#94A3B8\] { color: #94A3B8; }
      .text-\[\#10B981\] { color: #10B981; }
      .text-\[\#F43F5E\] { color: #F43F5E; }
      .text-\[\#38BDF8\] { color: #38BDF8; }
      .text-\[\#F59E0B\] { color: #F59E0B; }

      .bg-\[\#10B981\]\/10 { background-color: rgba(16, 185, 129, 0.1); }
      .border-\[\#10B981\]\/20 { border-color: rgba(16, 185, 129, 0.2); }
      .bg-\[\#F43F5E\]\/10 { background-color: rgba(244, 63, 94, 0.1); }
      .border-\[\#F43F5E\]\/20 { border-color: rgba(244, 63, 94, 0.2); }
      .bg-\[\#38BDF8\]\/10 { background-color: rgba(56, 189, 248, 0.1); }
      .bg-\[\#F59E0B\]\/10 { background-color: rgba(245, 158, 11, 0.1); }
      .border-\[\#F59E0B\]\/20 { border: 1px solid rgba(245, 158, 11, 0.2); }
      .border-\[\#38BDF8\]\/20 { border-color: rgba(56, 189, 248, 0.2); }
      .border-\[\#38BDF8\]\/30 { border-color: rgba(56, 189, 248, 0.3); }
      .bg-\[\#F59E0B\]\/10 { background-color: rgba(245, 158, 11, 0.1); }
      .border-\[\#F59E0B\]\/20 { border-color: rgba(245, 158, 11, 0.2); }

      .border { border-width: 1px; border-style: solid; }
      .border-b { border-bottom-width: 1px; border-bottom-style: solid; }
      .border-t { border-top-width: 1px; border-top-style: solid; }
      .border-\[\#1E293B\] { border-color: #1E293B; }
      .border-\[\#1E293B\]\/60 { border-color: rgba(30, 41, 59, 0.6); }
      .hover\:border-slate-700:hover { border-color: #334155; }
      .focus\:border-\[\#38BDF8\]:focus { border-color: #38BDF8 !important; }

      .max-w-\[1440px\] { max-width: 1440px; }
      .max-w-\[65ch\] { max-width: 65ch; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .my-2 { margin-top: 0.5rem; margin-bottom: 0.5rem; }
      .px-4 { padding-left: 1rem; padding-right: 1rem; }
      .px-3 { padding-left: 0.75rem; padding-right: 0.75rem; }
      .px-1\.5 { padding-left: 0.375rem; padding-right: 0.375rem; }
      .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
      .py-1\.5 { padding-top: 0.375rem; padding-bottom: 0.375rem; }
      .py-0\.5 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
      .pt-4 { padding-top: 1rem; }
      .pb-2 { padding-bottom: 0.5rem; }
      .pb-16 { padding-bottom: 4rem; }
      .p-3 { padding: 0.75rem; }
      .p-3\.5 { padding: 0.875rem; }
      .p-4 { padding: 1rem; }

      .h-9 { height: 36px; }
      .h-14 { height: 56px; }
      .text-xs { font-size: 0.75rem; line-height: 1rem; }
      .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
      .text-base { font-size: 1rem; line-height: 1.5rem; }
      .text-\[11px\] { font-size: 11px; line-height: 1.2; }
      .font-bold { font-weight: 700; }
      .leading-\[1\.65\] { line-height: 1.65; }
      .rounded { border-radius: 0.25rem; }
      .rounded-md { border-radius: 0.375rem; }
      .rounded-lg { border-radius: 0.5rem; }
      .transition-all { transition: all 0.15s ease; }
      .transition-colors { transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
      .duration-150 { transition-duration: 150ms; }
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .flex { display: flex; }
      .flex-col { flex-direction: column; }
      .items-center { align-items: center; }
      .justify-between { justify-content: space-between; }
      .gap-3 { gap: 0.75rem; }
      .gap-5 { gap: 1.25rem; }
      .space-y-4 > * + * { margin-top: 1rem; }

      .grid { display: grid; }
      .grid-cols-1 { grid-template-columns: minmax(0, 1fr); }

      .sticky { position: sticky; }
      .fixed { position: fixed; }
      .top-0 { top: 0; }
      .bottom-0 { bottom: 0; }
      .inset-x-0 { left: 0; right: 0; }
      .z-40 { z-index: 40; }
      .z-50 { z-index: 50; }
      .backdrop-blur-md { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }

      @media (min-width: 640px) {
        .sm\:flex-row { flex-direction: row; }
      }
      @media (min-width: 768px) {
        .md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .md\:pb-0 { padding-bottom: 0 !important; }
        .md\:hidden { display: none !important; }
      }
      @media (min-width: 1024px) {
        .lg\:grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
        .lg\:col-span-8 { grid-column: span 8 / span 8; }
        .lg\:col-span-4 { grid-column: span 4 / span 4; }
      }

      .app-wrapper {
        width: 100%;
        max-width: 1440px;
        min-width: 0;
        margin: 0 auto;
        padding: 0 1rem;
        box-sizing: border-box;
      }

      /* Side Dashboard Drawer */
      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 10000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }
      .sidebar-backdrop.active {
        opacity: 1;
        visibility: visible;
      }

      .side-dashboard {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--bg-surface);
        border-right: 1px solid var(--border-subtle);
        z-index: 10001;
        display: flex;
        flex-direction: column;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 6px 0 28px rgba(0, 0, 0, 0.45);
        overflow-y: auto;
      }
      .side-dashboard.open {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--text-primary);
      }
      .sidebar-close-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        line-height: 1;
      }
      .sidebar-close-btn:hover {
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
      }

      .sidebar-body {
        flex: 1;
        padding: 1rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
      }
      .sidebar-search-wrap {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
      }
      .sidebar-group-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 0 0.5rem;
      }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .sidebar-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: all 0.15s ease;
      }
      .sidebar-nav-item:hover {
        background: var(--bg-surface-elevated);
        color: var(--text-primary);
      }
      .sidebar-nav-item.active {
        background: var(--bg-surface-elevated);
        color: var(--brand-accent);
        font-weight: 600;
        border-left: 3px solid var(--brand-accent);
      }
      .sidebar-icon {
        width: 16px;
        height: 16px;
        color: var(--text-muted);
        flex-shrink: 0;
        transition: color 0.2s ease;
      }
      .sidebar-nav-item:hover .sidebar-icon, .sidebar-nav-item.active .sidebar-icon {
        color: var(--brand-accent);
      }

      /* Tier 2 Command Navbar (h-14 = 56px) */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 40;
        height: 56px;
        min-height: 56px;
        max-height: 56px;
        background: rgba(17, 23, 38, 0.9);
        border-bottom: 1px solid #1E293B;
        width: 100%;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      [data-theme="light"] .top-nav {
        background: rgba(255, 255, 255, 0.92);
        border-bottom-color: var(--border-subtle);
      }
      a:focus-visible,
      button:focus-visible,
      input:focus-visible {
        outline: 2px solid var(--brand-accent);
        outline-offset: 2px;
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 56px;
        min-height: 56px;
        flex-wrap: nowrap;
        gap: 1rem;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-shrink: 0;
      }
      .dashboard-toggle-btn {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #F8FAFC;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.65rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .dashboard-toggle-btn:hover {
        background: #1A2234;
        border-color: #38BDF8;
      }
      .dashboard-toggle-btn svg {
        width: 14px;
        height: 14px;
        color: #38BDF8;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .logo-glyph {
        width: 12px;
        height: 12px;
        background: var(--brand-accent);
        border-radius: 3px;
        flex-shrink: 0;
      }
      .nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #94A3B8;
        transition: color 0.15s ease;
        position: relative;
        padding: 0.25rem 0;
      }
      .nav-links a:hover {
        color: #F8FAFC;
      }
      .nav-links a.active {
        color: #38BDF8;
        font-weight: 600;
      }
      .nav-links a.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: #38BDF8;
        border-radius: 2px;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-left: auto;
        flex-shrink: 0;
      }
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
      }
      .search-icon {
        position: absolute;
        left: 0.65rem;
        width: 13px;
        height: 13px;
        color: #64748B;
        pointer-events: none;
      }
      .search-input {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #F8FAFC;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem 0.375rem 1.85rem;
        border-radius: 0.375rem;
        outline: none;
        width: 190px;
        box-sizing: border-box;
        transition: border-color 0.15s ease;
      }
      .search-input:focus { border-color: #38BDF8; }

      .icon-action-btn {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #94A3B8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .icon-action-btn:hover {
        color: #F8FAFC;
        background: #1A2234;
        border-color: #38BDF8;
      }

      /* Compact 1-Line Workspace Header */
      .workspace-header {
        border-bottom: 1px solid #1E293B;
        margin-bottom: 1rem;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .workspace-title-group {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }
      .workspace-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        color: #10B981;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.04em;
      }
      .workspace-heading {
        font-size: 0.95rem;
        font-weight: 700;
        color: #F8FAFC;
        letter-spacing: -0.015em;
      }
      .workspace-date-pills {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .workspace-date-pills::-webkit-scrollbar { display: none; }
      .report-date-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.18rem 0.5rem;
        border-radius: 4px;
        background: #111726;
        border: 1px solid #1E293B;
        color: #94A3B8;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.68rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.15s ease;
      }
      .report-date-pill:hover {
        color: #F8FAFC;
        border-color: #38BDF8;
        background: #1A2234;
      }
      .report-date-pill.latest {
        background: rgba(56, 189, 248, 0.1);
        border-color: rgba(56, 189, 248, 0.25);
        color: #F8FAFC;
      }
      .report-pill-badge {
        background: #38BDF8;
        color: #090D16;
        font-size: 0.58rem;
        font-weight: 800;
        padding: 0.04rem 0.3rem;
        border-radius: 3px;
        text-transform: uppercase;
      }
      .report-pill-ticker {
        color: #38BDF8;
        font-weight: 700;
      }

      /* Left 8-Column Momentum Matrix */
      .matrix-section-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }
      .matrix-section-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #94A3B8;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }
      .matrix-section-title::before {
        content: '';
        width: 3px;
        height: 12px;
        background: #38BDF8;
        border-radius: 2px;
      }
      .matrix-section-meta {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.68rem;
        color: #64748B;
      }

      /* Top 3 High-RVOL Mover Cards */
      .mover-card {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.5rem;
        padding: 0.875rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.15s ease;
      }
      .mover-card:hover {
        border-color: #334155;
        background: #141c2e;
      }
      .mover-row-1 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.35rem;
        flex-wrap: wrap;
      }
      .mover-symbol-group {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;
      }
      .mover-ticker-link {
        text-decoration: none;
        color: #FFFFFF;
      }
      .mover-ticker-link:hover {
        color: #38BDF8;
      }
      .mover-badges-group {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }
      .delta-pill {
        font-size: 11px;
        font-weight: 700;
        padding: 0.125rem 0.4rem;
        border-radius: 0.25rem;
      }
      .mover-row-3 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.55rem;
        border-top: 1px solid rgba(30, 41, 59, 0.7);
        font-size: 0.72rem;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
      }
      .mover-audit-link {
        color: #38BDF8;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      .mover-audit-link:hover {
        text-decoration: underline;
      }
      .mover-chart-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }
      .mover-why-trigger {
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.2);
        color: #38BDF8;
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.1rem 0.38rem;
        border-radius: 3px;
        cursor: pointer;
      }
      .mover-why-trigger:hover {
        background: #38BDF8;
        color: #090D16;
      }
      .mover-tv-link {
        color: #94A3B8;
        text-decoration: none;
        font-weight: 500;
      }
      .mover-tv-link:hover {
        color: #F8FAFC;
      }

      /* Inline Email Capture Strip */
      .newsletter-strip {
        background: #111726;
        border: 1px solid rgba(56, 189, 248, 0.3);
        border-radius: 0.5rem;
        padding: 0.75rem 0.9rem;
      }
      .newsletter-copy {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: #F8FAFC;
      }
      .newsletter-bolt {
        color: #38BDF8;
        font-size: 0.9rem;
        flex-shrink: 0;
      }
      .newsletter-input-group {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
      }
      .newsletter-input {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #F8FAFC;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.4rem 0.65rem;
        border-radius: 0.375rem;
        outline: none;
        width: 210px;
      }
      .newsletter-input:focus {
        border-color: #38BDF8;
      }
      .newsletter-submit-btn {
        background: #38BDF8;
        color: #090D16;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.42rem 0.75rem;
        border-radius: 0.375rem;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition: opacity 0.15s ease;
      }
      .newsletter-submit-btn:hover {
        opacity: 0.9;
      }

      /* High-Density Movers Table */
      .high-density-table-wrap {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.5rem;
        overflow: hidden;
      }
      .high-density-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }
      .high-density-table th {
        background: #090D16;
        color: #94A3B8;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid #1E293B;
        white-space: nowrap;
      }
      .high-density-table th.num-col,
      .high-density-table td.num-col {
        text-align: right;
      }
      .high-density-table th.action-col,
      .high-density-table td.action-col {
        text-align: right;
      }
      .mover-table-row td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid rgba(30, 41, 59, 0.6);
        vertical-align: middle;
      }
      .mover-table-row:last-child td {
        border-bottom: none;
      }
      .mover-table-row:hover {
        background-color: #1A2234;
      }
      .table-ticker-link {
        color: #F8FAFC;
        font-weight: 700;
        text-decoration: none;
      }
      .table-ticker-link:hover {
        color: #38BDF8;
      }
      .table-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.35rem;
      }
      .table-action-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        padding: 0.16rem 0.45rem;
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 600;
        color: #38BDF8;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.2);
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .table-action-pill:hover {
        background: #38BDF8;
        color: #090D16;
      }

      /* Mobile (< 768px): Collapse each table row into a 2-line flex card with zero horizontal overflow */
      @media (max-width: 767px) {
        .high-density-table thead {
          display: none;
        }
        .high-density-table,
        .high-density-table tbody {
          display: block;
          width: 100%;
        }
        .mover-table-row {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          padding: 0.6rem 0.75rem;
          gap: 0.35rem 0.5rem;
          border-bottom: 1px solid rgba(30, 41, 59, 0.6);
        }
        .mover-table-row td {
          padding: 0;
          border: none;
          display: inline-flex;
          align-items: center;
        }
        .mover-table-row td.cell-ticker {
          order: 1;
          font-size: 0.85rem;
        }
        .mover-table-row td.cell-price {
          order: 2;
          margin-left: 0.35rem;
        }
        .mover-table-row td.cell-delta {
          order: 3;
          margin-left: auto;
        }
        .mover-table-row td.cell-vol {
          order: 4;
          width: 48%;
          color: #94A3B8;
          font-size: 0.68rem;
        }
        .mover-table-row td.cell-rvol {
          order: 5;
        }
        .mover-table-row td.cell-actions {
          order: 6;
          margin-left: auto;
        }
      }

      /* Right 4-Column AI Intelligence & Context Rail */
      .briefing-pinned-card {
        background: #111726;
        border: 1px solid #1E293B;
        border-top: 2px solid #38BDF8;
        border-radius: 0.5rem;
        padding: 1rem;
      }
      .briefing-meta-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.55rem;
        flex-wrap: wrap;
      }
      .ai-badge-pill {
        font-family: var(--font-mono);
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.14rem 0.45rem;
        border-radius: 4px;
        color: #38BDF8;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.2);
      }
      .briefing-timestamp {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.68rem;
        color: #94A3B8;
      }
      .briefing-headline {
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.35;
        color: #F8FAFC;
        margin-bottom: 0.5rem;
      }
      .briefing-headline a {
        color: inherit;
        text-decoration: none;
      }
      .briefing-headline a:hover {
        color: #38BDF8;
      }
      .briefing-summary {
        font-size: 0.75rem;
        line-height: 1.65;
        color: #94A3B8;
        max-width: 65ch;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 0.65rem;
      }
      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin-bottom: 0.75rem;
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.68rem;
        font-weight: 600;
        color: #38BDF8;
        background: #090D16;
        padding: 0.12rem 0.42rem;
        border-radius: 4px;
        border: 1px solid #1E293B;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .ticker-pill:hover {
        border-color: #38BDF8;
        background: #1A2234;
      }
      .briefing-cta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.6rem;
        border-top: 1px solid #1E293B;
      }
      .read-briefing-cta {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        color: #38BDF8;
        text-decoration: none;
      }
      .read-briefing-cta:hover {
        text-decoration: underline;
      }

      /* Secondary Dispatches List in Right Rail */
      .secondary-briefs-list {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        margin-top: 0.65rem;
      }
      .secondary-brief-item {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.4rem;
        padding: 0.6rem 0.75rem;
        transition: background-color 0.15s ease, border-color 0.15s ease;
      }
      .secondary-brief-item:hover {
        background: #1A2234;
        border-color: #334155;
      }
      .secondary-brief-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.65rem;
        color: #64748B;
        margin-bottom: 0.2rem;
      }
      .secondary-brief-title {
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.35;
        color: #F8FAFC;
      }
      .secondary-brief-title a {
        color: inherit;
        text-decoration: none;
      }
      .secondary-brief-title a:hover {
        color: #38BDF8;
      }

      .feed-filter-empty {
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        color: #94A3B8;
        font-size: 0.75rem;
      }
      .feed-filter-reset-btn {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #38BDF8;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        cursor: pointer;
      }

      /* Compact Sector Pulse Card in Right Rail */
      .sector-card {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.5rem;
        padding: 0.875rem;
      }
      .sector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.55rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid #1E293B;
      }
      .sector-title {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94A3B8;
      }
      .sector-context-note {
        font-size: 0.65rem;
        color: #64748B;
        font-family: var(--font-mono);
      }
      .sector-table {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .sector-row {
        display: grid;
        grid-template-columns: 115px 1fr 56px;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
      }
      .sector-name {
        color: #94A3B8;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sector-bar-bg {
        height: 5px;
        background: #090D16;
        border-radius: 3px;
        overflow: hidden;
      }
      .sector-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.5s ease-out;
      }
      .sector-bar-fill.pos { background: #10B981; }
      .sector-bar-fill.neg { background: #F43F5E; }
      .sector-val {
        text-align: right;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        font-size: 0.72rem;
      }
      .val-pos { color: #10B981; }
      .val-neg { color: #F43F5E; }
      .sector-footer-note {
        margin-top: 0.55rem;
        padding-top: 0.45rem;
        border-top: 1px solid #1E293B;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.65rem;
        color: #64748B;
      }
      .sector-footer-note a {
        color: #38BDF8;
        text-decoration: none;
        font-weight: 600;
      }

      /* Below-the-Fold Methodology & Quick-Try Section */
      .below-fold-wrap {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #1E293B;
      }
      .hero-repositioned {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.5rem;
        padding: 1.15rem 1.25rem;
        margin-bottom: 1.5rem;
      }
      .persona-selector-wrap {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 0.65rem;
      }
      .persona-label {
        font-size: 0.65rem;
        font-family: var(--font-mono);
        font-weight: 700;
        color: #38BDF8;
        letter-spacing: 0.06em;
      }
      .persona-pills {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      .persona-pill-btn {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #94A3B8;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .persona-pill-btn.active {
        background: rgba(56, 189, 248, 0.1);
        border-color: #38BDF8;
        color: #F8FAFC;
      }
      .pill-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #64748B;
      }
      .persona-pill-btn.active .pill-dot {
        background: #38BDF8;
      }
      .hero-headline {
        font-size: 1.05rem;
        font-weight: 700;
        color: #F8FAFC;
        margin-bottom: 0.35rem;
      }
      .hero-subheadline {
        font-size: 0.8rem;
        color: #94A3B8;
        line-height: 1.55;
        max-width: 65ch;
      }
      .hero-instant-chips-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
        padding-top: 0.65rem;
        border-top: 1px solid #1E293B;
      }
      .chips-label {
        font-size: 0.68rem;
        font-family: var(--font-mono);
        color: #64748B;
        font-weight: 600;
      }
      .instant-chips-list {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
      }
      .hero-chip-btn {
        background: #090D16;
        border: 1px solid #1E293B;
        color: #94A3B8;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.18rem 0.5rem;
        border-radius: 4px;
        cursor: pointer;
      }
      .hero-chip-btn:hover {
        color: #38BDF8;
        border-color: #38BDF8;
      }

      /* Tools & Footer */
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0.85rem;
        margin-bottom: 2rem;
      }
      .tool-card {
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 0.5rem;
        padding: 0.95rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tool-badge {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #38BDF8;
        margin-bottom: 0.25rem;
      }
      .tool-name { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.2rem; color: #F8FAFC; }
      .tool-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.75rem; line-height: 1.45; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 600;
        text-decoration: none;
        color: #F8FAFC;
        background: #090D16;
        border: 1px solid #1E293B;
        padding: 0.38rem 0.65rem;
        border-radius: 4px;
        transition: all 0.15s ease;
      }
      .tool-btn:hover { background: #1A2234; border-color: #38BDF8; color: #38BDF8; }

      footer {
        border-top: 1px solid #1E293B;
        padding: 2rem 0;
        font-size: 0.75rem;
        color: #64748B;
      }
      .disclosure-box {
        background: #111726;
        border: 1px solid #1E293B;
        border-left: 3px solid #38BDF8;
        border-radius: 4px;
        padding: 0.85rem 1rem;
        margin-bottom: 1.25rem;
        line-height: 1.55;
      }
      .disclosure-box strong { color: #F8FAFC; }
      .footer-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .footer-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-links a { color: #94A3B8; text-decoration: none; }
      .footer-links a:hover { color: #F8FAFC; }

      /* Mobile Bottom Bar (h-14 = 56px, 4 equal thumb tabs) */
      .mobile-bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 50;
        height: 56px;
        background: #111726;
        border-top: 1px solid #1E293B;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        align-items: center;
      }
      .mobile-tab-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        height: 100%;
        color: #94A3B8;
        font-size: 0.68rem;
        font-weight: 600;
        text-decoration: none;
      }
      .mobile-tab-item.active,
      .mobile-tab-item:hover {
        color: #38BDF8;
        background: rgba(26, 34, 52, 0.5);
      }

      .back-to-top-btn {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #1A2234;
        border: 1px solid #1E293B;
        color: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.25s ease;
        z-index: 999;
      }
      .back-to-top-btn.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .cookie-banner {
        position: fixed;
        bottom: 4.25rem;
        left: 1rem;
        right: 1rem;
        max-width: 500px;
        margin: 0 auto;
        background: #111726;
        border: 1px solid #1E293B;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        z-index: 9999;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
      }
      .cookie-banner.hidden { display: none; }
      .cookie-content { display: flex; flex-direction: column; gap: 0.75rem; }
      .cookie-content p { font-size: 0.8125rem; color: #94A3B8; line-height: 1.4; }
      .cookie-content a { color: #38BDF8; text-decoration: underline; }
      .cookie-actions { display: flex; gap: 0.5rem; }
      .cookie-btn {
        padding: 0.4rem 0.85rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
      }
      .cookie-btn.accept { background: #38BDF8; color: #090D16; }
      .cookie-btn.decline { background: #1A2234; color: #94A3B8; }

      @media (max-width: 900px) {
        .nav-links { display: none; }
      }
      @media (max-width: 767px) {
        .logo { font-size: 0.9rem; }
        .dashboard-toggle-btn span { display: none; }
        .search-input { width: 135px; font-size: 0.7rem; }
        .newsletter-input-group { width: 100%; }
        .newsletter-input { flex: 1; width: auto; }
        .back-to-top-btn { bottom: 4.5rem; right: 1rem; }
      }
    </style>
  </head>
