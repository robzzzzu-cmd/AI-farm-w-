            if (p && personaHeadlines[p] && hEl && sEl) {
              hEl.textContent = personaHeadlines[p].headline;
              sEl.textContent = personaHeadlines[p].subheadline;
            }
          });
        });

        // Quick Try Chips
        const chipBtns = document.querySelectorAll('.hero-chip-btn');
        chipBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const ticker = btn.getAttribute('data-ticker');
            if (!ticker) return;
            try {
              const raw = localStorage.getItem('to_watchlist_v1');
              let list = raw ? JSON.parse(raw) : [];
              if (!list.some((item) => (typeof item === 'string' ? item : item.ticker) === ticker)) {
                list.unshift({
                  ticker: ticker,
                  triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
                });
                localStorage.setItem('to_watchlist_v1', JSON.stringify(list));
              }
            } catch(e) {}
            window.location.href = '/screener#watchlist-matrix';
          });
        });
      })();
    </script>

