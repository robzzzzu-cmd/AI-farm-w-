---
interface StockItem {
  ticker: string;
  price: string;
  change_amount?: string;
  change_percentage: string;
  volume: string;
}

interface MarkdownPost {
  frontmatter: {
    title?: string;
    date?: string;
    displayDate?: string;
    category?: string;
    leadTicker?: string;
    leadGain?: string;
    tickers?: string[];
    gainers?: StockItem[];
    losers?: StockItem[];
    active?: StockItem[];
    refUrl?: string;
    refLabel?: string;
  };
  Content: any;
}

const rawPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as MarkdownPost[];
const posts = rawPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || 0).valueOf();
  const dateB = new Date(b.frontmatter.date || 0).valueOf();
  return dateB - dateA;
});

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);

// Fallback logic so the table renders immediately before the next automated scan
const fallbackGainers: StockItem[] = (featuredPost?.frontmatter?.tickers || ['QQQ', 'SPY', 'NVDA']).map((sym, idx) => ({
  ticker: sym,
  price: idx === 0 ? "485.50" : idx === 1 ? "562.10" : "128.30",
  change_percentage: idx === 0 ? (featuredPost?.frontmatter?.leadGain?.replace('+', '').replace('%', '') || "2.85") : "1.65",
  volume: "35400000"
}));

const displayGainers = (featuredPost?.frontmatter?.gainers && featuredPost.frontmatter.gainers.length > 0)
  ? featuredPost.frontmatter.gainers
  : fallbackGainers;

const displayLosers = featuredPost?.frontmatter?.losers || [];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trade Opportunities // Financial Intelligence & Market Signals</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <style is:inline>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --bg-page: #0b0e14;
        --bg-surface: #111622;
        --bg-surface-elevated: #161d2d;
        --border-subtle: #1e2638;
        --border-strong: #2d374d;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --brand-accent: #3b82f6;
        --gain-color: #22c55e;
        --gain-bg: rgba(34, 197, 94, 0.1);
        --loss-color: #ef4444;
        --loss-bg: rgba(239, 68, 68, 0.1);
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.25);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .app-wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .top-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg-page);
        border-bottom: 1px solid var(--border-subtle);
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 58px;
      }
      .brand-group {
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--text-primary);
      }
      .logo-glyph {
        width: 14px;
        height: 14px;
        background: var(--brand-accent);
        border-radius: 3px;
      }
      .nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .search-input {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.8125rem;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        outline: none;
        width: 180px;
      }
      .search-input:focus { border-color: var(--brand-accent); }

      .ad-leaderboard {
        margin: 1.5rem auto 0.5rem auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.75rem;
      }
      .ad-label {
        font-size: 0.625rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
      }

      .hero-section {
        padding: 1.75rem 0 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border-subtle);
        margin-bottom: 2rem;
      }
      .hero-left h1 {
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
      }
      .hero-left p { font-size: 0.9rem; color: var(--text-secondary); }
      
      .scanning-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.3rem 0.65rem;
        border-radius: 4px;
      }
      .scanning-dot {
        width: 7px;
        height: 7px;
        background-color: var(--gain-color);
        border-radius: 50%;
        animation: pulseFade 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }
      @keyframes pulseFade {
        0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(34, 197, 94, 0.7); }
        50% { opacity: 0.2; box-shadow: 0 0 0 rgba(34, 197, 94, 0); }
      }

      .section-label {
        font-size: 0.78125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }
      .grid-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.35rem;
        box-shadow: var(--card-shadow);
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .pill {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .pill-gain { background: var(--gain-bg); color: var(--gain-color); border-color: transparent; }
      .pill-loss { background: var(--loss-bg); color: var(--loss-color); border-color: transparent; }
      
      .card-title {
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-bottom: 0.65rem;
      }
      .card-body {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.55;
        margin-bottom: 1.25rem;
      }
      .card-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: var(--brand-accent);
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8125rem;
        padding: 0.6rem 0.85rem;
        border-radius: 5px;
        margin-top: 0.75rem;
        transition: opacity 0.15s;
      }
      .card-action-btn:hover { opacity: 0.9; }

      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-accent);
        background: var(--bg-surface-elevated);
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        border: 1px solid var(--border-subtle);
      }

      .stream-list { display: flex; flex-direction: column; gap: 0.75rem; }
      .stream-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 0.9rem 1rem;
      }
      .stream-title { font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem; }
      .stream-date { font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-muted); }

      .table-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow-x: auto;
        margin-bottom: 2.5rem;
      }
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8125rem;
        text-align: left;
      }
      .data-table th {
        background: var(--bg-surface-elevated);
        color: var(--text-muted);
        font-size: 0.725rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .data-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
      }
      .table-symbol { font-weight: 700; color: var(--text-primary); font-family: var(--font-mono); }
      .table-gain { color: var(--gain-color); font-weight: 600; font-family: var(--font-mono); }
      .table-loss { color: var(--loss-color); font-weight: 600; font-family: var(--font-mono); }

      .tv-card-container {
        min-height: 420px;
        height: 420px;
        position: relative;
        overflow: hidden;
      }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 3.5rem;
      }
      .tool-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tool-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin-bottom: 0.35rem;
      }
      .tool-name { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; }
      .tool-desc { font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78125rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        padding: 0.45rem 0.75rem;
        border-radius: 4px;
      }
      .tool-btn:hover { background: var(--brand-accent); color: #fff; border-color: var(--brand-accent); }

      footer {
        border-top: 1px solid var(--border-subtle);
        padding: 2rem 0;
        font-size: 0.78125rem;
        color: var(--text-muted);
      }
      .footer-links {
        display: flex;
        gap: 1.25rem;
        margin-bottom: 0.75rem;
      }
      .footer-links a { color: var(--text-secondary); text-decoration: none; }
      .footer-links a:hover { color: var(--text-primary); }

      @media (max-width: 860px) {
        .grid-main { grid-template-columns: 1fr; }
        .hero-section { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .nav-links { display: none; }
      }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <div class="app-wrapper nav-inner">
        <div class="brand-group">
          <a href="#" class="logo">
            <span class="logo-glyph"></span>
            TRADE OPPORTUNITIES
          </a>
          <ul class="nav-links">
            <li><a href="#intelligence" class="active">Intelligence</a></li>
            <li><a href="#movers">Market Movers</a></li>
            <li><a href="#technical-gauge">Technicals</a></li>
            <li><a href="#tools">Platforms</a></li>
          </ul>
        </div>
        <div class="nav-actions">
          <input type="text" id="filter-input" class="search-input" placeholder="Filter tickers..." />
        </div>
      </div>
    </nav>

    <div class="app-wrapper">
      <!-- Sponsored Leaderboard -->
      <div class="ad-leaderboard">
        <span class="ad-label">Sponsored Intelligence</span>
        <div style="width: 100%; margin: auto; position: relative;">
          <iframe 
            data-aa="2453491" 
            src="//acceptable.a-ads.com/2453491/?size=Adaptive&background_color=111622" 
            style="border: 0; padding: 0; width: 100%; max-width: 728px; height: 90px; overflow: hidden; display: block; margin: auto;"
            loading="lazy">
          </iframe>
        </div>
      </div>

      <header class="hero-section">
        <div class="hero-left">
          <h1>Market Intelligence Feed</h1>
