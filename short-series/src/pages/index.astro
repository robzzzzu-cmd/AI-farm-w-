        <div class="lg:col-span-8 space-y-4">
          <!-- 2.1 Top 3 High-RVOL Mover Cards -->
          <div>
            <div class="matrix-section-bar">
              <span class="matrix-section-title">Top 3 High-RVOL Leaders</span>
              <span class="matrix-section-meta font-mono tabular-nums tracking-tight">5-LAYER CAUSAL ATTRIBUTION</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              {topThreeMovers.map((stock: StockItem, idx: number) => {
                const cleanSym = sanitizeTickerSymbol(stock.ticker);
                const priceNum = parseFloat(String(stock.price || '0'));
                const pctNum = parseFloat(String(stock.change_percentage || '0'));
                const isPos = pctNum >= 0;
                const pctFormatted = `${isPos ? '+' : ''}${pctNum.toFixed(2)}%`;
                const rvolBadge = computeRvolMultiplier(stock, idx);
                const catalystText = getMoverCatalystSummary(stock, idx);

                return (
                  <article class="mover-card bg-[#111726] border border-[#1E293B] hover:border-slate-700 rounded-lg p-3.5 transition-all">
                    <div>
                      <!-- Row 1: $TICKER + Price + % Change pill + RVOL badge -->
                      <div class="mover-row-1">
                        <div class="mover-symbol-group">
                          <a href={`/ticker/${cleanSym.toLowerCase()}/`} class="mover-ticker-link text-base font-bold font-mono tabular-nums tracking-tight text-white">
                            ${cleanSym}
                          </a>
                          <span class="font-mono tabular-nums tracking-tight text-sm text-[#F8FAFC]">
                            ${priceNum.toFixed(2)}
                          </span>
                        </div>

                        <div class="mover-badges-group">
                          <span class:list={[
                            'delta-pill font-mono tabular-nums tracking-tight',
                            isPos
                              ? 'text-[#10B981] bg-[#10B981]/10 border border-[#10B981]/20'
                              : 'text-[#F43F5E] bg-[#F43F5E]/10 border border-[#F43F5E]/20'
                          ]}>
                            {pctFormatted}
                          </span>
                          <span class="text-[#38BDF8] bg-[#38BDF8]/10 border border-[#38BDF8]/20 font-mono tabular-nums tracking-tight text-[11px] px-1.5 py-0.5 rounded">
                            {rvolBadge}
                          </span>
                        </div>
                      </div>

                      <!-- Row 2: 2-line clamped AI Catalyst summary -->
                      <p class="text-xs text-[#94A3B8] line-clamp-2 my-2">
                        {catalystText}
                      </p>
                    </div>

                    <!-- Row 3 (Footer): 5-Layer Audit -> and TV Chart -> -->
                    <div class="mover-row-3 font-mono tabular-nums tracking-tight">
                      <a href={`/ticker/${cleanSym.toLowerCase()}/`} class="mover-audit-link">
                        5-Layer Audit &rarr;
                      </a>
                      <div class="mover-chart-actions">
                        <button
                          type="button"
                          class="mover-why-trigger font-mono tabular-nums"
                          data-open-diagnostic={cleanSym}
                          data-price={priceNum.toFixed(2)}
                          data-delta={stock.change_percentage}
                          data-volume={stock.volume}
                          data-rvol={rvolBadge}
                          title={`Open 5-Layer Diagnostic for $${cleanSym}`}
                        >
                          Why?
                        </button>
                        <a
                          href={`https://www.tradingview.com/symbols/${cleanSym}/?aff_id=170147`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mover-tv-link"
                          title={`Open $${cleanSym} on TradingView`}
                        >
                          TV Chart &nearr;
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
