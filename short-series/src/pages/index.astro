      .big-screener-cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.45);
        filter: brightness(1.08);
      }
      .big-screener-cta-btn:active {
        transform: translateY(0);
      }

      .card-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        background: var(--brand-accent);
        color: #ffffff !important;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8125rem;
        padding: 0.65rem 0.85rem;
        border-radius: 5px;
        margin-top: 1rem;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .card-action-btn:hover {
        opacity: 0.92;
        transform: translateY(-1px);
      }

      .ticker-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
      }
      .ticker-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-accent);
        background: var(--bg-surface-elevated);
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        border: 1px solid var(--border-subtle);
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .ticker-pill:hover {
        border-color: var(--brand-accent);
        background: var(--bg-surface);
        transform: translateY(-1px);
      }

      .stream-list { display: flex; flex-direction: column; gap: 0.75rem; }
      .stream-item {
        background: #14151b;
        border: 1px solid #232630;
        border-radius: 6px;
        padding: 1.1rem;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .stream-item:hover {
        border-color: #353b4b;
        background: #181a24;
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
      }
      [data-theme="light"] .stream-item {
        background: #ffffff;
        border: 1px solid var(--border-subtle);
      }
      [data-theme="light"] .stream-item:hover {
        border-color: var(--border-strong);
        background: #ffffff;
        box-shadow: var(--card-shadow);
      }
      .stream-title { 
        font-size: 0.875rem; 
        font-weight: 600; 
        margin-bottom: 0.4rem; 
      }
      .stream-title a {
        transition: color 0.15s ease;
      }
      .stream-title a:hover {
        color: var(--brand-accent) !important;
      }
      .stream-body {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .stream-body table,
      .stream-body h4,
      .stream-body h3,
      .stream-body h2 {
        display: none !important;
      }
      .stream-date { font-size: 0.6875rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.35rem; }

      .back-to-top-btn {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: opacity 0.25s ease, transform 0.25s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        z-index: 999;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
      }
      .back-to-top-btn.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .back-to-top-btn:hover {
        background: var(--brand-accent);
        color: #ffffff;
        border-color: var(--brand-accent);
        transform: translateY(-2px);
      }

      /* Table Card */
      .table-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        overflow-x: auto;
        margin-bottom: 2.5rem;
      }
      .data-table {
        width: 100%;
        min-width: 540px;
        border-collapse: collapse;
        font-size: 0.8125rem;
        text-align: left;
      }
      .data-table th {
        background: var(--bg-surface-elevated);
        color: var(--text-muted);
        font-size: 0.725rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        white-space: nowrap;
      }
      .data-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .data-table tbody tr {
        transition: background-color 0.15s ease;
      }
      .data-table tbody tr:hover {
        background-color: var(--bg-surface-elevated);
      }
      .table-symbol { font-weight: 700; color: var(--text-primary); font-family: var(--font-mono); }
      .table-gain { color: var(--gain-color); font-weight: 600; font-family: var(--font-mono); }
      .table-loss { color: var(--loss-color); font-weight: 600; font-family: var(--font-mono); }
      .table-vol { font-family: var(--font-mono); color: var(--text-secondary); }

      /* Section 03 Tools Split Layout */
      .tools-split-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 1.5rem;
        align-items: stretch;
      }

      .sector-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.15rem;
        box-shadow: var(--card-shadow);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .sector-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
      }
      .sector-title {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
      }
      .sector-context-note {
        font-size: 0.7rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
      }
      .sector-table {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin: 0.4rem 0;
      }
      .sector-row {
        display: grid;
        grid-template-columns: 135px 1fr 65px;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
      }
      .sector-name {
        color: var(--text-secondary);
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sector-bar-bg {
        height: 6px;
        background: var(--bg-surface-elevated);
        border-radius: 3px;
        overflow: hidden;
      }
      .sector-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.5s ease-out;
      }
      .sector-bar-fill.pos { background: var(--gain-color); }
      .sector-bar-fill.neg { background: var(--loss-color); }
      .sector-val {
        text-align: right;
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.78125rem;
      }
      .val-pos { color: var(--gain-color); }
      .val-neg { color: var(--loss-color); }

      .sector-footer-note {
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
      }
      .sector-footer-note a {
        color: var(--brand-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .sector-footer-note a:hover { text-decoration: underline; }

      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 3.5rem;
      }
      .tool-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .tool-card:hover {
        border-color: var(--border-strong);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
      }
      .tool-badge {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--brand-accent);
        margin-bottom: 0.35rem;
      }
      .tool-name { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; }
      .tool-desc { font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.45; }
      .tool-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78125rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        padding: 0.45rem 0.75rem;
        border-radius: 4px;
        transition: all 0.2s ease;
      }
      .tool-btn:hover { background: var(--brand-accent); color: #fff; border-color: var(--brand-accent); transform: translateY(-1px); }

      .newsletter-box {
        background: linear-gradient(180deg, var(--bg-surface-elevated) 0%, var(--bg-surface) 100%);
        border: 1px solid var(--border-subtle);
        border-radius: 6px;
        padding: 1.5rem;
        margin-bottom: 2.5rem;
