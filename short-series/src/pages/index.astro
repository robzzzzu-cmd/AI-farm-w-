    <script is:inline>
      // 1. Live Client-Side Sector Poller with Direct Browser Scan & API Fallback
      (function initRealSectorAnalytics() {
        const sectorList = [
          { name: 'Technology', symbol: 'XLK', ticker: 'AMEX:XLK' },
          { name: 'Communication', symbol: 'XLC', ticker: 'AMEX:XLC' },
          { name: 'Industrials', symbol: 'XLI', ticker: 'AMEX:XLI' },
          { name: 'Consumer Cyclical', symbol: 'XLY', ticker: 'AMEX:XLY' },
          { name: 'Financials', symbol: 'XLF', ticker: 'AMEX:XLF' },
          { name: 'Health Care', symbol: 'XLV', ticker: 'AMEX:XLV' },
          { name: 'Utilities', symbol: 'XLU', ticker: 'AMEX:XLU' },
          { name: 'Real Estate', symbol: 'XLRE', ticker: 'AMEX:XLRE' }
        ];

        function renderRows(rows) {
          if (!Array.isArray(rows) || rows.length === 0) return;
          const container = document.getElementById('live-sector-table');
          const statusEl = document.getElementById('sector-status');
          const footerStatus = document.getElementById('sector-footer-status');

          if (container) {
            const maxAbs = Math.max(...rows.map((d) => Math.abs(d.change)), 1.0);

            container.innerHTML = rows.map((item) => {
              const isPos = item.change >= 0;
              const widthPct = Math.min(Math.max((Math.abs(item.change) / maxAbs) * 100, 6), 100);
              const sign = isPos ? '+' : '';

              return `
                <div class="sector-row font-mono tabular-nums tracking-tight">
                  <span class="sector-name font-sans" title="${item.symbol}">${item.name}</span>
                  <div class="sector-bar-bg">
                    <div class="sector-bar-fill ${isPos ? 'pos' : 'neg'}" style="width: ${widthPct.toFixed(1)}%;"></div>
                  </div>
                  <span class="sector-val font-mono tabular-nums tracking-tight ${isPos ? 'val-pos' : 'val-neg'}">${sign}${item.change.toFixed(2)}%</span>
                </div>
              `;
            }).join('');
          }

          if (statusEl) statusEl.textContent = 'S&P 500 • Live';
          if (footerStatus) footerStatus.textContent = 'Synced • SPDR® ETFs';
        }

        async function fetchLiveSectors() {
          try {
            const tvRes = await fetch('https://scanner.tradingview.com/america/scan', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                symbols: { tickers: sectorList.map((s) => s.ticker) },
                columns: ['name', 'change']
              })
            });

            if (tvRes.ok) {
              const tvJson = await tvRes.json();
              const tvData = tvJson?.data || [];
              if (tvData.length > 0) {
                const parsed = sectorList.map((sec) => {
                  const match = tvData.find((r) => r.s === sec.ticker);
                  const change = typeof match?.d?.[1] === 'number' ? parseFloat(match.d[1].toFixed(2)) : 0.0;
                  return { name: sec.name, symbol: sec.symbol, change };
                });
                parsed.sort((a, b) => b.change - a.change);
                renderRows(parsed);
                return;
              }
            }
          } catch (_) {}

          try {
            const apiRes = await fetch('/api/sectors');
            if (apiRes.ok) {
              const apiJson = await apiRes.json();
              if (Array.isArray(apiJson?.data) && apiJson.data.length > 0) {
                renderRows(apiJson.data);
              }
            }
          } catch (_) {}
        }

        fetchLiveSectors();
        setInterval(fetchLiveSectors, 45000);
      })();

      // 2. Side Dashboard Drawer & Smooth Link Navigation
      (function initDashboardDrawer() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        const closeBtn = document.getElementById('sidebar-close-btn');
        const sidebar = document.getElementById('side-dashboard');
        const backdrop = document.getElementById('sidebar-backdrop');

        function openSidebar() {
          sidebar?.classList.add('open');
          backdrop?.classList.add('active');
        }

        function closeSidebar() {
          sidebar?.classList.remove('open');
          backdrop?.classList.remove('active');
        }

        toggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          openSidebar();
        });

        closeBtn?.addEventListener('click', closeSidebar);
        backdrop?.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
            closeSidebar();
          }
        });

        const sidebarLinks = sidebar?.querySelectorAll('a[href^="#"]');
        sidebarLinks?.forEach((link) => {
          link.addEventListener('click', (e) => {
            const targetId = link.getAttribute('href');
            if (targetId && targetId !== '#') {
              const targetEl = document.querySelector(targetId);
              if (targetEl) {
                e.preventDefault();
                closeSidebar();
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.pushState(null, '', targetId);
              }
            }
          });
        });

        const topNavLinks = document.querySelectorAll('.nav-links a[href^="#"]');
        topNavLinks.forEach((link) => {
          link.addEventListener('click', (e) => {
            const targetId = link.getAttribute('href');
            if (targetId && targetId !== '#') {
              const targetEl = document.querySelector(targetId);
              if (targetEl) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.pushState(null, '', targetId);
              }
            }
          });
        });
      })();

      // 3. Light / Dark Mode Toggle
      (function initThemeToggle() {
        const themeBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-icon-sun');
        const moonIcon = document.getElementById('theme-icon-moon');

        const savedTheme = localStorage.getItem('to_theme') || 'dark';
        applyTheme(savedTheme);

        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'light') {
            if (sunIcon) sunIcon.style.display = 'none';
            if (moonIcon) moonIcon.style.display = 'block';
          } else {
            if (sunIcon) sunIcon.style.display = 'block';
            if (moonIcon) moonIcon.style.display = 'none';
          }
          localStorage.setItem('to_theme', theme);
        }

        themeBtn?.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const nextTheme = current === 'dark' ? 'light' : 'dark';
          applyTheme(nextTheme);
        });
      })();

      // 4. Compact Markdown Table Expander
      (function initTableFormatters() {
        const featuredCard = document.querySelector('.dispatch-card');
        if (!featuredCard) return;

        let targetTable = featuredCard.querySelector('table');

        if (targetTable) {
          let insertAnchor = targetTable;
          if (targetTable.parentElement && !targetTable.parentElement.classList.contains('table-responsive-wrapper')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper';
            targetTable.parentNode.insertBefore(wrapper, targetTable);
            wrapper.appendChild(targetTable);
            insertAnchor = wrapper;
          }

          const rows = targetTable.querySelectorAll('tbody tr');
          if (rows.length > 2) {
            rows.forEach((row, i) => {
              if (i >= 2) row.classList.add('table-row-hidden');
            });

            const toggleBtn = document.createElement('button');
            toggleBtn.type = 'button';
            toggleBtn.className = 'toggle-table-btn';
            toggleBtn.innerHTML = '<span>Show More Rows</span> <span>&darr;</span>';

            let isExpanded = false;
            toggleBtn.addEventListener('click', () => {
              isExpanded = !isExpanded;
              rows.forEach((row, i) => {
                if (i >= 2) {
                  row.classList.toggle('table-row-hidden', !isExpanded);
                }
              });
              toggleBtn.innerHTML = isExpanded 
                ? '<span>Show Less Rows</span> <span>&uarr;</span>' 
                : '<span>Show More Rows</span> <span>&darr;</span>';
            });

            insertAnchor.insertAdjacentElement('afterend', toggleBtn);
          }
        }
      })();

      // 5. Client-Side Search + Direct $TICKER Navigation
      const filterInput = document.getElementById('filter-input');
      const sidebarSearchInput = document.getElementById('sidebar-search-input');
      const feedFilterEmpty = document.getElementById('feed-filter-empty');
      const feedFilterQueryLabel = document.getElementById('feed-filter-query-label');
      const feedFilterResetBtn = document.getElementById('feed-filter-reset-btn');

      function applyCardFilter(query) {
        const cards = document.querySelectorAll('.dispatch-card');
        let visibleCount = 0;
        cards.forEach((card) => {
          const text = card.innerText.toLowerCase();
          const match = !query || text.includes(query);
          card.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });
        if (feedFilterEmpty) {
          if (query && visibleCount === 0) {
            if (feedFilterQueryLabel) feedFilterQueryLabel.textContent = `"${query}"`;
            feedFilterEmpty.style.display = 'flex';
          } else {
            feedFilterEmpty.style.display = 'none';
          }
        }
        return visibleCount;
      }

      if (feedFilterResetBtn) {
        feedFilterResetBtn.addEventListener('click', () => {
          if (filterInput) filterInput.value = '';
          applyCardFilter('');
        });
      }

      function handleTickerKeydown(e, inputEl) {
        if (e.key === 'Enter') {
          const raw = inputEl.value.trim();
          if (!raw) return;
          const cleanTicker = raw.replace(/^\$/, '').trim();
          if (/^[A-Za-z]{1,5}(\.[A-Za-z]{1,2})?$/.test(cleanTicker)) {
            window.location.href = `/ticker/${cleanTicker.toLowerCase()}/`;
          }
        }
      }

      if (filterInput) {
        filterInput.addEventListener('input', (e) => {
          applyCardFilter(e.target.value.toLowerCase().trim());
        });
        filterInput.addEventListener('keydown', (e) => handleTickerKeydown(e, filterInput));

        const urlParams = new URLSearchParams(window.location.search);
        const searchParam = urlParams.get('search');
        if (searchParam) {
          filterInput.value = searchParam;
          applyCardFilter(searchParam.toLowerCase().trim());
        }
      }

      if (sidebarSearchInput) {
        sidebarSearchInput.addEventListener('keydown', (e) => handleTickerKeydown(e, sidebarSearchInput));
      }

      // 6. Subscription Alerts Handler
      const subscribeForm = document.getElementById('resend-subscribe-form');
      const subscribeBtn = document.getElementById('subscribe-btn');
      if (subscribeForm && subscribeBtn) {
        subscribeForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = document.getElementById('subscriber-email');
          if (!emailInput) return;

          subscribeBtn.disabled = true;
          subscribeBtn.textContent = 'Subscribing...';

          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: emailInput.value })
            });

            if (res.ok) {
              subscribeBtn.textContent = 'Subscribed!';
              emailInput.value = '';
            } else {
              subscribeBtn.textContent = 'Retry';
              subscribeBtn.disabled = false;
            }
          } catch (err) {
            subscribeBtn.textContent = 'Error';
            subscribeBtn.disabled = false;
          }
        });
      }

      // 7. Cookie Banner
      (function initCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('accept-cookies');
        const declineBtn = document.getElementById('decline-cookies');

        if (!localStorage.getItem('cookie_consent')) {
          banner?.classList.remove('hidden');
        }

        acceptBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'accepted');
          banner?.classList.add('hidden');
        });

        declineBtn?.addEventListener('click', () => {
          localStorage.setItem('cookie_consent', 'declined');
          banner?.classList.add('hidden');
        });
      })();

      // 8. Dynamic Scrollspy & Active Section Highlighting
      (function initScrollSpy() {
        const sections = document.querySelectorAll('section[id], div[id="alerts"]');
        const topNavLinks = document.querySelectorAll('.nav-links a[href^="#"]');
        const sideNavLinks = document.querySelectorAll('.sidebar-nav a[href^="#"]');

        if (!sections.length || !('IntersectionObserver' in window)) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const currentId = '#' + entry.target.id;
              
              topNavLinks.forEach((link) => {
                const isMatch = link.getAttribute('href') === currentId;
                link.classList.toggle('active', isMatch);
              });

              sideNavLinks.forEach((link) => {
                const isMatch = link.getAttribute('href') === currentId;
                link.classList.toggle('active', isMatch);
              });
            }
          });
        }, {
          rootMargin: '-20% 0px -65% 0px',
          threshold: 0
        });

        sections.forEach((sec) => observer.observe(sec));
      })();

      // 9. Floating Back-to-Top Button
      (function initBackToTop() {
        const bttBtn = document.getElementById('back-to-top-btn');
        if (!bttBtn) return;

        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              if (window.scrollY > 350) {
                bttBtn.classList.add('visible');
              } else {
                bttBtn.classList.remove('visible');
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        bttBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <script is:inline>
      (function initHeroPersonaSwitcher() {
        const personaHeadlines = {
          momentum: {
            headline: 'Find unusual momentum before it becomes obvious.',
            subheadline: 'Real-time algorithmic volume scanning catches surges (RVOL ≥ 3x), catalyst breakouts, and consolidation breaks across 10,000+ US stocks — with instant "Why Is It Moving?" context and defined invalidation levels.'
          },
          swing: {
            headline: 'Identify Multi-Day Stage-2 Breakouts Backed by Verified Catalysts.',
            subheadline: 'Filter out dead-cat bounces and toxic dilution traps. Isolate multi-week consolidation breaches backed by clean earnings surprises, heavy volume accumulation, and zero shelf-offering risk.'
          },
          quant: {
            headline: 'Systematic Momentum Discovery Powered by Volume Profiling & Attribution Layers.',
            subheadline: 'Replace raw percentage noise with multi-variable market telemetry: float turnover distributions, relative volume standard deviations, order flow tilt, and structured narrative classification.'
          }
        };

        const btns = document.querySelectorAll('.persona-pill-btn');
        const hEl = document.getElementById('hero-headline');
        const sEl = document.getElementById('hero-subheadline');

        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            btns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            const p = btn.getAttribute('data-persona');
            if (p && personaHeadlines[p] && hEl && sEl) {
              hEl.textContent = personaHeadlines[p].headline;
              sEl.textContent = personaHeadlines[p].subheadline;
            }
          });
        });

        const chipBtns = document.querySelectorAll('.hero-chip-btn');
        chipBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const ticker = btn.getAttribute('data-ticker');
            if (!ticker) return;
            try {
              const raw = localStorage.getItem('to_watchlist_v1');
              let list = raw ? JSON.parse(raw) : [];
              if (!list.some((item) => (typeof item === 'string' ? item : item.ticker) === ticker)) {
                list.unshift({
                  ticker: ticker,
                  triggers: { pctMove: true, rvol: true, breakout: true, catalyst: true }
                });
                localStorage.setItem('to_watchlist_v1', JSON.stringify(list));
              }
            } catch(e) {}
            window.location.href = '/screener/#watchlist-matrix';
          });
        });
      })();
    </script>

    <button id="back-to-top-btn" class="back-to-top-btn" aria-label="Back to top" title="Back to top">&uarr;</button>
    <DiagnosticDrawer />
  </body>
</html>
