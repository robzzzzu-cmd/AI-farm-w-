---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // Helper to extract all categories assigned to a post across legacy and new schemas
  const getPostCategories = (post: (typeof allPosts)[number]): string[] => {
    if (Array.isArray(post.data.categories) && post.data.categories.length > 0) {
      return post.data.categories;
    }
    if (typeof post.data.category === 'string' && post.data.category.trim() !== '') {
      return [post.data.category.trim()];
    }
    return ['Equities'];
  };

  const categoryMap = new Map<string, { name: string; posts: typeof allPosts }>();

  for (const post of allPosts) {
    const cats = getPostCategories(post);
    for (const cat of cats) {
      const slug = cat.toLowerCase().replace(/\s+/g, '-');
      if (!categoryMap.has(slug)) {
        categoryMap.set(slug, { name: cat, posts: [] });
      }
      categoryMap.get(slug)!.posts.push(post);
    }
  }

  // Ensure standard asset hubs exist even if no posts are tagged yet
  const defaultHubs = ['equities', 'forex', 'crypto', 'commodities'];
  for (const slug of defaultHubs) {
    if (!categoryMap.has(slug)) {
      const name = slug.charAt(0).toUpperCase() + slug.slice(1);
      categoryMap.set(slug, { name, posts: [] });
    }
  }

  return Array.from(categoryMap.entries()).map(([slug, data]) => ({
    params: { category: slug },
    props: {
      categoryName: data.name,
      posts: data.posts.sort((a, b) => {
        const dateA = new Date(a.data.pubDate || a.data.date || 0).getTime();
        const dateB = new Date(b.data.pubDate || b.data.date || 0).getTime();
        return dateB - dateA;
      })
    }
  }));
}

const { categoryName, posts } = Astro.props;
---

<Layout title={`${categoryName} Market Intelligence Hub`}>
  <main class="max-w-4xl mx-auto px-4 py-10">
    <header class="border-b border-gray-200 dark:border-gray-800 pb-6 mb-8">
      <span class="px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 rounded">
        Topic Hub
      </span>
      <h1 class="text-3xl font-extrabold tracking-tight mt-2">{categoryName} Intelligence</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">
        Archived quantitative scans, volume distributions, and momentum updates.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-gray-500 py-8">No updates currently cataloged under {categoryName}.</p>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <article class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm hover:shadow-md transition">
            <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
              <span>
                {post.data.displayDate ||
                  (post.data.pubDate || post.data.date
                    ? new Date(post.data.pubDate || post.data.date!).toISOString().split('T')[0]
                    : 'Recent')}
              </span>
              {post.data.leadTicker && (
                <>
                  <span>•</span>
                  <span class="font-semibold text-emerald-600 dark:text-emerald-400">
                    Lead: ${post.data.leadTicker} {post.data.leadGain ? `(${post.data.leadGain})` : ''}
                  </span>
                </>
              )}
            </div>
            <h2 class="text-xl font-bold">
              <a href={`/blog/${post.id}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm leading-relaxed">
                {post.data.description}
              </p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {post.data.tags.map((tag) => (
                  <span class="text-xs px-2.5 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>
