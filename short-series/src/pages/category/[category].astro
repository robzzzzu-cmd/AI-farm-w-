---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const categoryMap = new Map<string, typeof allPosts>();

  allPosts.forEach((post) => {
    const cats = post.data.categories || (post.data.category ? [post.data.category] : ['Equities']);
    cats.forEach((cat) => {
      const normalized = cat.toLowerCase();
      if (!categoryMap.has(normalized)) {
        categoryMap.set(normalized, []);
      }
      categoryMap.get(normalized)!.push(post);
    });
  });

  return Array.from(categoryMap.entries()).map(([slug, posts]) => {
    const formattedTitle = posts[0]?.data?.categories?.find((c) => c.toLowerCase() === slug) ||
                           posts[0]?.data?.category ||
                           slug.toUpperCase();

    return {
      params: { category: slug },
      props: {
        categoryName: formattedTitle,
        posts: posts.sort((a, b) => {
          const dateA = a.data.pubDate?.valueOf() || a.data.date?.valueOf() || 0;
          const dateB = b.data.pubDate?.valueOf() || b.data.date?.valueOf() || 0;
          return dateB - dateA;
        })
      }
    };
  });
}

const { categoryName, posts } = Astro.props;
---

<Layout title={`${categoryName} Market Intelligence Hub`}>
  <main class="max-w-4xl mx-auto px-4 py-10">
    <header class="border-b border-gray-200 dark:border-gray-800 pb-6 mb-8">
      <span class="px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 rounded">
        Topic Hub
      </span>
      <h1 class="text-3xl font-extrabold tracking-tight mt-2">{categoryName} Intelligence</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">
        Archived quantitative scans, volume distributions, and momentum updates.
      </p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm hover:shadow-md transition">
          <div class="flex items-center gap-2 text-xs text-gray-500 mb-2">
            <span>{post.data.displayDate || post.data.pubDate?.toISOString().split('T')[0]}</span>
            {post.data.leadTicker && (
              <>
                <span>•</span>
                <span class="font-semibold text-emerald-600 dark:text-emerald-400">
                  Lead: ${post.data.leadTicker} ({post.data.leadGain})
                </span>
              </>
            )}
          </div>
          <h2 class="text-xl font-bold">
            <a href={`/blog/${post.id}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition">
              {post.data.title}
            </a>
          </h2>
          {post.data.description && (
            <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm leading-relaxed">
              {post.data.description}
            </p>
          )}
          <div class="flex flex-wrap gap-2 mt-4">
            {post.data.tags?.map((tag) => (
              <span class="text-xs px-2.5 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
